{
  "name": "@ai-ecoverse/wasix-sysroot",
  "version": "2025.9.30-19",
  "description": "WASIX sysroots: st_uid/st_gid = getuid()/getgid(), file modes via slicc_fs, F_SETFD CLOEXEC fix, select exceptfds, physical chdir, POSIX TZ, socketpair flags, sigaction_set, alarm/setitimer/getitimer, EINTR sleeps, raise/pthread_kill, process credentials from slicc-kernel (no fixed uid 1000), wasip1, clang24 exnref",
  "version": "2025.9.30-20",
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasix-sysroot/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasix-sysroot",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "sysroot",
    "slicc",
    "homescoop"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "sysroot",
    "sysroot-eh",
    "sysroot-ehpic",
    "sysroot-exnref-eh",
    "sysroot-exnref-ehpic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasix-sysroot",
    "upstream": "2025.9.30"
  },
  "slicc": {
    "abi": "emscripten",
    "env": {
      "WASIXCC_SYSROOT_PREFIX": "${package}"
    }
  }
}
