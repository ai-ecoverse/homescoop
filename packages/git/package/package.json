{
  "name": "@ai-ecoverse/wasm-git",
  "version": "2.55.0-18",
  "description": "Git version control: clone, commit, branch, merge, push and pull.",
  "engines": {
    "slicc-kernel": ">=1.130.2"
  },
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/git/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/git",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "git"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "libexec",
    "share"
  ],
  "dependencies": {
    "@ai-ecoverse/wasm-bash": "5.3.0-22",
    "@ai-ecoverse/wasm-sed": "4.10.0-5"
  },
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "git",
    "upstream": "2.55.0"
  },
  "slicc": {
    "abi": "emscripten",
    "env": {
      "GIT_EXEC_PATH": "libexec/git-core",
      "GIT_TEMPLATE_DIR": "share/git-core/templates"
    },
    "commands": {
      "git": {
        "glue": "bin/git",
        "wasm": "bin/git.wasm",
        "env": {
          "GIT_EXEC_PATH": "libexec/git-core",
          "GIT_TEMPLATE_DIR": "share/git-core/templates"
        }
      },
      "git-remote-http": {
        "glue": "bin/git-remote-http",
        "wasm": "bin/git-remote-http.wasm",
        "helper": true
      },
      "git-remote-https": {
        "glue": "bin/git-remote-https",
        "wasm": "bin/git-remote-https.wasm",
        "helper": true
      },
      "git-shell": {
        "glue": "bin/git-shell",
        "wasm": "bin/git-shell.wasm",
        "helper": true
      },
      "scalar": {
        "glue": "bin/scalar",
        "wasm": "bin/scalar.wasm"
      },
      "git-upload-pack": {
        "glue": "bin/git-upload-pack",
        "wasm": "bin/git-upload-pack.wasm",
        "argv0": "git-upload-pack",
        "env": {
          "GIT_EXEC_PATH": "libexec/git-core",
          "GIT_TEMPLATE_DIR": "share/git-core/templates"
        },
        "helper": true
      },
      "git-receive-pack": {
        "glue": "bin/git-receive-pack",
        "wasm": "bin/git-receive-pack.wasm",
        "argv0": "git-receive-pack",
        "env": {
          "GIT_EXEC_PATH": "libexec/git-core",
          "GIT_TEMPLATE_DIR": "share/git-core/templates"
        },
        "helper": true
      }
    }
  }
}
