unzip -U: bound every escape in wide_to_local_string() (homescoop#579, Codex P1).
Debian's CVE-2022-0529 fix bounded only the no-multibyte arm; the -U
(escape_all) arm kept strcat(), and MAX_ESCAPE_BYTES 8 is two short of the
10-byte "#Lxxxxxxxx" a 5- or 6-byte UTF-8 sequence decodes to.

--- a/process.c
+++ b/process.c
@@ -2341,7 +2341,10 @@
   */
 
  /* set this to the max bytes an escape can be */
-#define MAX_ESCAPE_BYTES 8
+/* "#L" and 8 hex digits: utf8_char_bytes() takes 5- and 6-byte sequences,
+   so a character can be 31 bits (homescoop#579; Debian's CVE-2022-0529 fix
+   kept 8, which fits only "#L" and 6 digits). */
+#define MAX_ESCAPE_BYTES 10
 
 char *wide_to_escape_string(wide_char)
   zwchar wide_char;
@@ -2480,8 +2483,20 @@
         strncat(buffer, buf, b);
       } else {
         /* use escape for wide character */
+        /* homescoop#579: bounded like the CVE-2022-0529 arm below; this
+           (unzip -U) arm had kept the unbounded strcat(). */
         char *escape_string = wide_to_escape_string(wide_string[i]);
-        strcat(buffer, escape_string);
+        size_t buffer_len = strlen(buffer);
+        size_t escape_string_len;
+
+        if (escape_string == NULL) {
+          free(buffer);
+          return NULL;
+        }
+        escape_string_len = strlen(escape_string);
+        if (escape_string_len > buffer_size - buffer_len - 1)
+          escape_string_len = buffer_size - buffer_len - 1;
+        strncat(buffer, escape_string, escape_string_len);
         free(escape_string);
       }
     } else if (b > 0) {
@@ -2496,6 +2511,10 @@
         int err_msg = 0;
 
         escape_string = wide_to_escape_string(wide_string[i]);
+        if (escape_string == NULL) {
+          free(buffer);
+          return NULL;
+        }
         buffer_len = strlen( buffer);
         escape_string_len = strlen( escape_string);
 
