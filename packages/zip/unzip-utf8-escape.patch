--- base/extract.c	2026-10-22 00:51:51.343770181 +0200
+++ unzip60/extract.c	2026-10-22 00:54:00.703608407 +0200
@@ -113,6 +113,98 @@
 #ifdef SET_DIR_ATTRIB
    static int Cdecl dircomp OF((ZCONST zvoid *a, ZCONST zvoid *b));
 #endif
+#ifdef UNIX
+static char **pct_names = (char **)NULL;
+static unsigned pct_count = 0;
+static unsigned pct_room = 0;
+
+static unsigned pct_utf8_seq(ZCONST uch *p)
+{
+    uch c = p[0], lo, hi;
+
+    if (c < 0x80)
+        return 1;
+    if (c >= 0xc2 && c <= 0xdf)
+        return (p[1] >= 0x80 && p[1] <= 0xbf) ? 2 : 0;
+    if (c >= 0xe0 && c <= 0xef) {
+        lo = (c == 0xe0) ? 0xa0 : 0x80;
+        hi = (c == 0xed) ? 0x9f : 0xbf;
+        return (p[1] >= lo && p[1] <= hi &&
+                p[2] >= 0x80 && p[2] <= 0xbf) ? 3 : 0;
+    }
+    if (c >= 0xf0 && c <= 0xf4) {
+        lo = (c == 0xf0) ? 0x90 : 0x80;
+        hi = (c == 0xf4) ? 0x8f : 0xbf;
+        return (p[1] >= lo && p[1] <= hi &&
+                p[2] >= 0x80 && p[2] <= 0xbf &&
+                p[3] >= 0x80 && p[3] <= 0xbf) ? 4 : 0;
+    }
+    return 0;
+}
+
+static int pct_escape(char *name)
+{
+    ZCONST uch *p = (ZCONST uch *)name;
+    char buf[FILNAMSIZ];
+    extent n = 0;
+    unsigned k;
+
+    while (*p && (k = pct_utf8_seq(p)) != 0)
+        p += k;
+    if (!*p)
+        return 0;
+    p = (ZCONST uch *)name;
+    while (*p) {
+        k = pct_utf8_seq(p);
+        if (k && *p != '%') {
+            if (n + k >= FILNAMSIZ)
+                return -1;
+            memcpy(buf + n, p, k);
+            n += k;
+            p += k;
+        } else {
+            if (n + 3 >= FILNAMSIZ)
+                return -1;
+            sprintf(buf + n, "%%%02X", (unsigned)*p);
+            n += 3;
+            ++p;
+        }
+    }
+    buf[n] = '\0';
+    strcpy(name, buf);
+    return 1;
+}
+
+static int pct_known(ZCONST char *name)
+{
+    unsigned i;
+
+    for (i = 0; i < pct_count; i++)
+        if (strcmp(pct_names[i], name) == 0)
+            return TRUE;
+    return FALSE;
+}
+
+static int pct_remember(ZCONST char *name)
+{
+    char *copy;
+
+    if (pct_count == pct_room) {
+        unsigned room = pct_room ? 2 * pct_room : 64;
+        char **grown = (char **)realloc(pct_names, room * sizeof(char *));
+
+        if (grown == (char **)NULL)
+            return -1;
+        pct_names = grown;
+        pct_room = room;
+    }
+    if ((copy = (char *)malloc(strlen(name) + 1)) == (char *)NULL)
+        return -1;
+    strcpy(copy, name);
+    pct_names[pct_count++] = copy;
+    return 0;
+}
+#endif /* UNIX */
 
 
 
