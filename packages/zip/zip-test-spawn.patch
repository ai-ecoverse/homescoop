+#ifdef __EMSCRIPTEN__
+/* slicc (homescoop#432): zip -T ran "unzip -v" through popen() and
+   "unzip -t -qq 'name'" through system(), that is through /bin/sh, which
+   seven has only when a shell is installed, and so failed with "could not
+   spawn unzip" without one.  Run unzip itself, found on PATH, with an argv
+   and no shell; an archive name needs no quoting.  A command given with -TT
+   is still a shell command and still runs through system(). */
+#include <spawn.h>
+#include <sys/wait.h>
+extern char **environ;
+
+/* Reap pid: its wait status, as system() and pclose() return, or -1. */
+local int unzip_wait(pid_t pid)
+{
+  int status;
+
+  while (waitpid(pid, &status, 0) < 0) {
+    if (errno != EINTR)
+      return -1;
+  }
+  return status;
+}
+
+/* Start argv; when out is not NULL, *out reads its stdout.  The pid, or -1. */
+local pid_t unzip_spawn(char **argv, FILE **out)
+{
+  posix_spawn_file_actions_t fa;
+  int p[2] = {-1, -1};
+  pid_t pid;
+  int r;
+
+  if (out != NULL && pipe(p) != 0)
+    return -1;
+  if (posix_spawn_file_actions_init(&fa) != 0) {
+    if (out != NULL) { close(p[0]); close(p[1]); }
+    return -1;
+  }
+  if (out != NULL &&
+      (posix_spawn_file_actions_adddup2(&fa, p[1], 1) != 0 ||
+       posix_spawn_file_actions_addclose(&fa, p[0]) != 0 ||
+       posix_spawn_file_actions_addclose(&fa, p[1]) != 0)) {
+    posix_spawn_file_actions_destroy(&fa);
+    close(p[0]); close(p[1]);
+    return -1;
+  }
+  r = posix_spawnp(&pid, argv[0], &fa, NULL, argv, environ);
+  posix_spawn_file_actions_destroy(&fa);
+  if (out != NULL)
+    close(p[1]);
+  if (r != 0) {
+    if (out != NULL)
+      close(p[0]);
+    errno = r;
+    return -1;
+  }
+  if (out != NULL && (*out = fdopen(p[0], "r")) == NULL) {
+    close(p[0]);
+    unzip_wait(pid);
+    return -1;
+  }
+  return pid;
+}
+#endif /* __EMSCRIPTEN__ */
