{
  "name": "@ai-ecoverse/wasm-pkgconf",
  "version": "3.0.10-1",
  "description": "pkgconf and pkg-config, which give the compiler and linker flags of installed libraries.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/pkgconf/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/pkgconf",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "pkgconf"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "pkgconf",
    "upstream": "3.0.10"
  },
  "slicc": {
    "abi": "emscripten",
    "commands": {
      "pkgconf": {
        "glue": "bin/pkgconf",
        "wasm": "bin/pkgconf.wasm"
      },
      "pkg-config": {
        "glue": "bin/pkgconf",
        "wasm": "bin/pkgconf.wasm"
      }
    }
  }
}
