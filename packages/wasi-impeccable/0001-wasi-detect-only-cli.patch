+//! WASI stub: remote bundle signing needs `ring`, which does not link for
+//! wasm32-wasip1. Callers hit download stubs first; these APIs refuse cleanly.
+use std::collections::BTreeMap;
+use std::io::Read;
+
+pub(crate) const MAX_SIGNATURE_BYTES: u64 = 16 * 1024;
+pub(crate) const ERROR_PREFIX: &str = "Could not verify skill bundle: ";
+pub(crate) type TrustedKeys = BTreeMap<String, String>;
+
+pub(crate) fn trusted_keys() -> Result<TrustedKeys, String> {
+    Err("needs network; not available in this build yet".into())
+}
+
+pub(crate) fn release_version(_location: &str) -> Result<String, String> {
+    Err("needs network; not available in this build yet".into())
+}
+
+pub(crate) fn verify_reader(
+    _reader: &mut dyn Read,
+    _signature: &[u8],
+    _version: &str,
+    _keys: &TrustedKeys,
+) -> Result<(), String> {
+    Err("needs network; not available in this build yet".into())
+}
