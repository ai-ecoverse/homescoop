+fn verify_ed25519(public_key: &[u8], message: &[u8], signature: &[u8]) -> Result<(), ()> {
+    use ring::signature::{UnparsedPublicKey, ED25519};
+    UnparsedPublicKey::new(&ED25519, public_key).verify(message, signature).map_err(|_| ())
