+/// The working directory. On WASI `current_dir()` is wasi-libc's, which
+/// stays `/` wherever the host started the program, while relative paths
+/// opened through std already resolve against the real one: take that
+/// ([`wasi_working_directory`]), not a `PWD` that may be stale.
+fn process_cwd() -> PathBuf {
+    #[cfg(target_os = "wasi")]
+    if let Some(dir) = wasi_working_directory() {
+        return dir;
+    }
+    std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."))
