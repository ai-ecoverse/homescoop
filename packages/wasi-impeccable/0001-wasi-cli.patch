+/// The working directory. On wasm32-wasip1 `current_dir()` is wasi-libc's,
+/// which stays `/` wherever the host started the program; the host (slicc's
+/// kernel) puts the real one in `PWD`, and relative paths opened through
+/// std already resolve against it.
+fn process_cwd() -> PathBuf {
+    #[cfg(target_family = "wasm")]
+    if let Some(pwd) = std::env::var_os("PWD").map(PathBuf::from).filter(|p| p.is_absolute()) {
+        return pwd;
+    }
+    std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."))
+}
+
+/// `std::process::id()` panics on wasm32-wasip1 ("no pids"). Use this for
+/// temp-name entropy instead.
+pub fn process_id() -> u32 {
+    #[cfg(target_family = "wasm")]
+    {
+        1
+    }
+    #[cfg(not(target_family = "wasm"))]
+    {
+        std::process::id()
+    }
+}
