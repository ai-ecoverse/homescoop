+
+/// homescoop WASI: ring does not build for wasm32-wasip1. Strict verification
+/// rejects what ring rejects (non-canonical S and small-order keys).
+#[cfg(target_family = "wasm")]
+fn verify_ed25519(public_key: &[u8], message: &[u8], signature: &[u8]) -> Result<(), ()> {
+    use ed25519_dalek::{Signature, VerifyingKey};
+    let key: [u8; 32] = public_key.try_into().map_err(|_| ())?;
+    let signature: [u8; 64] = signature.try_into().map_err(|_| ())?;
+    let key = VerifyingKey::from_bytes(&key).map_err(|_| ())?;
+    key.verify_strict(message, &Signature::from_bytes(&signature)).map_err(|_| ())
+}
