{
  "name": "@ai-ecoverse/wasm-xz",
  "version": "5.8.4-5",
  "description": "XZ Utils: xz, unxz, xzcat and the lzma tools, with xzgrep and xzdiff.",
  "license": "0BSD AND GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/xz/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/xz",
  "keywords": ["wasm", "emscripten", "slicc", "homescoop", "xz", "lzma"],
  "files": ["README.md", "LICENSE", "THIRD-PARTY-NOTICES.md", "bin", "lib", "include"],
  "publishConfig": { "access": "public" },
  "homescoop": { "recipe": "xz", "upstream": "5.8.4" },
  "slicc": {
    "abi": "emscripten",
    "commands": {
      "xz": { "glue": "bin/xz", "wasm": "bin/xz.wasm" },
      "unxz": { "glue": "bin/xz", "wasm": "bin/xz.wasm", "argv0": "unxz" },
      "xzcat": { "glue": "bin/xz", "wasm": "bin/xz.wasm", "argv0": "xzcat" },
      "lzma": { "glue": "bin/xz", "wasm": "bin/xz.wasm", "argv0": "lzma" },
      "unlzma": { "glue": "bin/xz", "wasm": "bin/xz.wasm", "argv0": "unlzma" },
      "lzcat": { "glue": "bin/xz", "wasm": "bin/xz.wasm", "argv0": "lzcat" },
      "xzgrep": { "script": "bin/xzgrep" },
      "xzdiff": { "script": "bin/xzdiff" }
    }
  }
}
