{
  "name": "@ai-ecoverse/py-scipy",
  "version": "1.18.1-3",
  "description": "SciPy 1.18.1 for slicc WASIX CPython 3.15 (cp315-wasix_wasm32 side modules, static OpenBLAS)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-scipy/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/py-scipy",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "slicc",
    "homescoop",
    "python",
    "scipy"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-ecoverse/wasix-python": "3.15.0-6",
    "@ai-ecoverse/py-numpy": "2.5.4-4"
  },
  "homescoop": {
    "recipe": "py-scipy",
    "upstream": "1.18.1",
