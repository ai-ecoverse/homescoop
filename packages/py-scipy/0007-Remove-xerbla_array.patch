Remove xerbla_array from scipy.linalg.cython_lapack.

wasix-openblas' C LAPACK (f2c output) defines xerbla_array_ with f2c's hidden
string length: (char *, int *, int *, ftnlen). The cython_lapack wrapper
declares the three Fortran arguments only, and wasm calls are type-checked
(wasm-ld: function signature mismatch). LAPACK calls it only from LAPACKE and
the XBLAS-style C wrappers, none of which scipy uses; as 0004 does for
chla_transtype, the wrapper goes.

--- a/scipy/linalg/cython_lapack_signatures.txt
+++ b/scipy/linalg/cython_lapack_signatures.txt
@@ -1140,7 +1140,6 @@
 void strttf(char *transr, char *uplo, int *n, s *a, int *lda, s *arf, int *info)
 void strttp(char *uplo, int *n, s *a, int *lda, s *ap, int *info)
 void stzrzf(int *m, int *n, s *a, int *lda, s *tau, s *work, int *lwork, int *info)
-void xerbla_array(char *srname_array, int *srname_len, int *info)
 void zbbcsd(char *jobu1, char *jobu2, char *jobv1t, char *jobv2t, char *trans, int *m, int *p, int *q, d *theta, d *phi, z *u1, int *ldu1, z *u2, int *ldu2, z *v1t, int *ldv1t, z *v2t, int *ldv2t, d *b11d, d *b11e, d *b12d, d *b12e, d *b21d, d *b21e, d *b22d, d *b22e, d *rwork, int *lrwork, int *info)
