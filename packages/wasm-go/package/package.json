{
  "name": "@ai-ecoverse/wasm-go",
  "version": "1.27.4-2",
  "description": "The Go 1.27 compiler, linker and assembler, with a go command (build, run, mod download) that drives them in slicc-kernel.",
  "license": "BSD-3-Clause",
  "engines": {
    "slicc-kernel": ">=1.88.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasm-go/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasm-go",
  "keywords": [
    "wasm",
    "wasi",
    "wasip1",
    "slicc",
    "homescoop",
    "go",
    "golang"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "PATENTS",
    "bin",
    "goroot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasm-go",
    "upstream": "1.27.4"
  },
  "slicc": {
    "abi": "wasi",
    "go": {
      "version": "go1.27.4",
      "goroot": "goroot"
    },
    "commands": {
      "go": {
        "abi": "js",
        "module": "bin/go.mjs",
        "env": {
          "SLICC_GO_PACKAGE": "${package}"
        }
      }
    }
  }
}
