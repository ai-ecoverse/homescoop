{
  "name": "@ai-ecoverse/wasm-graphviz",
  "version": "16.1.1-1",
  "description": "Graphviz's dot, the graph layout program, with its layouts and core renderers (svg, json, xdot, dot).",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/graphviz/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/graphviz",
  "keywords": ["wasm", "emscripten", "slicc", "homescoop", "graphviz", "dot"],
  "files": ["README.md", "LICENSE", "THIRD-PARTY-NOTICES.md", "bin"],
  "publishConfig": { "access": "public" },
  "homescoop": {
    "recipe": "graphviz",
    "upstream": "16.1.1"
  },
  "slicc": {
    "abi": "emscripten",
    "commands": {
      "dot": { "glue": "bin/dot", "wasm": "bin/dot.wasm" }
