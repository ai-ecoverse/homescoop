{
  "name": "@ai-ecoverse/wasm-imagemagick-heif",
  "version": "7.1.2-34-9.6",
  "description": "ImageMagick with HEIC, HEIF and AVIF support, a drop-in for wasm-imagemagick that includes a patent-encumbered HEVC decoder.",
  "license": "ImageMagick AND LGPL-3.0-or-later AND BSD-2-Clause AND GPL-2.0-only WITH Font-exception-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/imagemagick-heif/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/imagemagick-heif",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "imagemagick",
    "magick",
    "convert",
    "heic",
    "heif",
    "avif",
    "libheif"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "etc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "slicc-kernel": ">=1.78.0"
  },
  "homescoop": {
    "recipe": "imagemagick-heif",
    "upstream": "7.1.2-34",
    "relink": "@ai-ecoverse/wasm-imagemagick-relink"
  },
  "slicc": {
    "replaces": [
      "@ai-ecoverse/wasm-imagemagick"
    ],
    "abi": "emscripten",
    "env": {
      "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
    },
    "commands": {
      "magick": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "convert": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "convert",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "identify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "identify",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "mogrify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "mogrify",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "magick-open": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "magick",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7-open"
        }
      }
    }
  }
}
