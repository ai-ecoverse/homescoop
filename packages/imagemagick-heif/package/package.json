{
  "name": "@ai-ecoverse/wasm-imagemagick-heif",
  "version": "7.1.2-34-5",
  "description": "ImageMagick 7.1.2-34 magick CLI for wasm / slicc (emscripten) with HEIC/HEIF/AVIF through libheif. Optional: contains an HEVC decoder (libde265), and HEVC is patent-encumbered. Use instead of @ai-ecoverse/wasm-imagemagick, same commands.",
  "license": "ImageMagick AND LGPL-3.0-or-later AND BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/imagemagick-heif/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/imagemagick-heif",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "imagemagick",
    "magick",
    "convert",
    "heic",
    "heif",
    "avif",
    "libheif"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "etc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "slicc-kernel": ">=1.78.0"
  },
  "homescoop": {
    "recipe": "imagemagick-heif",
    "upstream": "7.1.2-34"
  },
  "slicc": {
    "replaces": [
      "@ai-ecoverse/wasm-imagemagick"
    ],
    "abi": "emscripten",
    "env": {
      "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
    },
    "commands": {
      "magick": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "convert": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "convert",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "identify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "identify",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "mogrify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "mogrify",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "magick-open": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "magick",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7-open"
        }
      }
    }
  }
}
