# --- wasix-libc: MUST be define (misdetect = undef is silent + harmful) ---
# CRITICAL: d_rename undef → Perl link()+unlink() emulation; path_link ENOTSUP
# in SLICC deletes the target before link fails → perl -i DATA LOSS.
