+            log::debug!("on WASI, fd_fdstat_get(0) failed: {errno}");
+            return false;
+        }
+        let filetype = buf[0] as u8;
+        // 2 = CHARACTER_DEVICE, 3 = DIRECTORY.
+        let is_readable = filetype != 2 && filetype != 3;
+        log::debug!(
+            "on WASI, stdin filetype={filetype}, \
+             thus is_stdin_readable={is_readable}",
+        );
+        is_readable
+    }
