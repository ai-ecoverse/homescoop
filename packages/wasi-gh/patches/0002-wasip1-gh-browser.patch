+// credentialEnv drops tokens before a child starts. git, a browser command,
+// and a pager do not need GH_TOKEN; seven supplies it to gh itself.
+func credentialEnv(env []string) []string {
+	if env == nil {
+		return nil
+	}
+	kept := make([]string, 0, len(env))
+	for _, entry := range env {
+		name, _, _ := strings.Cut(entry, "=")
+		switch name {
+		case "GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN":
+			continue
+		}
+		kept = append(kept, entry)
+	}
+	return kept
+}
+
+// Chmod asks the host to set mode on path. wasip1 chmod is a no-op.
+func Chmod(path string, mode uint32) error {
+	return call(map[string]any{"op": "chmod", "path": path, "mode": mode}, nil)
+}
+
 // Transport sends HTTP requests through the host.
 type Transport struct{}
 
