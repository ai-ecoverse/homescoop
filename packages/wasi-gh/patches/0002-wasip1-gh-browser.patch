diff --git a/internal/browser/browser_wasip1.go b/internal/browser/browser_wasip1.go
--- /dev/null
+++ b/internal/browser/browser_wasip1.go
@@ -0,0 +1,54 @@
+//go:build wasip1
+
+package browser
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+
+	"github.com/cli/cli/v2/internal/slicchost"
+	"github.com/google/shlex"
+)
+
+type wasiBrowser struct {
+	launcher string
+	stdout   io.Writer
+	stderr   io.Writer
+}
+
+func browseOnWasip1(launcher string, stdout, stderr io.Writer) (Browser, bool) {
+	if launcher == "" {
+		launcher = os.Getenv("GH_BROWSER")
+	}
+	if launcher == "" {
+		launcher = os.Getenv("BROWSER")
+	}
+	return &wasiBrowser{launcher: launcher, stdout: stdout, stderr: stderr}, true
+}
+
+func (b *wasiBrowser) Browse(raw string) error {
+	parsed, err := url.Parse(raw)
+	if err != nil || (parsed.Scheme != "http" && parsed.Scheme != "https") {
+		return fmt.Errorf("refusing to open %s", raw)
+	}
+	if b.launcher == "" {
+		return fmt.Errorf("GH_BROWSER is not set")
+	}
+	parts, err := shlex.Split(b.launcher)
+	if err != nil {
+		return err
+	}
+	if len(parts) == 0 {
+		return fmt.Errorf("GH_BROWSER is empty")
+	}
+	// Do not pass the process stdin through. A "yes |" pipe would otherwise
+	// be inherited by the browser command.
+	err = slicchost.Run(context.Background(), parts[0], append(parts[1:], parsed.String()), os.Environ(), "", nil, b.stdout, b.stderr)
+	if err != nil {
+		return fmt.Errorf("%s: %w", b.launcher, err)
+	}
+	return nil
+}

