+//go:build wasip1
+
+package in_toto
+
+import (
+	"errors"
+	"os"
+)
+
+func isWritable(path string) error {
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() {
+		return errors.New("not a directory")
+	}
+	if info.Mode().Perm()&0o200 == 0 {
+		return errors.New("not writable")
+	}
+	return nil
+}
