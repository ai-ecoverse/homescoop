+//go:build !wasip1
+
+package slicchost
+
+import (
+	"context"
+	"io"
+	"net/http"
+)
+
+// LookPath returns ErrUnsupported outside wasip1.
+func LookPath(string) (string, error) {
+	return "", ErrUnsupported
+}
+
+// Run returns ErrUnsupported outside wasip1.
+func Run(context.Context, string, []string, []string, string, io.Reader, io.Writer, io.Writer) error {
+	return ErrUnsupported
+}
+
+// Transport returns ErrUnsupported outside wasip1.
+type Transport struct{}
+
+// RoundTrip implements http.RoundTripper.
+func (Transport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, ErrUnsupported
+}
diff --git a/internal/slicchost/slicchost_wasip1.go b/internal/slicchost/slicchost_wasip1.go
--- /dev/null
+++ b/internal/slicchost/slicchost_wasip1.go
@@ -0,0 +1,217 @@
+//go:build wasip1
+
+package slicchost
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"sync"
+	"unsafe"
+)
+
+// probeMagic is the value host/gh-host.mjs returns from probe.
+const probeMagic = 0x67683131
+
+//go:wasmimport gh_host probe
+func hostProbe() uint32
+
+//go:wasmimport gh_host call
+func hostCall(request unsafe.Pointer, size uint32) uint32
+
+//go:wasmimport gh_host take
+func hostTake(response unsafe.Pointer)
+
+var available = sync.OnceValue(func() bool { return hostProbe() == probeMagic })
+
+func init() {
+	// go-gh builds its client from http.DefaultTransport. wasip1 cannot dial;
+	// the host module sends the request.
+	http.DefaultTransport = Transport{}
+}
+
+// ErrNotFound is exec.ErrNotFound.
+var ErrNotFound = exec.ErrNotFound
+
+type envelope struct {
+	OK    bool            `json:"ok"`
+	Error string          `json:"error"`
+	Value json.RawMessage `json:"value"`
+}
+
+func call(request any, value any) error {
+	if !available() {
+		return ErrUnsupported
+	}
+	data, err := json.Marshal(request)
+	if err != nil {
+		return err
+	}
+	size := hostCall(unsafe.Pointer(unsafe.SliceData(data)), uint32(len(data)))
+	response := make([]byte, size)
+	if size > 0 {
+		hostTake(unsafe.Pointer(unsafe.SliceData(response)))
+	}
+	var result envelope
+	if err := json.Unmarshal(response, &result); err != nil {
+		return err
+	}
+	if !result.OK {
+		return errors.New(result.Error)
+	}
+	if value == nil || len(result.Value) == 0 || string(result.Value) == "null" {
+		return nil
+	}
+	return json.Unmarshal(result.Value, value)
+}
+
+// LookPath reports name as runnable when the host can start a command by that name.
+func LookPath(name string) (string, error) {
+	var found string
+	if err := call(map[string]any{"op": "which", "name": name}, &found); err != nil {
+		return "", err
+	}
+	if found == "" {
+		return "", ErrNotFound
+	}
+	return name, nil
+}
+
+// Run starts name with args and waits for it, like exec.Cmd.Run.
+func Run(ctx context.Context, name string, args []string, env []string, dir string, stdin io.Reader, stdout io.Writer, stderr io.Writer) error {
+	// gh's git client leaves Cmd.Stdin as the process stdin. Reading it to
+	// EOF waits forever on a terminal, and it also consumes input gh itself
+	// still needs. Inherit that fd. A buffer gh passed in is finite, so it
+	// is sent through the pipe.
+	inherit := stdin == os.Stdin
+	var input []byte
+	if stdin != nil && !inherit {
+		data, err := io.ReadAll(stdin)
+		if err != nil {
+			return err
+		}
+		input = data
+	}
+	var result struct {
+		Status int    `json:"status"`
+		Stdout []byte `json:"stdout"`
+		Stderr []byte `json:"stderr"`
+	}
+	request := map[string]any{
+		"op":    "run",
+		"argv":  append([]string{name}, args...),
+		"env":   env,
+		"dir":   dir,
+		"stdin": input,
+	}
+	if inherit {
+		request["inherit"] = true
+	}
+	if err := call(request, &result); err != nil {
+		return err
+	}
+	if stdout != nil {
+		if _, err := stdout.Write(result.Stdout); err != nil {
+			return err
+		}
+	}
+	if stderr != nil {
+		if _, err := stderr.Write(result.Stderr); err != nil {
+			return err
+		}
+	}
+	if result.Status != 0 {
+		return &ExitError{Code: result.Status}
+	}
+	return ctx.Err()
+}
+
+// Transport sends HTTP requests through the host.
+type Transport struct{}
+
+// RoundTrip implements http.RoundTripper.
+func (Transport) RoundTrip(request *http.Request) (*http.Response, error) {
+	var body []byte
+	if request.Body != nil {
+		data, err := io.ReadAll(request.Body)
+		_ = request.Body.Close()
+		if err != nil {
+			return nil, err
+		}
+		body = data
+	}
+	headers := [][2]string{}
+	for name, values := range request.Header {
+		for _, value := range values {
+			headers = append(headers, [2]string{name, value})
+		}
+	}
+	var head struct {
+		Handle  int         `json:"handle"`
+		Status  int         `json:"status"`
+		Headers [][2]string `json:"headers"`
+	}
+	if err := call(map[string]any{
+		"op":      "http",
+		"method":  request.Method,
+		"url":     request.URL.String(),
+		"headers": headers,
+		"body":    body,
+	}, &head); err != nil {
+		return nil, err
+	}
+	response := &http.Response{
+		Status:        fmt.Sprintf("%d %s", head.Status, http.StatusText(head.Status)),
+		StatusCode:    head.Status,
+		Proto:         "HTTP/1.1",
+		ProtoMajor:    1,
+		ProtoMinor:    1,
+		Header:        http.Header{},
+		Body:          &responseBody{handle: head.Handle},
+		ContentLength: -1,
+		Request:       request,
+	}
+	for _, pair := range head.Headers {
+		response.Header.Add(pair[0], pair[1])
+	}
+	return response, nil
+}
+
+type responseBody struct {
+	handle  int
+	pending bytes.Buffer
+	done    bool
+	closed  bool
+}
+
+func (b *responseBody) Read(p []byte) (int, error) {
+	for b.pending.Len() == 0 {
+		if b.done {
+			return 0, io.EOF
+		}
+		var chunk []byte
+		if err := call(map[string]any{"op": "http.read", "handle": b.handle}, &chunk); err != nil {
+			return 0, err
+		}
+		if len(chunk) == 0 {
+			b.done = true
+			continue
+		}
+		b.pending.Write(chunk)
+	}
+	return b.pending.Read(p)
+}
+
+func (b *responseBody) Close() error {
+	if b.closed {
+		return nil
+	}
+	b.closed = true
+	return call(map[string]any{"op": "http.close", "handle": b.handle}, nil)
+}
