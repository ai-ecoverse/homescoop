+func (c cmdWithStderr) outputOnHost() ([]byte, error) {
+	stdout := &bytes.Buffer{}
+	prevOut, prevErr := c.Cmd.Stdout, c.Cmd.Stderr
+	c.Cmd.Stdout = stdout
+	stderr := &bytes.Buffer{}
+	if c.Cmd.Stderr == nil {
+		c.Cmd.Stderr = stderr
+	}
+	err := runOnHost(c.Cmd)
+	c.Cmd.Stdout, c.Cmd.Stderr = prevOut, prevErr
+	if err == nil || prevErr != nil {
+		return stdout.Bytes(), err
+	}
+	return stdout.Bytes(), &CmdError{Args: c.Cmd.Args, Err: err, Stderr: stderr}
+}
+
+func (c cmdWithStderr) runOnHost() error {
+	if c.Cmd.Stderr != nil {
+		return runOnHost(c.Cmd)
+	}
+	errStream := &bytes.Buffer{}
+	c.Cmd.Stderr = errStream
+	err := runOnHost(c.Cmd)
+	c.Cmd.Stderr = nil
+	if err != nil {
+		err = &CmdError{Args: c.Cmd.Args, Err: err, Stderr: errStream}
+	}
+	return err
+}
+
+func runOnHost(cmd *exec.Cmd) error {
+	name := cmd.Path
+	args := cmd.Args
+	if len(args) > 0 {
+		if name == "" {
+			name = args[0]
+		}
+		if args[0] == name || args[0] == filepath.Base(name) {
+			args = args[1:]
+		}
+	}
+	env := cmd.Env
+	if env == nil {
+		env = os.Environ()
+	}
+	return slicchost.Run(context.Background(), name, args, env, cmd.Dir, cmd.Stdin, cmd.Stdout, cmd.Stderr)
+}
