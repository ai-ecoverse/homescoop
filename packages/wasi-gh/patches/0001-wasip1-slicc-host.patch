diff --git a/internal/slicchost/slicchost.go b/internal/slicchost/slicchost.go
--- /dev/null
+++ b/internal/slicchost/slicchost.go
@@ -0,0 +1,26 @@
+// Package slicchost reaches the host functions that wasi-gh's host module
+// (host/gh-host.mjs) provides on slicc-kernel: starting commands and sending
+// HTTP requests. Where the module is missing, every call returns ErrUnsupported.
+package slicchost
+
+import (
+	"errors"
+	"fmt"
+)
+
+// ErrUnsupported is returned when the runtime does not provide gh's host module.
+var ErrUnsupported = errors.New("this runtime cannot start commands or open network connections for gh (it needs slicc-kernel with @ai-ecoverse/wasi-gh's host module)")
+
+// ExitError is a command that ran and exited with a non-zero status.
+type ExitError struct {
+	Code int
+}
+
+func (e *ExitError) Error() string {
+	return fmt.Sprintf("exit status %d", e.Code)
+}
+
+// ExitCode returns the command's exit status.
+func (e *ExitError) ExitCode() int {
+	return e.Code
+}
