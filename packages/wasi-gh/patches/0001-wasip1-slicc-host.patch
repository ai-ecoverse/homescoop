--- /dev/null
+++ b/internal/flock/flock_wasip1.go
@@ -0,0 +1,15 @@
+//go:build wasip1
+
+package flock
+
+import "os"
+
+// TryLock opens the lock file without an OS flock. wasip1 has no flock, and a
+// gh process on slicc-kernel is the only writer of its config for that call.
+func TryLock(path string) (f *os.File, unlock func(), err error) {
+	f, err = os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o644)
+	if err != nil {
+		return nil, nil, err
+	}
+	return f, func() { _ = f.Close() }, nil
+}
