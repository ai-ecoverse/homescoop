+//go:build wasip1
+
+package terminal
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+)
+
+// wasip1 has no termios. Prompts that need raw mode fail; line reads still work.
+type runeReaderState struct {
+	reader *bufio.Reader
+	buf    *bytes.Buffer
+}
+
+func newRuneReaderState(input FileReader) runeReaderState {
+	buf := new(bytes.Buffer)
+	return runeReaderState{
+		reader: bufio.NewReader(&BufferedReader{In: input, Buffer: buf}),
+		buf:    buf,
+	}
+}
+
+func (rr *RuneReader) Buffer() *bytes.Buffer { return rr.state.buf }
+
+func (rr *RuneReader) SetTermMode() error {
+	return errors.New("terminal raw mode is not available on wasip1")
+}
+
+func (rr *RuneReader) RestoreTermMode() error { return nil }
+
+func (rr *RuneReader) ReadRune() (rune, int, error) {
+	return rr.state.reader.ReadRune()
+}
