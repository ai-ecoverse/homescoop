{
  "name": "@ai-ecoverse/py-bcrypt",
  "version": "5.0.0-1",
  "description": "bcrypt, modern password hashing for Python (used by paramiko).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
