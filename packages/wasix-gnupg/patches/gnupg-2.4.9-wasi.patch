+void
+gnupg_wasi_give_to_owner (const char *path, const char *ref, int isdir)
+{
+  struct stat st, lst, want, rst;
+  const char *base, *rbase;
+  char *dir;
+  size_t dlen;
+  int dfd, fd;
+
+  if (geteuid ())
+    return;
+  base = strrchr (path, '/');
+  dlen = base ? (size_t)(base - path) : 0;
+  base = base ? base + 1 : path;
+  if (!*base || !strcmp (base, ".") || !strcmp (base, ".."))
+    return;
+  dir = xtrymalloc (dlen + 2);
+  if (!dir)
+    return;
+  if (base == path)
+    strcpy (dir, ".");
+  else if (!dlen)
+    strcpy (dir, "/");
+  else
+    {
+      memcpy (dir, path, dlen);
+      dir[dlen] = 0;
+    }
+  dfd = open (dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  xfree (dir);
+  if (dfd == -1)
+    return;
+  if (fstat (dfd, &want) || !S_ISDIR (want.st_mode))
+    goto leave;
+  rbase = ref ? strrchr (ref, '/') : NULL;
+  rbase = rbase ? rbase + 1 : ref;
+  if (ref && (size_t)(rbase - ref) == (size_t)(base - path)
+      && !strncmp (ref, path, base - path) && *rbase
+      && strcmp (rbase, ".") && strcmp (rbase, "..")
+      && !fstatat (dfd, rbase, &rst, AT_SYMLINK_NOFOLLOW)
+      && S_ISREG (rst.st_mode))
+    {
+      want.st_uid = rst.st_uid;
+      want.st_gid = rst.st_gid;
+    }
+  if (fstatat (dfd, base, &lst, AT_SYMLINK_NOFOLLOW)
+      || (isdir ? !S_ISDIR (lst.st_mode) : !S_ISREG (lst.st_mode)))
+    goto leave;
+  fd = openat (dfd, base, (O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC
+                           | (isdir ? O_DIRECTORY : 0)));
+  if (fd == -1)
+    goto leave;
+  if (!fstat (fd, &st)
+      && st.st_dev == lst.st_dev && st.st_ino == lst.st_ino
+      && (isdir ? S_ISDIR (st.st_mode)
+                : (S_ISREG (st.st_mode) && st.st_nlink == 1))
+      && (st.st_uid != want.st_uid || st.st_gid != want.st_gid))
+    fchown (fd, want.st_uid, want.st_gid);
+  close (fd);
+ leave:
+  close (dfd);
+}
+
+int
+gnupg_wasi_create_file (const char *path)
+{
+  struct stat st, lst;
+  const char *base;
+  char *dir;
+  size_t dlen;
+  int dfd, fd, e;
+
+  base = strrchr (path, '/');
+  dlen = base ? (size_t)(base - path) : 0;
+  base = base ? base + 1 : path;
+  if (!*base || !strcmp (base, ".") || !strcmp (base, ".."))
+    {
+      errno = EINVAL;
+      return -1;
+    }
+  dir = xtrymalloc (dlen + 2);
+  if (!dir)
+    return -1;
+  if (base == path)
+    strcpy (dir, ".");
+  else if (!dlen)
+    strcpy (dir, "/");
+  else
+    {
+      memcpy (dir, path, dlen);
+      dir[dlen] = 0;
+    }
+  dfd = open (dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  xfree (dir);
+  if (dfd == -1)
+    return -1;
+  fd = -1;
+  if (unlinkat (dfd, base, 0) && errno != ENOENT)
+    goto leave;
+  fd = openat (dfd, base, (O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW
+                           | O_CLOEXEC), 0666);
+  if (fd == -1)
+    goto leave;
+  if (fstat (fd, &st) || fstatat (dfd, base, &lst, AT_SYMLINK_NOFOLLOW)
+      || !S_ISREG (st.st_mode) || !S_ISREG (lst.st_mode)
+      || st.st_nlink != 1 || lst.st_nlink != 1
+      || st.st_dev != lst.st_dev || st.st_ino != lst.st_ino)
+    {
+      close (fd);
+      fd = -1;
+      errno = EEXIST;
+    }
+ leave:
+  e = errno;
+  close (dfd);
+  errno = e;
+  return fd;
+}
+#endif
