+#ifdef __wasi__
+/* WASIX: there is no cheap fork (it needs an Asyncify'd program), so
+   every spawn is a posix_spawn, which wasix-libc maps onto proc_spawn3.
+   FDS are the child's stdin/stdout/stderr (-1: /dev/null, unless FLAGS
+   keep it); every other descriptor not in EXCEPT is closed in the child,
+   as do_exec does after a fork.  ENVP, if given, adds to the environment.  */
+#include <spawn.h>
+extern char **environ;
+
+static gpg_error_t
+wasi_spawn (const char *pgmname, const char *argv[], const int fds[3],
+            int *except, unsigned int flags, const char *envp[], pid_t *r_pid)
+{
+  posix_spawn_file_actions_t fa;
+  char **arg_list, **env_list = NULL;
+  const char *base;
+  int i, j, n, rc, fd, max_fd;
+  int keep[3];
+
+  keep[0] = !!(flags & GNUPG_SPAWN_KEEP_STDIN);
+  keep[1] = !!(flags & GNUPG_SPAWN_KEEP_STDOUT);
+  keep[2] = !!(flags & GNUPG_SPAWN_KEEP_STDERR);
+
+  for (n=0; argv && argv[n]; n++)
+    ;
+  arg_list = xcalloc (n+2, sizeof *arg_list);
+  base = strrchr (pgmname, '/');
+  arg_list[0] = (char *)(base? base+1 : pgmname);
+  for (i=0; i < n; i++)
+    arg_list[i+1] = (char *)argv[i];
+
+  if (envp && envp[0])
+    {
+      int nenv, nadd;
+
+      for (nenv=0; environ && environ[nenv]; nenv++)
+        ;
+      for (nadd=0; envp[nadd]; nadd++)
+        ;
+      env_list = xcalloc (nenv+nadd+1, sizeof *env_list);
+      for (i=j=0; i < nenv; i++)
+        {
+          const char *eq = strchr (environ[i], '=');
+          size_t klen = eq? (size_t)(eq - environ[i]) : strlen (environ[i]);
+          int k, overridden = 0;
+
+          for (k=0; k < nadd && !overridden; k++)
+            if (!strncmp (envp[k], environ[i], klen) && envp[k][klen] == '=')
+              overridden = 1;
+          if (!overridden)
+            env_list[j++] = environ[i];
+        }
+      for (i=0; i < nadd; i++)
+        env_list[j++] = (char *)envp[i];
+      env_list[j] = NULL;
+    }
+
+  posix_spawn_file_actions_init (&fa);
+  for (i=0; i <= 2; i++)
+    {
+      if (keep[i])
+        continue;
+      if (fds[i] == -1)
+        posix_spawn_file_actions_addopen (&fa, i, "/dev/null",
+                                          i? O_WRONLY : O_RDONLY, 0);
+      else if (fds[i] != i)
+        posix_spawn_file_actions_adddup2 (&fa, fds[i], i);
+    }
+  /* Close what the child must not inherit (do_exec's close_all_fds).  */
+  max_fd = get_max_fds ();
+  for (fd=3; fd < max_fd; fd++)
+    {
+      int skip = 0;
+
+      if (except)
+        for (i=0; except[i] != -1; i++)
+          if (except[i] == fd)
+            skip = 1;
+      if (!skip && fcntl (fd, F_GETFD) != -1)
+        posix_spawn_file_actions_addclose (&fa, fd);
+    }
+
+  rc = posix_spawn (r_pid, pgmname, &fa, NULL, arg_list,
+                    env_list? env_list : environ);
+  posix_spawn_file_actions_destroy (&fa);
+  xfree (arg_list);
+  xfree (env_list);
+  if (rc)
+    {
+      *r_pid = (pid_t)(-1);
+      gpg_err_set_errno (rc);
+      return my_error_from_syserror ();
+    }
+  return 0;
+}
+#endif /*__wasi__*/
