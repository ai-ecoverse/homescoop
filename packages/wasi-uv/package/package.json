{
  "name": "@ai-ecoverse/wasi-uv",
  "version": "0.13.1-4",
  "description": "Astral's uv for SLICC, with uvx, to manage Python environments and packages.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasi-uv/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasi-uv",
  "keywords": [
    "wasm",
    "wasi",
    "slicc",
    "homescoop",
    "python",
    "uv",
    "pip"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin"
  ],
  "dependencies": {
    "@ai-ecoverse/wasix-python": "3.14.2-24"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "slicc-kernel": ">=1.104.1"
  },
  "homescoop": {
    "recipe": "wasi-uv",
    "upstream": "0.13.1"
  },
  "slicc": {
    "abi": "wasi",
    "commands": {
      "uv": {
        "wasm": "bin/uv.wasm",
        "preopenRoot": true,
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "uvx": {
        "wasm": "bin/uv.wasm",
        "preopenRoot": true,
        "argv0": "uv",
        "args": [
          "tool",
          "uvx"
        ],
        "env": {
          "UV_LINK_MODE": "copy"
        }
      }
    }
  }
}
