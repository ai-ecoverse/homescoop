+fn copy_entrypoint(
+    _source: &Path,
+    _target: &Path,
+    _previous_executable: &Path,
+    _python_executable: &Path,
+) -> Result<(), CopyEntrypointError> {
+    Ok(())
+}
+
 /// Create a copy of the entrypoint at `source` at `target`, if it's a Python script launcher,
