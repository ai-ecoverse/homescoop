diff --git a/crates/uv/src/bin/uv.rs b/crates/uv/src/bin/uv.rs
--- a/crates/uv/src/bin/uv.rs
+++ b/crates/uv/src/bin/uv.rs
@@ -1,3 +1,5 @@
+// wasm32: the layout of `run()`'s future is deeper than the default query limit.
+#![cfg_attr(target_os = "wasi", recursion_limit = "256")]
 // Don't optimize the alloc crate away due to it being otherwise unused.
 // https://github.com/rust-lang/rust/issues/64402
 #[cfg(feature = "performance-memory-allocator")]
diff --git a/crates/uv/src/commands/cache_size.rs b/crates/uv/src/commands/cache_size.rs
--- a/crates/uv/src/commands/cache_size.rs
+++ b/crates/uv/src/commands/cache_size.rs
@@ -2,6 +2,7 @@
 
 use anstream::stream::IsTerminal;
 use anyhow::Result;
+#[cfg(not(target_os = "wasi"))]
 use diskus::DiskUsage;
 
 use crate::commands::human_readable_bytes;
@@ -40,9 +41,17 @@
         return Ok(ExitStatus::Success);
     }
 
-    let disk_usage = DiskUsage::new(vec![cache.root().to_path_buf()]);
-
-    let total_bytes = disk_usage.count_ignoring_errors();
+    #[cfg(not(target_os = "wasi"))]
+    let total_bytes = DiskUsage::new(vec![cache.root().to_path_buf()]).count_ignoring_errors();
+    // diskus needs unix metadata: on WASI, add up the files' lengths.
+    #[cfg(target_os = "wasi")]
+    let total_bytes = walkdir::WalkDir::new(cache.root())
+        .into_iter()
+        .filter_map(Result::ok)
+        .filter_map(|entry| entry.metadata().ok())
+        .filter(std::fs::Metadata::is_file)
+        .map(|metadata| metadata.len())
+        .sum::<u64>();
 
     if human_readable {
         let bytes = human_readable_bytes(total_bytes);
