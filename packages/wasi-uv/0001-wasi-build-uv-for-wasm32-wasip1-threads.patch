@@ -2,6 +2,7 @@ use std::fmt::Write;
 
 use anstream::stream::IsTerminal;
 use anyhow::Result;
+#[cfg(not(target_os = "wasi"))]
 use diskus::DiskUsage;
 
 use crate::commands::human_readable_bytes;
@@ -40,9 +41,17 @@ pub(crate) fn cache_size(
         return Ok(ExitStatus::Success);
     }
 
-    let disk_usage = DiskUsage::new(vec![cache.root().to_path_buf()]);
-
-    let total_bytes = disk_usage.count_ignoring_errors();
+    #[cfg(not(target_os = "wasi"))]
+    let total_bytes = DiskUsage::new(vec![cache.root().to_path_buf()]).count_ignoring_errors();
+    // diskus needs unix metadata: on WASI, add up the files' lengths.
+    #[cfg(target_os = "wasi")]
+    let total_bytes = walkdir::WalkDir::new(cache.root())
+        .into_iter()
+        .filter_map(Result::ok)
+        .filter_map(|entry| entry.metadata().ok())
+        .filter(std::fs::Metadata::is_file)
+        .map(|metadata| metadata.len())
+        .sum::<u64>();
 
     if human_readable {
         let bytes = human_readable_bytes(total_bytes);
