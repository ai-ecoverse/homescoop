+                    tag: s.to_string(),
+                });
+            }
+            return Ok(Self::Wasi {
+                release_arch: rest
+                    .parse::<ReleaseArch>()
+                    .map_err(|_| ParsePlatformTagError::InvalidCharacters { tag: s.to_string() })?,
+            });
+        }
+
         if let Some(rest) = s.strip_prefix("haiku_") {
             // Ex) haiku_1_x86_64
             if rest.is_empty() {
