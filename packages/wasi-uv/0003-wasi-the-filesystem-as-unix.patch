+/// WASI preview1 has no file locks: slicc's kernel keeps POSIX record locks
+/// behind its `slicc.fcntl_lock` import (slicc-kernel >= 1.100.0), which
+/// wasix-sysroot's libc uses for `fcntl`. See [`wasi_lock`].
+#[cfg(all(feature = "tokio", target_os = "wasi"))]
+impl LockedFileMode {
+    fn try_lock(self, file: &fs_err::File) -> Result<(), std::fs::TryLockError> {
+        wasi_lock::try_lock(self, file)
+    }
+
+    fn lock(self, file: &fs_err::File) -> Result<(), io::Error> {
+        wasi_lock::lock(self, file)
+    }
+}
+
+/// `flock` semantics on top of the kernel's whole-file `fcntl` record locks.
+///
+/// A record lock belongs to the process, not to the descriptor: a second
+/// descriptor of the same file in the same process would be granted any
+/// lock, one unlock would drop them all, and closing any descriptor of the
+/// file drops the process's locks on it. So the process keeps a table per
+/// lock file of who holds what: holders in this process exclude each other
+/// here (as `flock` on separate descriptors does), the kernel holds the
+/// strongest mode any of them holds (write if one is exclusive, read if all
+/// are shared), and the descriptors of a file that still has holders stay
+/// open until the last one lets go. A kernel without the import answers
+/// `ENOSYS`, and the lock is granted without one (as before).
+#[cfg(all(feature = "tokio", target_os = "wasi"))]
+mod wasi_lock {
+    use std::collections::HashMap;
+    use std::io;
+    use std::os::fd::AsRawFd;
+    use std::path::PathBuf;
+    use std::sync::{LazyLock, Mutex};
+    use std::time::Duration;
+
+    use super::LockedFileMode;
+
+    const F_SETLK: i32 = 13;
+    const F_RDLCK: i16 = 0;
+    const F_WRLCK: i16 = 1;
+    const F_UNLCK: i16 = 2;
+    const EAGAIN: i32 = 6;
+    const EBADF: i32 = 8;
+    const EINTR: i32 = 27;
+    const ENOSYS: i32 = 52;
+
+    /// musl's wasm32 `struct flock`, as the kernel reads it (32 bytes).
+    #[repr(C)]
+    struct Flock {
+        l_type: i16,
+        l_whence: i16,
+        pad: u32,
+        l_start: i64,
+        l_len: i64,
+        l_pid: i32,
+        pad2: u32,
+    }
+
+    #[link(wasm_import_module = "slicc")]
+    #[expect(unsafe_code)]
+    unsafe extern "C" {
+        fn fcntl_lock(fd: i32, cmd: i32, lock: *mut Flock) -> i32;
+    }
+
+    /// `F_SETLK` of the whole file, as `l_type`; the kernel's errno.
+    #[expect(unsafe_code)]
+    fn set(fd: i32, l_type: i16) -> i32 {
+        let mut lock = Flock {
+            l_type,
+            l_whence: 0,
+            pad: 0,
+            l_start: 0,
+            l_len: 0,
+            l_pid: 0,
+            pad2: 0,
+        };
+        loop {
+            // SAFETY: `lock` is a live, writable 32-byte struct for the call.
+            match unsafe { fcntl_lock(fd, F_SETLK, &raw mut lock) } {
+                EINTR => {}
+                errno => return errno,
+            }
+        }
+    }
+
+    #[derive(Default)]
+    struct Entry {
+        /// Descriptor and mode of each holder in this process.
+        holders: Vec<(i32, LockedFileMode)>,
+        /// What the kernel holds for this process.
+        held: Option<i16>,
+        /// Descriptors closed by their owners while others hold the file.
+        parked: Vec<fs_err::File>,
+    }
+
+    static TABLE: LazyLock<Mutex<HashMap<PathBuf, Entry>>> = LazyLock::new(Mutex::default);
+
+    fn key(file: &fs_err::File) -> PathBuf {
+        fs_err::canonicalize(file.path()).unwrap_or_else(|_| file.path().to_path_buf())
+    }
+
+    fn wanted(holders: &[(i32, LockedFileMode)]) -> Option<i16> {
+        if holders
+            .iter()
+            .any(|(_, mode)| matches!(mode, LockedFileMode::Exclusive))
+        {
+            Some(F_WRLCK)
+        } else if holders.is_empty() {
+            None
+        } else {
+            Some(F_RDLCK)
+        }
+    }
+
+    pub(super) fn try_lock(
+        mode: LockedFileMode,
+        file: &fs_err::File,
+    ) -> Result<(), std::fs::TryLockError> {
+        let fd = file.file().as_raw_fd();
+        let mut table = TABLE
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let entry = table.entry(key(file)).or_default();
+        let conflict = match mode {
+            LockedFileMode::Exclusive => !entry.holders.is_empty(),
+            LockedFileMode::Shared => entry
+                .holders
+                .iter()
+                .any(|(_, m)| matches!(m, LockedFileMode::Exclusive)),
+        };
+        if conflict {
+            return Err(std::fs::TryLockError::WouldBlock);
+        }
+        let mut holders = entry.holders.clone();
+        holders.push((fd, mode));
+        let want = wanted(&holders);
+        if want != entry.held {
+            let l_type = want.unwrap_or(F_UNLCK);
+            let mut errno = set(fd, l_type);
+            // The kernel wants a descriptor open for writing for a write
+            // lock: on a read-only one, a read lock still keeps writers out.
+            if errno == EBADF && l_type == F_WRLCK {
+                errno = set(fd, F_RDLCK);
+            }
+            match errno {
+                0 | ENOSYS => {}
+                EAGAIN => return Err(std::fs::TryLockError::WouldBlock),
+                errno => {
+                    return Err(std::fs::TryLockError::Error(io::Error::from_raw_os_error(
+                        errno,
+                    )));
+                }
+            }
+            entry.held = want;
+        }
+        entry.holders = holders;
+        Ok(())
+    }
+
+    /// Blocking lock: tries again until granted. `F_SETLKW` would wait in
+    /// the kernel, but not for holders in this process, and not while the
+    /// table is free for their unlocks.
+    pub(super) fn lock(mode: LockedFileMode, file: &fs_err::File) -> Result<(), io::Error> {
+        let mut pause = Duration::from_millis(5);
+        loop {
+            match try_lock(mode, file) {
+                Ok(()) => return Ok(()),
+                Err(std::fs::TryLockError::WouldBlock) => {}
+                Err(std::fs::TryLockError::Error(err)) => return Err(err),
+            }
+            std::thread::sleep(pause);
+            pause = (pause * 2).min(Duration::from_millis(100));
+        }
+    }
+
+    /// Release `file`'s lock and close it, or keep it open while other
+    /// holders in this process hold the file (closing would drop theirs).
+    pub(super) fn release(file: fs_err::File) -> Result<(), io::Error> {
+        let fd = file.file().as_raw_fd();
+        let path = key(&file);
+        let mut table = TABLE
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let Some(entry) = table.get_mut(&path) else {
+            return Ok(());
+        };
+        entry.holders.retain(|(holder, _)| *holder != fd);
+        let want = wanted(&entry.holders);
+        let mut result = Ok(());
+        if want != entry.held {
+            // A downgrade (write to read) or an unlock never waits.
+            match set(fd, want.unwrap_or(F_UNLCK)) {
+                0 | ENOSYS => entry.held = want,
+                errno => result = Err(io::Error::from_raw_os_error(errno)),
+            }
+        }
+        if entry.holders.is_empty() {
+            // Nobody in this process holds the file: close them all.
+            table.remove(&path);
+        } else {
+            entry.parked.push(file);
+        }
+        result
+    }
+
+    /// A descriptor whose lock was refused: closing it while others in this
+    /// process hold the file would drop their locks, so it waits with them.
+    pub(super) fn park(file: fs_err::File) {
+        let path = key(&file);
+        let mut table = TABLE
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        match table.get_mut(&path) {
+            Some(entry) if !entry.holders.is_empty() => entry.parked.push(file),
+            _ => {
+                table.remove(&path);
+            }
+        }
+    }
+}
