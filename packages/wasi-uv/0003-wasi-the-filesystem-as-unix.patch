+/// Make a file executable (`0o755`) in slicc's kernel, which keeps file modes
+/// behind its `slicc_fs` imports: WASI preview1 has no mode-setting call.
+/// Kernels without them answer `ENOSYS`, which is ignored.
+#[cfg(target_os = "wasi")]
+#[expect(unsafe_code)]
+pub fn set_executable(path: impl AsRef<Path>) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+
+    #[link(wasm_import_module = "slicc_fs")]
+    unsafe extern "C" {
+        fn fd_chmod(fd: i32, mode: i32) -> i32;
+    }
+    const ENOSYS: i32 = 52;
+
+    let file = fs_err::File::open(path.as_ref())?;
+    // SAFETY: `file` stays open for the call.
+    match unsafe { fd_chmod(file.file().as_raw_fd(), 0o755) } {
+        0 | ENOSYS => Ok(()),
+        errno => Err(io::Error::from_raw_os_error(errno)),
+    }
+}
