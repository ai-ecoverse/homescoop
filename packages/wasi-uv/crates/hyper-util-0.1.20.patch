+/// WASI has no socket2 and no `TcpSocket`: dial with WASIX `sock_connect`
+/// (slicc's kernel) and hand the connected stream to tokio.
+#[cfg(target_os = "wasi")]
+fn connect(
+    addr: &SocketAddr,
+    config: &Config,
+    connect_timeout: Option<Duration>,
+) -> Result<impl Future<Output = Result<TcpStream, ConnectError>>, ConnectError> {
+    use std::os::fd::{FromRawFd, IntoRawFd};
+
+    let _ = config;
+    let addr = *addr;
+    Ok(async move {
+        let stream = match connect_timeout {
+            Some(dur) => wasix_net::TcpStream::connect_timeout(&addr, dur),
+            None => wasix_net::TcpStream::connect(addr),
+        }
+        .map_err(ConnectError::m("tcp connect error"))?;
+        stream
+            .set_nonblocking(true)
+            .map_err(ConnectError::m("tcp set_nonblocking error"))?;
+        // SAFETY: the descriptor is a connected socket this function owns.
+        let std = unsafe { std::net::TcpStream::from_raw_fd(stream.into_raw_fd()) };
+        TcpStream::from_std(std).map_err(ConnectError::m("tcp open error"))
+    })
+}
