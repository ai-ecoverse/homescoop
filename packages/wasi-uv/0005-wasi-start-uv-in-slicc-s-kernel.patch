From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: homescoop <homescoop@ai-ecoverse.invalid>
Date: Fri, 16 Oct 2026 10:35:28 +0200
Subject: [PATCH] wasi: start uv in slicc's kernel

- chdir to the process's working directory: wasi-libc starts every
  program in /. PWD when it is the same directory as . (device and
  inode, as POSIX shells check PWD), otherwise the path found by walking
  .. up to the root, as getcwd(3) does; libc for stat(2). A parent can
  set a child's directory without rewriting PWD (Node's spawn with cwd):
  0.13.6-2 took that stale PWD and looked for the project there.
- At most 16 blocking threads: the kernel runs 64 threads in a process.
- A 2 ms timer task: tokio cannot wake its IO driver from another thread
  on WASI, so a task woken by a blocking thread (every tokio::fs call)
  would otherwise wait for the next IO event.
---
 Cargo.lock           |   1 +
 crates/uv/Cargo.toml |   5 +++++
 crates/uv/src/lib.rs |  97 ++++++++++++++++++++++++++++++++++++++++++++++++++-----
 3 files changed, 98 insertions(+), 5 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5664,6 +5664,7 @@
  "indoc",
  "insta",
  "itertools 0.14.0",
+ "libc",
  "owo-colors",
  "predicates",
  "regex",
diff --git a/crates/uv/Cargo.toml b/crates/uv/Cargo.toml
--- a/crates/uv/Cargo.toml
+++ b/crates/uv/Cargo.toml
@@ -103,6 +103,11 @@
 [target.'cfg(not(target_os = "wasi"))'.dependencies]
 diskus = { workspace = true }
 
+# wasi::working_directory compares PWD with the working directory by device
+# and inode.
+[target.'cfg(target_os = "wasi")'.dependencies]
+libc = { workspace = true }
+
 [target.'cfg(target_os = "windows")'.dependencies]
 self-replace = { workspace = true }
 uv-windows = { workspace = true }
diff --git a/crates/uv/src/lib.rs b/crates/uv/src/lib.rs
--- a/crates/uv/src/lib.rs
+++ b/crates/uv/src/lib.rs
@@ -3112,12 +3112,16 @@
 
     // See `min_stack_size` doc comment about `main2`
     let min_stack_size = min_stack_size();
+    #[cfg(target_os = "wasi")]
+    wasi::init();
     let main2 = move || {
-        let runtime = tokio::runtime::Builder::new_current_thread()
-            .enable_all()
-            .thread_stack_size(min_stack_size)
-            .build()
-            .expect("Failed building the Runtime");
+        let mut builder = tokio::runtime::Builder::new_current_thread();
+        builder.enable_all().thread_stack_size(min_stack_size);
+        #[cfg(target_os = "wasi")]
+        builder.max_blocking_threads(wasi::MAX_BLOCKING_THREADS);
+        let runtime = builder.build().expect("Failed building the Runtime");
+        #[cfg(target_os = "wasi")]
+        runtime.spawn(wasi::tick());
         // Box the large main future to avoid stack overflows.
         let result = runtime.block_on(Box::pin(run(cli, GlobalInitialization::Initialize)));
         // Avoid waiting for pending tasks to complete.
@@ -3171,3 +3175,86 @@
         }
     }
 }
+
+/// slicc's kernel (WASI preview1 with WASIX threads, sockets and processes).
+#[cfg(target_os = "wasi")]
+mod wasi {
+    use std::time::Duration;
+
+    /// The kernel runs at most 64 threads in a process.
+    pub(crate) const MAX_BLOCKING_THREADS: usize = 16;
+
+    /// wasi-libc starts every program in `/`: change into the process's
+    /// working directory ([`working_directory`]).
+    pub(crate) fn init() {
+        if let Some(dir) = working_directory() {
+            let _ = std::env::set_current_dir(dir);
+        }
+    }
+
+    /// The process's working directory, for wasi-libc's, which is always "/" at
+    /// start. Relative paths reach the real one (the kernel's `.` preopen), but
+    /// nothing gives its path. PWD names it only when it is the same directory
+    /// as `.` (device and inode), as POSIX shells check it: a parent can change
+    /// a child's directory without rewriting PWD, as Node's `spawn` with `cwd`
+    /// does. Otherwise the path is found as getcwd(3) finds it, by walking `..`
+    /// up to the root and looking for each directory in its parent. PWD=/ is
+    /// never taken: before the chdir, "/" can reach `.` too.
+    fn working_directory() -> Option<std::path::PathBuf> {
+        use std::ffi::CString;
+        use std::os::wasi::ffi::OsStrExt;
+        use std::path::{Component, Path, PathBuf};
+
+        #[allow(unsafe_code)]
+        fn id(path: &Path) -> Option<(libc::dev_t, libc::ino_t)> {
+            let path = CString::new(path.as_os_str().as_bytes()).ok()?;
+            let mut st = std::mem::MaybeUninit::<libc::stat>::uninit();
+            // SAFETY: `path` is NUL-terminated, and `st` is read only after
+            // stat(2) has filled it.
+            let st = unsafe {
+                if libc::stat(path.as_ptr(), st.as_mut_ptr()) != 0 {
+                    return None;
+                }
+                st.assume_init()
+            };
+            Some((st.st_dev, st.st_ino))
+        }
+
+        let here = id(Path::new("."))?;
+        if let Some(pwd) = std::env::var_os("PWD").map(PathBuf::from) {
+            let plain = pwd.is_absolute()
+                && pwd.parent().is_some()
+                && pwd
+                    .components()
+                    .all(|part| matches!(part, Component::RootDir | Component::Normal(_)));
+            if plain && id(&pwd) == Some(here) {
+                return Some(pwd);
+            }
+        }
+        let (mut dir, mut at, mut names) = (PathBuf::from("."), here, Vec::new());
+        loop {
+            let parent = dir.join("..");
+            let up = id(&parent)?;
+            if up == at {
+                break;
+            }
+            let name = std::fs::read_dir(&parent)
+                .ok()?
+                .flatten()
+                .map(|entry| entry.file_name())
+                .find(|name| id(&parent.join(name)) == Some(at))?;
+            names.push(name);
+            (dir, at) = (parent, up);
+        }
+        Some(names.iter().rev().fold(PathBuf::from("/"), |path, name| path.join(name)))
+    }
+
+    /// tokio cannot wake its IO driver from another thread on WASI, so a
+    /// task finished by a blocking thread would wait for the next IO event:
+    /// a timer bounds that wait.
+    pub(crate) async fn tick() {
+        loop {
+            tokio::time::sleep(Duration::from_millis(2)).await;
+        }
+    }
+}
