azure-storage-blob, -queue and -common without cryptography (homescoop#2112).

Their _encryption.py imports cryptography at module level, for client-side
encryption only, and every client imports _encryption. Without cryptography
(native code, not in this package) the whole of `az storage` broke, even
`az storage account list`: the storage module's arguments name data-plane
models, azure-cli-core's get_sdk() swallows the ImportError and returns
None, and az fails with "TypeError: 'NoneType' object is not iterable".

With the imports in a try, the SDKs load. Client-side encryption, which az
doesn't offer, raises an ImportError for cryptography when used. Applied by
build.sh to the installed SDKs.

--- a/azure/storage/blob/_encryption.py
+++ b/azure/storage/blob/_encryption.py
@@ -19,12 +19,22 @@
 from typing import OrderedDict as TypedOrderedDict
 from typing_extensions import Protocol
 
-from cryptography.hazmat.backends import default_backend
-from cryptography.hazmat.primitives.ciphers import Cipher
-from cryptography.hazmat.primitives.ciphers.aead import AESGCM
-from cryptography.hazmat.primitives.ciphers.algorithms import AES
-from cryptography.hazmat.primitives.ciphers.modes import CBC
-from cryptography.hazmat.primitives.padding import PKCS7
+try:
+    from cryptography.hazmat.backends import default_backend
+    from cryptography.hazmat.primitives.ciphers import Cipher
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+    from cryptography.hazmat.primitives.ciphers.algorithms import AES
+    from cryptography.hazmat.primitives.ciphers.modes import CBC
+    from cryptography.hazmat.primitives.padding import PKCS7
+except ImportError:  # homescoop#2112: no cryptography on wasix-python
+    # Only client-side encryption (key_encryption_key=...) needs these; the
+    # rest of the SDK works without them. Using one imports cryptography
+    # again, which raises the ImportError then.
+    def _needs_cryptography(*_args, **_kwargs):
+        from cryptography.hazmat.primitives.ciphers import Cipher as _  # noqa: F401
+        raise ImportError("cryptography")
+
+    default_backend = Cipher = AESGCM = AES = CBC = PKCS7 = _needs_cryptography
 
 from azure.core.exceptions import HttpResponseError
 from azure.core.utils import CaseInsensitiveDict
