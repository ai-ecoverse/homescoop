{
  "name": "@ai-ecoverse/wasm-emscripten",
  "version": "6.0.9-32",
  "description": "Emscripten 6.0.9, the C and C++ to WebAssembly compiler (emcc), run on wasix-python.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasm-emscripten/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasm-emscripten",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "emcc"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "emscripten-config",
    "bin",
    "lib",
    "emcc",
    "em++",
    "emar",
    "emranlib",
    "emcmake",
    "emconfigure",
    "emmake",
    "embuilder",
    "em-config",
    "emscan-deps",
    "*.py",
    "tools",
    "src",
    "system",
    "cmake",
    "third_party",
    "media",
    "AUTHORS",
    "SECURITY.md",
    "ChangeLog.md",
    "emscripten-version.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasm-emscripten",
    "upstream": "6.0.9"
  },
  "dependencies": {
    "@ai-ecoverse/wasix-python": ">=3.15.0-2 <3.15.1 || >=3.15.1-1 <3.15.2 || >=3.15.2-1 <3.15.3 || >=3.15.3-1 <3.15.4 || >=3.15.4-1 <3.15.5 || >=3.15.5-1 <3.15.6 || >=3.15.6-1 <3.15.7 || >=3.15.7-1 <3.15.8 || >=3.15.8-1 <3.15.9 || >=3.15.9-1 <3.15.10 || >=3.15.10-1 <3.15.11 || >=3.15.11-1 <3.15.12 || >=3.15.12-1 <3.15.13 || >=3.15.13-1 <3.15.14 || >=3.15.14-1 <3.15.15 || >=3.15.15-1 <3.15.16 || >=3.15.16-1 <3.15.17 || >=3.15.17-1 <3.15.18 || >=3.15.18-1 <3.15.19 || >=3.15.19-1 <3.15.20 || >=3.15.20-1 <3.15.21 || >=3.15.21-1 <3.15.22 || >=3.15.22-1 <3.15.23 || >=3.15.23-1 <3.15.24 || >=3.15.24-1 <3.15.25 || >=3.15.25-1 <3.15.26 || >=3.15.26-1 <3.15.27 || >=3.15.27-1 <3.15.28 || >=3.15.28-1 <3.15.29 || >=3.15.29-1 <3.15.30",
    "@ai-ecoverse/wasm-clang": "24.0.0-22",
    "@ai-ecoverse/wasm-binaryen": "132.0.0-4",
    "@ai-ecoverse/emscripten-cache": "6.0.9-7",
    "esbuild-wasm": "0.28.2",
    "typescript": "6.0.3",
    "acorn": "^8.18.0",
    "acorn-import-phases": "^1.0.4"
  },
  "engines": {
    "slicc-kernel": ">=1.122.3"
  },
  "slicc": {
    "abi": "emscripten",
    "env": {
      "EM_PACKAGE_ROOT": "${package}",
      "EM_CONFIG": "${package}/emscripten-config",
      "EM_CACHE_PACKAGE": "${package}/../emscripten-cache",
      "EM_LLVM_PACKAGE": "${package}/../wasm-clang",
      "EM_BINARYEN_PACKAGE": "${package}/../wasm-binaryen",
      "SLICC_EM_LIBDIR": "${package}/lib/slicc"
    },
    "commands": {
      "emcc": {
        "script": "bin/emcc"
      },
      "em++": {
        "script": "bin/em++"
      },
      "emar": {
        "script": "bin/emar"
      },
      "emranlib": {
        "script": "bin/emranlib"
      },
      "emcmake": {
        "script": "bin/emcmake"
      },
      "emconfigure": {
        "script": "bin/emconfigure"
      },
      "emmake": {
        "script": "bin/emmake"
      },
      "embuilder": {
        "script": "bin/embuilder"
      },
      "em-config": {
        "script": "bin/em-config"
      },
      "emscan-deps": {
        "script": "bin/emscan-deps"
      },
      "em-ensure-cache": {
        "script": "bin/em-ensure-cache"
      }
    }
  }
}
