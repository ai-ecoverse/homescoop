{
  "name": "@ai-ecoverse/wasm-cmake",
  "version": "4.4.3-12",
  "description": "CMake, the build system generator, to configure and build C and C++ projects.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/cmake/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/cmake",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "cmake"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "share"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "cmake",
    "upstream": "4.4.3"
  },
  "slicc": {
    "abi": "emscripten",
    "commands": {
      "cmake": {
        "glue": "bin/cmake",
        "wasm": "bin/cmake.wasm",
        "env": {
          "CMAKE_ROOT": "${package}/share/cmake-4.4"
        }
      }
    },
    "env": {
      "CMAKE_ROOT": "${package}/share/cmake-4.4"
    }
  }
}
