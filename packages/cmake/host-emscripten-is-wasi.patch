--- a/Modules/CMakeDetermineSystem.cmake
+++ b/Modules/CMakeDetermineSystem.cmake
@@ -140,6 +140,18 @@
   endif()
 endif()
 
+# homescoop: in slicc, cmake.wasm's uname is the kernel's, Linux with a
+# version like 6.0.0-slicc (Emscripten's own before slicc-kernel#625), but
+# the programs it builds are WASI modules that run natively in slicc's realm
+# (try_run works). Map that host to WASI so Platform/WASI.cmake applies and
+# executables are bare modules (homescoop#1278). An explicit
+# -DCMAKE_SYSTEM_NAME (Emscripten, say) still wins below.
+if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Emscripten" OR
+   (CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_HOST_SYSTEM_VERSION MATCHES "slicc"))
+  set(CMAKE_HOST_SYSTEM_NAME "WASI")
+  set(CMAKE_HOST_SYSTEM_PROCESSOR "wasm32")
+endif()
+
 # if a toolchain file is used, the user wants to cross compile.
 # in this case read the toolchain file and keep the CMAKE_HOST_SYSTEM_*
 # variables around so they can be used in CMakeLists.txt.
