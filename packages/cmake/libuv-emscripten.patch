--- a/Utilities/cmlibuv/src/unix/process.c
+++ b/Utilities/cmlibuv/src/unix/process.c
@@ -905,6 +905,16 @@
   return 0;
 }
 
+#if defined(__EMSCRIPTEN__)
+/* homescoop: slicc's realm has no fork. shims/slicc's slicc_spawn_capture
+ * starts the child as a kernel process on the child ends of the stdio pipes
+ * (-1: closed) and returns its pid, or -errno; waitpid and SIGCHLD then come
+ * through the kernel (slicc_poll, slicc_wait). */
+extern char** environ;
+int slicc_spawn_capture(const char *file, char *const *argv, char *const *envp,
+                        const char *cwd, int in_fd, int out_fd, int err_fd);
+#endif
+
 static int uv__spawn_and_init_child(
     uv_loop_t* loop,
     const uv_process_options_t* options,
@@ -917,6 +927,24 @@
   int exec_errorno;
   ssize_t r;
 
+#if defined(__EMSCRIPTEN__)
+  {
+    int fds[3];
+    int fd;
+    int child;
+    for (fd = 0; fd < 3; fd++)
+      fds[fd] = fd < stdio_count ? pipes[fd][1] : -1;
+    child = slicc_spawn_capture(options->file, options->args,
+                                options->env != NULL ? options->env : environ,
+                                options->cwd, fds[0], fds[1], fds[2]);
+    (void) signal_pipe; (void) status; (void) err; (void) exec_errorno; (void) r;
+    if (child < 0)
+      return child;
+    *pid = child;
+    return 0;
+  }
+#endif
+
 #if defined(UV_USE_APPLE_POSIX_SPAWN)
   uv_once(&posix_spawn_init_once, uv__spawn_init_posix_spawn);
 
