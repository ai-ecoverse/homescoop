+// SPDX-FileCopyrightText: 2026 ai-ecoverse/homescoop
+// SPDX-License-Identifier: EUPL-1.2
+//! slicc WASI preview1 (homescoop's wasi-eza).
+//!
+//! WASI's filestat has no mode, owner or block count, and Rust's
+//! `std::os::wasi::fs` is unstable, so eza's Unix code reads them from
+//! slicc-kernel's own imports instead:
+//!
+//! - `slicc_fs.path_filestat_owner`: the WASI filestat and the owner's
+//!   uid/gid in one call (ENOTSUP when the kernel runs without users; then
+//!   `wasi_snapshot_preview1.path_filestat_get` and the caller's ids, which is
+//!   what the kernel itself reports for a file without an owner);
+//! - `slicc_fs.path_mode`: the permission bits and `S_IFIFO` (ENOSYS on a
+//!   kernel without it: 0755 for directories, 0777 for links, 0644 else);
+//! - `slicc.cred_get`: the process's real and effective ids;
+//! - `slicc_tty.winsize`: the size of the pty on stdout.
+//!
+//! User and group names come from the kernel's `/etc/passwd` and
+//! `/etc/group`, which is what `uzers` (Unix only) reads through libc.
+#![allow(unsafe_code)]
+
+use std::fs;
+use std::io;
+use std::ops::Deref;
+use std::os::fd::{AsRawFd, RawFd};
+use std::os::wasi::ffi::OsStrExt;
+use std::path::Path;
+use std::sync::OnceLock;
+
+#[link(wasm_import_module = "slicc_fs")]
+unsafe extern "C" {
+    fn path_filestat_owner(
+        dirfd: i32,
+        lookup: i32,
+        path: *const u8,
+        len: usize,
+        stat: *mut Filestat,
+        owner: *mut [u32; 2],
+    ) -> i32;
+    fn path_mode(dirfd: i32, path: *const u8, len: usize, flags: i32, out: *mut u32) -> i32;
+}
+
+#[link(wasm_import_module = "wasi_snapshot_preview1")]
+unsafe extern "C" {
+    #[link_name = "path_filestat_get"]
+    fn wasi_path_filestat_get(
+        dirfd: i32,
+        lookup: i32,
+        path: *const u8,
+        len: usize,
+        stat: *mut Filestat,
+    ) -> i32;
+    fn fd_prestat_get(fd: i32, out: *mut [u32; 2]) -> i32;
+    fn fd_prestat_dir_name(fd: i32, path: *mut u8, len: usize) -> i32;
+    fn fd_close(fd: i32) -> i32;
+}
+
+unsafe extern "C" {
+    /// wasi-libc: forget the preopens it has read; it reads them again on
+    /// the next path lookup.
+    fn __wasilibc_reset_preopens();
+}
+
+#[link(wasm_import_module = "slicc")]
+unsafe extern "C" {
+    fn cred_get(out: *mut [u32; 6]) -> i32;
+}
+
+#[link(wasm_import_module = "slicc_tty")]
+unsafe extern "C" {
+    fn winsize(fd: i32, out: *mut [u16; 4]) -> i32;
+}
+
+/// WASI preview1 `filestat` (64 bytes).
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct Filestat {
+    dev: u64,
+    ino: u64,
+    filetype: u8,
+    nlink: u64,
+    size: u64,
+    atim: u64,
+    mtim: u64,
+    ctim: u64,
+}
+
+const LOOKUP_SYMLINK_FOLLOW: i32 = 1;
+const AT_SYMLINK_NOFOLLOW: i32 = 1;
+const ENOSYS: i32 = 52;
+const ENOTSUP: i32 = 58;
+
+const FILETYPE_BLOCK_DEVICE: u8 = 1;
+const FILETYPE_CHARACTER_DEVICE: u8 = 2;
+const FILETYPE_DIRECTORY: u8 = 3;
+const FILETYPE_SOCKET_DGRAM: u8 = 5;
+const FILETYPE_SOCKET_STREAM: u8 = 6;
+const FILETYPE_SYMBOLIC_LINK: u8 = 7;
+
+const S_IFMT: u32 = 0o170_000;
+const S_IFIFO: u32 = 0o010_000;
+
+/// A file's metadata: what `std` has (times, length, type) and what eza's
+/// Unix code reads through `std::os::unix::fs::MetadataExt`.
+pub struct Metadata {
+    std: fs::Metadata,
+    stat: Filestat,
+    mode: u32,
+    uid: u32,
+    gid: u32,
+}
+
+impl Deref for Metadata {
+    type Target = fs::Metadata;
+    fn deref(&self) -> &fs::Metadata {
+        &self.std
+    }
+}
+
+impl Metadata {
+    pub fn is_fifo(&self) -> bool {
+        self.mode & S_IFMT == S_IFIFO
+    }
+    pub fn is_char_device(&self) -> bool {
+        self.stat.filetype == FILETYPE_CHARACTER_DEVICE
+    }
+    pub fn is_block_device(&self) -> bool {
+        self.stat.filetype == FILETYPE_BLOCK_DEVICE
+    }
+    pub fn is_socket(&self) -> bool {
+        matches!(
+            self.stat.filetype,
+            FILETYPE_SOCKET_DGRAM | FILETYPE_SOCKET_STREAM
+        )
+    }
+}
+
+/// The subset of `std::os::unix::fs::MetadataExt` that eza uses.
+pub trait MetadataExt {
+    fn dev(&self) -> u64;
+    fn ino(&self) -> u64;
+    fn nlink(&self) -> u64;
+    fn mode(&self) -> u32;
+    fn uid(&self) -> u32;
+    fn gid(&self) -> u32;
+    fn size(&self) -> u64;
+    /// 512-byte blocks: WASI has no block count, so the size rounded up.
+    fn blocks(&self) -> u64;
+    fn ctime(&self) -> i64;
+    fn ctime_nsec(&self) -> i64;
+}
+
+impl MetadataExt for Metadata {
+    fn dev(&self) -> u64 {
+        self.stat.dev
+    }
+    fn ino(&self) -> u64 {
+        self.stat.ino
+    }
+    fn nlink(&self) -> u64 {
+        self.stat.nlink
+    }
+    fn mode(&self) -> u32 {
+        self.mode
+    }
+    fn uid(&self) -> u32 {
+        self.uid
+    }
+    fn gid(&self) -> u32 {
+        self.gid
+    }
+    fn size(&self) -> u64 {
+        self.stat.size
+    }
+    fn blocks(&self) -> u64 {
+        self.stat.size.div_ceil(512)
+    }
+    fn ctime(&self) -> i64 {
+        (self.stat.ctim / 1_000_000_000) as i64
+    }
+    fn ctime_nsec(&self) -> i64 {
+        (self.stat.ctim % 1_000_000_000) as i64
+    }
+}
+
+/// `std::fs::symlink_metadata`, with mode and owner.
+pub fn symlink_metadata(path: &Path) -> io::Result<Metadata> {
+    let std = fs::symlink_metadata(path)?;
+    stat(path, std, false)
+}
+
+/// `std::fs::metadata`, with mode and owner.
+pub fn metadata(path: &Path) -> io::Result<Metadata> {
+    let std = fs::metadata(path)?;
+    stat(path, std, true)
+}
+
+fn stat(path: &Path, std: fs::Metadata, follow: bool) -> io::Result<Metadata> {
+    at(path, |dirfd, name| {
+        let lookup = if follow { LOOKUP_SYMLINK_FOLLOW } else { 0 };
+        let mut stat = Filestat::default();
+        let mut owner = [0u32; 2];
+        // SAFETY: `name` and both outputs are live for the call.
+        let mut errno = unsafe {
+            path_filestat_owner(
+                dirfd,
+                lookup,
+                name.as_ptr(),
+                name.len(),
+                &raw mut stat,
+                &raw mut owner,
+            )
+        };
+        if errno == ENOTSUP || errno == ENOSYS {
+            // SAFETY: as above.
+            errno = unsafe {
+                wasi_path_filestat_get(dirfd, lookup, name.as_ptr(), name.len(), &raw mut stat)
+            };
+            let ids = creds();
+            owner = [ids[1], ids[4]];
+        }
+        if errno != 0 {
+            return Err(io::Error::from_raw_os_error(errno));
+        }
+        let flags = if follow { 0 } else { AT_SYMLINK_NOFOLLOW };
+        let mut mode = 0u32;
+        // SAFETY: as above.
+        let errno = unsafe { path_mode(dirfd, name.as_ptr(), name.len(), flags, &raw mut mode) };
+        if errno != 0 {
+            mode = match stat.filetype {
+                FILETYPE_DIRECTORY => 0o755,
+                FILETYPE_SYMBOLIC_LINK => 0o777,
+                _ => 0o644,
+            };
+        }
+        Ok(Metadata {
+            std,
+            stat,
+            mode,
+            uid: owner[0],
+            gid: owner[1],
+        })
+    })
+}
+
+/// Start in the working directory slicc-kernel names in `PWD`.
+///
+/// The kernel starts a WASI process with wasi-libc's working directory at
+/// `/` and preopens the real one twice: as `.`, and (with `"preopenRoot":
+/// true`, after `/`) as `./`, so that relative paths, which wasi-libc makes
+/// absolute from `/`, reach it. wasi-libc resolves an absolute path
+/// through the longest preopen name that prefixes it, the last one on a
+/// tie: `/` and `./` both have the empty prefix, so `eza /` listed the
+/// working directory. Once wasi-libc is in `PWD`, relative paths don't
+/// need `./`: close it, so `/` is the root.
+pub fn start() {
+    let Some(pwd) = std::env::var_os("PWD") else {
+        return;
+    };
+    let (mut root, mut twin) = (false, None);
+    for fd in 3.. {
+        let mut prestat = [0u32; 2];
+        // SAFETY: `prestat` is live for the call.
+        if unsafe { fd_prestat_get(fd, &raw mut prestat) } != 0 || prestat[0] != 0 {
+            break;
+        }
+        let mut name = vec![0u8; prestat[1] as usize];
+        // SAFETY: `name` has the length the kernel gave.
+        if unsafe { fd_prestat_dir_name(fd, name.as_mut_ptr(), name.len()) } != 0 {
+            break;
+        }
+        match name.as_slice() {
+            b"/" => root = true,
+            b"./" => twin = Some(fd),
+            _ => {}
+        }
+    }
+    if std::env::set_current_dir(&pwd).is_err() {
+        return;
+    }
+    if let (true, Some(fd)) = (root, twin) {
+        // SAFETY: the twin is a preopen of ours that nothing else holds.
+        unsafe {
+            fd_close(fd);
+            __wasilibc_reset_preopens();
+        }
+        let _ = std::env::set_current_dir(&pwd);
+    }
+}
+
+/// A directory fd and a path for slicc_fs's `*at` calls, resolved as `std`
+/// resolves the path: an absolute path ignores the fd (`AT_FDCWD`), a
+/// relative one is looked up from the working directory, opened once.
+fn at<T>(path: &Path, f: impl FnOnce(RawFd, &[u8]) -> io::Result<T>) -> io::Result<T> {
+    const AT_FDCWD: RawFd = -2;
+    static CWD: OnceLock<Option<fs::File>> = OnceLock::new();
+    let path = path.as_os_str().as_bytes();
+    if path.first() == Some(&b'/') {
+        return f(AT_FDCWD, path);
+    }
+    let cwd = CWD.get_or_init(|| fs::File::open(".").ok());
+    let Some(cwd) = cwd else {
+        return Err(io::Error::from(io::ErrorKind::NotFound));
+    };
+    f(cwd.as_raw_fd(), if path.is_empty() { b"." } else { path })
+}
+
+/// ruid, euid, suid, rgid, egid, sgid (all 0 on a kernel without them).
+fn creds() -> [u32; 6] {
+    let mut ids = [0u32; 6];
+    // SAFETY: `ids` is live for the call.
+    if unsafe { cred_get(&raw mut ids) } != 0 {
+        return [0; 6];
+    }
+    ids
+}
+
+/// The width of the pty on stdout, if it is one.
+pub fn terminal_width() -> Option<usize> {
+    let mut ws = [0u16; 4];
+    // SAFETY: `ws` is live for the call.
+    let errno = unsafe { winsize(1, &raw mut ws) };
+    (errno == 0 && ws[1] > 0).then_some(usize::from(ws[1]))
+}
+
+/// The part of `uzers` that eza's renderers use, over `/etc/passwd` and
+/// `/etc/group`.
+pub mod users {
+    use std::collections::HashMap;
+    use std::ffi::{OsStr, OsString};
+    use std::sync::{Arc, OnceLock};
+
+    #[allow(non_camel_case_types)]
+    pub type uid_t = u32;
+    #[allow(non_camel_case_types)]
+    pub type gid_t = u32;
+
+    #[derive(Clone, Debug)]
+    pub struct User {
+        name: OsString,
+        primary_group: gid_t,
+    }
+
+    impl User {
+        pub fn name(&self) -> &OsStr {
+            &self.name
+        }
+        pub fn primary_group_id(&self) -> gid_t {
+            self.primary_group
+        }
+    }
+
+    #[derive(Clone, Debug)]
+    pub struct Group {
+        gid: gid_t,
+        name: OsString,
+        members: Vec<OsString>,
+    }
+
+    impl Group {
+        pub fn gid(&self) -> gid_t {
+            self.gid
+        }
+        pub fn name(&self) -> &OsStr {
+            &self.name
+        }
+        pub fn members(&self) -> &[OsString] {
+            &self.members
+        }
+    }
+
+    pub trait Users {
+        fn get_user_by_uid(&self, uid: uid_t) -> Option<Arc<User>>;
+        fn get_current_uid(&self) -> uid_t;
+    }
+
+    pub trait Groups {
+        fn get_group_by_gid(&self, gid: gid_t) -> Option<Arc<Group>>;
+    }
+
+    struct Tables {
+        users: HashMap<uid_t, Arc<User>>,
+        groups: HashMap<gid_t, Arc<Group>>,
+    }
+
+    /// Reads `/etc/passwd` and `/etc/group` once, on the first lookup.
+    #[derive(Default)]
+    pub struct UsersCache {
+        tables: OnceLock<Tables>,
+        uid: OnceLock<uid_t>,
+    }
+
+    impl UsersCache {
+        pub fn new() -> Self {
+            Self::default()
+        }
+
+        fn tables(&self) -> &Tables {
+            self.tables.get_or_init(|| {
+                let read = |p| std::fs::read_to_string(p).unwrap_or_default();
+                let mut users = HashMap::new();
+                for line in read("/etc/passwd").lines() {
+                    let f: Vec<&str> = line.split(':').collect();
+                    if let (Some(name), Some(Ok(uid)), Some(Ok(gid))) = (
+                        f.first(),
+                        f.get(2).map(|s| s.parse()),
+                        f.get(3).map(|s| s.parse()),
+                    ) {
+                        users.entry(uid).or_insert_with(|| {
+                            Arc::new(User {
+                                name: (*name).into(),
+                                primary_group: gid,
+                            })
+                        });
+                    }
+                }
+                let mut groups = HashMap::new();
+                for line in read("/etc/group").lines() {
+                    let f: Vec<&str> = line.split(':').collect();
+                    if let (Some(name), Some(Ok(gid))) = (f.first(), f.get(2).map(|s| s.parse())) {
+                        let members = f
+                            .get(3)
+                            .map(|m| {
+                                m.split(',')
+                                    .filter(|m| !m.is_empty())
+                                    .map(OsString::from)
+                                    .collect()
+                            })
+                            .unwrap_or_default();
+                        groups.entry(gid).or_insert_with(|| {
+                            Arc::new(Group {
+                                gid,
+                                name: (*name).into(),
+                                members,
+                            })
+                        });
+                    }
+                }
+                Tables { users, groups }
+            })
+        }
+    }
+
+    impl Users for UsersCache {
+        fn get_user_by_uid(&self, uid: uid_t) -> Option<Arc<User>> {
+            self.tables().users.get(&uid).cloned()
+        }
+        fn get_current_uid(&self) -> uid_t {
+            *self.uid.get_or_init(|| super::creds()[0])
+        }
+    }
+
+    impl Groups for UsersCache {
+        fn get_group_by_gid(&self, gid: gid_t) -> Option<Arc<Group>> {
+            self.tables().groups.get(&gid).cloned()
+        }
+    }
+}
