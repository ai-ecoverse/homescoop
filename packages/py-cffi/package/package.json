{
  "name": "@ai-ecoverse/py-cffi",
  "version": "2.1.1-2",
  "description": "cffi, the C Foreign Function Interface for Python, with its _cffi_backend, for slicc WASIX CPython.",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-cffi/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/py-cffi",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "slicc",
    "homescoop",
    "python"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "lib",
    "share"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-ecoverse/py-pycparser": ">=3.12.0-1 <3.12.1",
    "@ai-ecoverse/wasix-python": ">=3.15.0-1 <3.15.1"
  },
  "homescoop": {
    "recipe": "py-cffi",
    "upstream": "2.1.1",
    "platform": "wasix_wasm32"
  },
  "slicc": {
    "python": {
      "sitePackages": "lib/python3.15/site-packages",
      "requires": {
        "abi": "cp315",
        "platform": "wasix_wasm32"
      }
    }
  }
}
