{
  "name": "@ai-ecoverse/wasm-gmake",
  "version": "4.4.1-4",
  "description": "GNU make for slicc (rebuild sweep wasix-sysroot 2025.9.30-14; emscripten ABI)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/gmake/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/gmake",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "gmake",
    "make"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "gmake",
    "upstream": "4.4.1"
  },
  "slicc": {
    "abi": "emscripten",
    "commands": {
      "make": {
