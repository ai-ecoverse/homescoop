{
  "name": "@ai-ecoverse/py-pynacl",
  "version": "1.6.2-1",
  "description": "PyNaCl, Python bindings to libsodium (public-key and secret-key boxes, sealed boxes, signing, password hashing).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-pynacl/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/py-pynacl",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "slicc",
    "homescoop",
    "python",
    "pynacl",
    "libsodium"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-ecoverse/py-cffi": ">=2.1.1-1 <2.1.2",
    "@ai-ecoverse/wasix-python": ">=3.15.0-1 <3.15.1"
  },
  "homescoop": {
    "recipe": "py-pynacl",
    "upstream": "1.6.2",
    "platform": "wasix_wasm32"
  },
  "slicc": {
    "python": {
      "sitePackages": "lib/python3.15/site-packages",
      "requires": {
        "abi": "cp315",
        "platform": "wasix_wasm32"
      }
    }
  }
}
