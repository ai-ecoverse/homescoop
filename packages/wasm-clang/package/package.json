{
  "name": "@ai-ecoverse/wasm-clang",
  "version": "24.0.0-23",
  "description": "The Clang and LLD 24 compilers, to build C and C++ programs in slicc.",
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasm-clang/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasm-clang",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "clang",
    "llvm",
    "wasix"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasm-clang",
    "upstream": "24.0.0"
  },
  "dependencies": {
    "@ai-ecoverse/wasix-sysroot": "2025.9.30-38",
    "@ai-ecoverse/wasm-binaryen": "132.0.0-4"
  },
  "engines": {
    "slicc-kernel": ">=1.44.0"
  },
  "slicc": {
    "abi": "emscripten",
    "env": {
      "CLANG_RESOURCE_DIR": "${package}/lib/clang/24",
      "WASIXCC_SYSROOT_PREFIX": "${package}/../wasix-sysroot"
    },
    "commands": {
      "cc": {
        "script": "bin/cc"
      },
      "gcc": {
        "script": "bin/gcc"
      },
      "c++": {
        "script": "bin/c++"
      },
      "g++": {
        "script": "bin/g++"
      },
      "wasixcc": {
        "script": "bin/wasixcc"
      },
      "wasix++": {
        "script": "bin/wasix++"
      },
      "clang": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "clang"
      },
      "clang++": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "clang++"
      },
      "lld": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "lld",
        "helper": true
      },
      "wasm-ld": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "wasm-ld",
        "helper": true
      },
      "ld.lld": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "ld.lld",
        "helper": true
      },
      "llvm-ar": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-ar"
      },
      "llvm-ranlib": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-ranlib"
      },
      "llvm-nm": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-nm"
      },
      "llvm-objcopy": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-objcopy"
      },
      "llvm-strip": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-strip"
      },
      "llvm-symbolizer": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-symbolizer",
        "helper": true
      },
      "ar": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-ar"
      },
      "ranlib": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-ranlib"
      },
      "nm": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-nm"
      },
      "strip": {
        "glue": "bin/llvm",
        "wasm": "bin/llvm.wasm",
        "argv0": "llvm-strip"
      }
    }
  }
}
