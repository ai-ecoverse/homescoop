@@ -671,8 +671,34 @@
     Ok(())
 }
 
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer"))]
+const WASIX_REFUSED: &str = "subprocesses are not supported on WASIX";
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer"))]
+fn subprocess_new_refused(ctx: NativeCallContext, _program_name: String) -> RhResult<Handle<Command>> {
+    Err(ctx.err(WASIX_REFUSED))
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer"))]
+fn subprocess_new_osstr_refused(ctx: NativeCallContext, _program_name: OsString) -> RhResult<Handle<Command>> {
+    Err(ctx.err(WASIX_REFUSED))
+}
+
+#[cfg(all(target_os = "wasi", target_vendor = "wasmer"))]
+fn simplified_exec_refused(ctx: NativeCallContext, _cmdline: &str) -> RhResult<Handle<Hangup>> {
+    Err(ctx.err(WASIX_REFUSED))
+}
+
 pub fn register(engine: &mut Engine) {
+    #[cfg(all(target_os = "wasi", target_vendor = "wasmer"))]
+    {
+        engine.register_fn("subprocess_new", subprocess_new_refused);
+        engine.register_fn("subprocess_new_osstr", subprocess_new_osstr_refused);
+        engine.register_fn("system", simplified_exec_refused);
+    }
+    #[cfg(not(all(target_os = "wasi", target_vendor = "wasmer")))]
     engine.register_fn("subprocess_new", subprocess_new);
+    #[cfg(not(all(target_os = "wasi", target_vendor = "wasmer")))]
     engine.register_fn("subprocess_new_osstr", subprocess_new_osstr);
     engine.register_fn("arg", subprocess_arg);
     engine.register_fn("arg_osstr", subprocess_arg_osstr);
@@ -704,5 +730,6 @@
     #[cfg(unix)]
     engine.register_fn("dup2", subprocess_dup2);
 
+    #[cfg(not(all(target_os = "wasi", target_vendor = "wasmer")))]
     engine.register_fn("system", simplified_exec);
 }
