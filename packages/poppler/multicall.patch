--- /dev/null
+++ b/utils/poppler-multicall.cc
@@ -0,0 +1,37 @@
+// homescoop: poppler's command-line utilities in one program. The util
+// runs by the name it was called as (argv[0]), or by the first argument
+// when called as poppler-multicall.
+#include <cstdio>
+#include <cstring>
+
+#define HS_UTILS(X)                                                                                                                                  \
+    X(pdftoppm) X(pdftotext) X(pdfinfo) X(pdfimages) X(pdffonts) X(pdfseparate) X(pdfunite) X(pdfdetach) X(pdfattach) X(pdftops) X(pdftohtml)
+
+#define HS_DECL(n) int n##_main(int argc, char *argv[]);
+HS_UTILS(HS_DECL)
+
+static bool dispatch(const char *name, int argc, char *argv[], int *rc)
+{
+#define HS_CASE(n)                                                                                                                                   \
+    if (!strcmp(name, #n)) {                                                                                                                         \
+        *rc = n##_main(argc, argv);                                                                                                                  \
+        return true;                                                                                                                                 \
+    }
+    HS_UTILS(HS_CASE)
+    return false;
+}
+
+int main(int argc, char *argv[])
+{
+    const char *name = argc > 0 ? strrchr(argv[0], '/') : nullptr;
+    name = name ? name + 1 : (argc > 0 ? argv[0] : "");
+    int rc = 0;
+    if (dispatch(name, argc, argv, &rc) || (argc > 1 && dispatch(argv[1], argc - 1, argv + 1, &rc))) {
+        return rc;
+    }
+    fprintf(stderr, "usage: poppler-multicall <util> [args...]\nutils:");
+#define HS_NAME(n) fprintf(stderr, " %s", #n);
+    HS_UTILS(HS_NAME)
+    fprintf(stderr, "\n");
+    return 99;
+}
