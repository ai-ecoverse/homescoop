 			return &fs.PathError{Op: "stat", Path: path, Err: fs.ErrNotExist}
 		}
 		// The path might have a regular file in one of its
@@ -451,6 +451,11 @@ func validateDirPathExists(dirPath string, symlinks bool) error {
