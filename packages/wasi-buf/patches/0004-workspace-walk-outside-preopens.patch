+//go:build wasip1
+
+package storageos
+
+import (
+	"errors"
+	"syscall"
+)
+
+// outsidePreopens reports whether err comes from a path that no WASI preopen
+// covers. wasip1 runtimes need not preopen "/" itself, so Go answers stat of
+// "/" or "/buf.yaml" with EBADF.
+func outsidePreopens(err error) bool {
+	return errors.Is(err, syscall.EBADF) || errors.Is(err, syscall.ENOTCAPABLE)
+}
