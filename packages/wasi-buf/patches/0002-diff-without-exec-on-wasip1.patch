+
+package diff
+
+import (
+	"bytes"
+	"fmt"
+
+	"github.com/bufbuild/buf/private/pkg/diff/diffmyers"
+)
+
+const unifiedContext = 3
+
+type unifiedLine struct {
+	kind byte
+	from int
+	to   int
+}
+
+// unifiedDiff prints the hunks of a GNU-style unified diff of from and to,
+// without the --- and +++ header lines.
+func unifiedDiff(from [][]byte, to [][]byte) []byte {
+	var lines []unifiedLine
+	i, j := 0, 0
+	for _, edit := range diffmyers.Diff(from, to) {
+		switch edit.Kind {
+		case diffmyers.EditKindDelete:
+			for i < edit.FromPosition {
+				lines = append(lines, unifiedLine{kind: ' ', from: i, to: j})
+				i++
+				j++
+			}
+			lines = append(lines, unifiedLine{kind: '-', from: i, to: j})
+			i++
+		case diffmyers.EditKindInsert:
+			for j < edit.ToPosition {
+				lines = append(lines, unifiedLine{kind: ' ', from: i, to: j})
+				i++
+				j++
+			}
+			lines = append(lines, unifiedLine{kind: '+', from: i, to: j})
+			j++
+		}
+	}
+	for i < len(from) {
+		lines = append(lines, unifiedLine{kind: ' ', from: i, to: j})
+		i++
+		j++
+	}
+	// Like GNU diff, a change block lists its deletions before its insertions.
+	for begin := 0; begin < len(lines); {
+		if lines[begin].kind == ' ' {
+			begin++
+			continue
+		}
+		end := begin
+		for end < len(lines) && lines[end].kind != ' ' {
+			end++
+		}
+		block := make([]unifiedLine, 0, end-begin)
+		for _, kind := range []byte{'-', '+'} {
+			for _, line := range lines[begin:end] {
+				if line.kind == kind {
+					block = append(block, line)
+				}
+			}
+		}
+		copy(lines[begin:end], block)
+		begin = end
+	}
+	var buffer bytes.Buffer
+	for start := 0; start < len(lines); {
+		first := start
+		for first < len(lines) && lines[first].kind == ' ' {
+			first++
+		}
+		if first == len(lines) {
+			break
+		}
+		last := first
+		for next := first; next < len(lines); next++ {
+			if lines[next].kind != ' ' {
+				if next-last-1 > 2*unifiedContext {
+					break
+				}
+				last = next
+			}
+		}
+		begin := max(first-unifiedContext, start)
+		end := min(last+unifiedContext+1, len(lines))
+		hunk := lines[begin:end]
+		var fromCount, toCount int
+		for _, line := range hunk {
+			if line.kind != '+' {
+				fromCount++
+			}
+			if line.kind != '-' {
+				toCount++
+			}
+		}
+		fmt.Fprintf(&buffer, "@@ -%s +%s @@\n", unifiedRange(hunk[0].from, fromCount), unifiedRange(hunk[0].to, toCount))
+		for _, line := range hunk {
+			text := to[min(line.to, len(to)-1)]
+			if line.kind != '+' {
+				text = from[line.from]
+			}
+			buffer.WriteByte(line.kind)
+			buffer.Write(text)
+			if !bytes.HasSuffix(text, []byte{'\n'}) {
+				buffer.WriteString("\n\\ No newline at end of file\n")
+			}
+		}
+		start = end
+	}
+	return buffer.Bytes()
+}
+
+func unifiedRange(start int, count int) string {
+	switch count {
+	case 0:
+		return fmt.Sprintf("%d,0", start)
+	case 1:
+		return fmt.Sprintf("%d", start+1)
+	default:
+		return fmt.Sprintf("%d,%d", start+1, count)
+	}
+}
