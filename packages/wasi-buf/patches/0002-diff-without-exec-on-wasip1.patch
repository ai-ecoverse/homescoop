+func myersDiff(
+	b1 []byte,
+	b2 []byte,
+	filename1 string,
+	filename2 string,
+	suppressCommands bool,
+) ([]byte, error) {
+	data := append([]byte("--- a\n+++ b\n"), unifiedDiff(splitLines(b1), splitLines(b2))...)
+	return tryModifyHeader(data, filename1, filename2, suppressCommands, true), nil
+}
+
+func splitLines(data []byte) [][]byte {
+	lines := bytes.SplitAfter(data, []byte{'\n'})
+	if len(lines) > 0 && len(lines[len(lines)-1]) == 0 {
+		lines = lines[:len(lines)-1]
+	}
+	return lines
+}
