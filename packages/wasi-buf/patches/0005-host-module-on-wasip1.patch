+
+//go:build wasip1
+
+package filelock
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/bufbuild/buf/private/pkg/slicchost"
+)
+
+func lock(ctx context.Context, filePath string, options ...LockOption) (Unlocker, error) {
+	return lockForFunc(ctx, filePath, true, options...)
+}
+
+func rlock(ctx context.Context, filePath string, options ...LockOption) (Unlocker, error) {
+	return lockForFunc(ctx, filePath, false, options...)
+}
+
+// lockForFunc takes an advisory lock through buf's host module, which uses
+// slicc-kernel's file locks; gofrs/flock has no implementation for wasip1.
+func lockForFunc(ctx context.Context, filePath string, exclusive bool, options ...LockOption) (Unlocker, error) {
+	lockOptions := newLockOptions()
+	for _, option := range options {
+		option(lockOptions)
+	}
+	if err := os.MkdirAll(filepath.Dir(filePath), 0755); err != nil {
+		return nil, err
+	}
+	var cancel context.CancelFunc
+	if lockOptions.timeout != 0 {
+		ctx, cancel = context.WithTimeout(ctx, lockOptions.timeout)
+		defer cancel()
+	}
+	file, err := os.OpenFile(filePath, os.O_CREATE|os.O_RDWR, 0644)
+	if err != nil {
+		return nil, fmt.Errorf("could not get file lock %q: %w", filePath, err)
+	}
+	for {
+		locked, err := slicchost.TryLock(file.Fd(), exclusive)
+		if err != nil {
+			_ = file.Close()
+			return nil, fmt.Errorf("could not get file lock %q: %w", filePath, err)
+		}
+		if locked {
+			return &hostUnlocker{file: file}, nil
+		}
+		select {
+		case <-ctx.Done():
+			_ = file.Close()
+			return nil, fmt.Errorf("could not lock %q: %w", filePath, ctx.Err())
+		case <-time.After(lockOptions.retryDelay):
+		}
+	}
+}
+
+type hostUnlocker struct {
+	file *os.File
+}
+
+func (u *hostUnlocker) Unlock() error {
+	err := slicchost.Unlock(u.file.Fd())
+	if closeErr := u.file.Close(); err == nil {
+		err = closeErr
+	}
+	return err
+}
+
+type lockOptions struct {
+	timeout    time.Duration
+	retryDelay time.Duration
+}
+
+func newLockOptions() *lockOptions {
+	return &lockOptions{
+		timeout:    DefaultLockTimeout,
+		retryDelay: DefaultLockRetryDelay,
+	}
+}
