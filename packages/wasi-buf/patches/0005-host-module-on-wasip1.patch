diff --git a/private/pkg/slicchost/slicchost_wasip1.go b/private/pkg/slicchost/slicchost_wasip1.go
new file mode 100644
index 0000000..3770fa9
--- /dev/null
+++ b/private/pkg/slicchost/slicchost_wasip1.go
@@ -0,0 +1,216 @@
+// Copyright 2020-2026 Buf Technologies, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//go:build wasip1
+
+package slicchost
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"unsafe"
+)
+
+const probeMagic = 0x62756631
+
+//go:wasmimport buf_host probe
+func hostProbe() uint32
+
+//go:wasmimport buf_host call
+func hostCall(request unsafe.Pointer, size uint32) uint32
+
+//go:wasmimport buf_host take
+func hostTake(response unsafe.Pointer)
+
+var available = sync.OnceValue(func() bool { return hostProbe() == probeMagic })
+
+func init() {
+	// http.Client{} without a Transport (buf's HTTP inputs) uses DefaultTransport.
+	http.DefaultTransport = Transport{}
+}
+
+type envelope struct {
+	OK    bool            `json:"ok"`
+	Error string          `json:"error"`
+	Value json.RawMessage `json:"value"`
+}
+
+func call(request any, value any) error {
+	if !available() {
+		return ErrUnsupported
+	}
+	data, err := json.Marshal(request)
+	if err != nil {
+		return err
+	}
+	size := hostCall(unsafe.Pointer(unsafe.SliceData(data)), uint32(len(data)))
+	response := make([]byte, size)
+	if size > 0 {
+		hostTake(unsafe.Pointer(unsafe.SliceData(response)))
+	}
+	var result envelope
+	if err := json.Unmarshal(response, &result); err != nil {
+		return err
+	}
+	if !result.OK {
+		return errors.New(result.Error)
+	}
+	if value == nil {
+		return nil
+	}
+	return json.Unmarshal(result.Value, value)
+}
+
+// LookPath reports name as runnable when the host can start a command by that name.
+func LookPath(name string) (string, error) {
+	var found string
+	if err := call(map[string]any{"op": "which", "name": name}, &found); err != nil {
+		return "", err
+	}
+	if found == "" {
+		return "", errors.New("executable file not found in $PATH")
+	}
+	return name, nil
+}
+
+// TryLock takes an advisory lock on fd without waiting; false means another holder has it.
+func TryLock(fd uintptr, exclusive bool) (bool, error) {
+	var locked bool
+	err := call(map[string]any{"op": "lock", "fd": fd, "exclusive": exclusive}, &locked)
+	return locked, err
+}
+
+// Unlock releases a lock that TryLock took.
+func Unlock(fd uintptr) error {
+	return call(map[string]any{"op": "unlock", "fd": fd}, nil)
+}
+
+// Run starts name with args and waits for it, like exec.Cmd.Run.
+func Run(ctx context.Context, name string, args []string, env []string, dir string, stdin io.Reader, stdout io.Writer, stderr io.Writer) error {
+	var input []byte
+	if stdin != nil {
+		data, err := io.ReadAll(stdin)
+		if err != nil {
+			return err
+		}
+		input = data
+	}
+	var result struct {
+		Status int    `json:"status"`
+		Stdout []byte `json:"stdout"`
+		Stderr []byte `json:"stderr"`
+	}
+	request := map[string]any{"op": "run", "argv": append([]string{name}, args...), "env": env, "dir": dir, "stdin": input}
+	if err := call(request, &result); err != nil {
+		return err
+	}
+	if stdout != nil {
+		if _, err := stdout.Write(result.Stdout); err != nil {
+			return err
+		}
+	}
+	if stderr != nil {
+		if _, err := stderr.Write(result.Stderr); err != nil {
+			return err
+		}
+	}
+	if result.Status != 0 {
+		return &ExitError{Code: result.Status}
+	}
+	return ctx.Err()
+}
+
+// Transport sends HTTP requests through the host.
+type Transport struct{}
+
+// RoundTrip implements http.RoundTripper.
+func (Transport) RoundTrip(request *http.Request) (*http.Response, error) {
+	var body []byte
+	if request.Body != nil {
+		data, err := io.ReadAll(request.Body)
+		_ = request.Body.Close()
+		if err != nil {
+			return nil, err
+		}
+		body = data
+	}
+	headers := [][2]string{}
+	for name, values := range request.Header {
+		for _, value := range values {
+			headers = append(headers, [2]string{name, value})
+		}
+	}
+	var head struct {
+		Handle  int         `json:"handle"`
+		Status  int         `json:"status"`
+		Headers [][2]string `json:"headers"`
+	}
+	if err := call(map[string]any{"op": "http", "method": request.Method, "url": request.URL.String(), "headers": headers, "body": body}, &head); err != nil {
+		return nil, err
+	}
+	response := &http.Response{
+		Status:        fmt.Sprintf("%d %s", head.Status, http.StatusText(head.Status)),
+		StatusCode:    head.Status,
+		Proto:         "HTTP/1.1",
+		ProtoMajor:    1,
+		ProtoMinor:    1,
+		Header:        http.Header{},
+		Body:          &responseBody{handle: head.Handle},
+		ContentLength: -1,
+		Request:       request,
+	}
+	for _, pair := range head.Headers {
+		response.Header.Add(pair[0], pair[1])
+	}
+	return response, nil
+}
+
+type responseBody struct {
+	handle  int
+	pending bytes.Buffer
+	done    bool
+	closed  bool
+}
+
+func (b *responseBody) Read(p []byte) (int, error) {
+	for b.pending.Len() == 0 {
+		if b.done {
+			return 0, io.EOF
+		}
+		var chunk []byte
+		if err := call(map[string]any{"op": "http.read", "handle": b.handle}, &chunk); err != nil {
+			return 0, err
+		}
+		if len(chunk) == 0 {
+			b.done = true
+			continue
+		}
+		b.pending.Write(chunk)
+	}
+	return b.pending.Read(p)
+}
+
+func (b *responseBody) Close() error {
+	if b.closed {
+		return nil
+	}
+	b.closed = true
+	return call(map[string]any{"op": "http.close", "handle": b.handle}, nil)
+}
