+
+// Package slicchost reaches the host functions that wasi-buf's host module
+// (host/buf-host.mjs) provides on slicc-kernel's per-command imports hook:
+// starting commands and sending HTTP requests. Where the module is missing,
+// as in SLICC's wasm realm, every call returns ErrUnsupported.
+package slicchost
+
+import (
+	"errors"
+	"fmt"
+)
+
+// ErrUnsupported is returned when the runtime does not provide buf's host module.
+var ErrUnsupported = errors.New("this runtime cannot start commands or open network connections for buf (it needs slicc-kernel with @ai-ecoverse/wasi-buf's host module)")
+
+// ExitError is a command that ran and exited with a non-zero status.
+type ExitError struct {
+	Code int
+}
+
+func (e *ExitError) Error() string {
+	return fmt.Sprintf("exit status %d", e.Code)
+}
+
+// ExitCode returns the command's exit status.
+func (e *ExitError) ExitCode() int {
+	return e.Code
+}
