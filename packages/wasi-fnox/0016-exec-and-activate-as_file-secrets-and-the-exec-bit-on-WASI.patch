From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Tue, 20 Oct 2026 16:00:00 +0200
Subject: [PATCH] exec and activate: as_file secrets and the exec bit on WASI

`fnox exec` refused the whole command on WASI as soon as the project had
an as_file secret, with seven's "the value would be in a program (use a
header rule)", even for a command that only needs a plain secret. seven
doesn't write secret values to files, so such a secret is now left unset
with a warning naming it (and taken out of the inherited environment), as hook-env leaves it out, and the command runs
(homescoop#945).

`fnox activate` took the first regular file named fnox on PATH. WASI's
std has no file modes, so it now asks the kernel (slicc_fs.path_access
with X_OK, slicc-kernel >= 1.63.0) and skips a fnox the user can't
execute (homescoop#1129).

diff --git a/src/commands/activate.rs b/src/commands/activate.rs
index fb5cc434..1d4ccf81 100644
--- a/src/commands/activate.rs
+++ b/src/commands/activate.rs
@@ -58,7 +58,7 @@ impl ActivateCommand {
                 path.split(':')
                     .filter(|dir| !dir.is_empty())
                     .map(|dir| std::path::Path::new(dir).join("fnox"))
-                    .find(|candidate| candidate.is_file())
+                    .find(|candidate| candidate.is_file() && wasi_executable(candidate))
             })
             .unwrap_or_else(|| std::path::PathBuf::from("/usr/bin/fnox"));
 
@@ -73,3 +73,33 @@ impl ActivateCommand {
         Ok(())
     }
 }
+
+/// Whether the kernel would let this process execute `path` (access(2) with
+/// X_OK through slicc-kernel's `slicc_fs.path_access`, >= 1.63.0): WASI's std
+/// has no file modes, and a non-executable `fnox` earlier on PATH must not be
+/// pinned into the hook (homescoop#1129). An error other than EACCES (a kernel
+/// without the import's checks) counts as executable, as before.
+#[cfg(target_os = "wasi")]
+#[allow(unsafe_code)]
+fn wasi_executable(path: &std::path::Path) -> bool {
+    use std::os::fd::AsRawFd;
+    use std::os::wasi::ffi::OsStrExt;
+
+    #[link(wasm_import_module = "slicc_fs")]
+    unsafe extern "C" {
+        fn path_access(dirfd: i32, path: *const u8, len: usize, amode: i32, flags: i32) -> i32;
+    }
+    const X_OK: i32 = 1;
+    const EACCES: i32 = 2;
+    let (Some(dir), Some(name)) = (path.parent(), path.file_name()) else {
+        return true;
+    };
+    let Ok(dir) = std::fs::File::open(dir) else {
+        return true;
+    };
+    let name = name.as_bytes();
+    // SAFETY: `dir` stays open and `name` alive for the call.
+    let errno = unsafe { path_access(dir.as_raw_fd(), name.as_ptr(), name.len(), X_OK, 0) };
+    errno != EACCES
+}
+
diff --git a/src/commands/exec.rs b/src/commands/exec.rs
index 5fff7394..18a1ebc3 100644
--- a/src/commands/exec.rs
+++ b/src/commands/exec.rs
@@ -132,7 +132,8 @@ impl ExecCommand {
         }
         crate::daemon::refresh(cli, &config, &self.refresh).await?;
 
-        let (plan, lease_files) =
+        #[cfg_attr(not(target_os = "wasi"), allow(unused_mut))]
+        let (mut plan, lease_files) =
             child_env::plan(cli, &config, &profile, EnvScope::Exec, Roots::Scope, "exec").await?;
 
         let sealed_names = crate::seven::sealed_secret_names(&config, &profile)?;
@@ -144,10 +145,17 @@ impl ExecCommand {
             .collect();
         #[cfg(target_os = "wasi")]
         {
-            if !plan.files.is_empty() {
-                return Err(FnoxError::Seven(
-                    fnox_core::sealed::REFUSED_IN_SEVEN.to_string(),
-                ));
+            // seven doesn't write secret values to files (a program could read
+            // them), so an as_file secret is left unset with a warning, as
+            // hook-env does, instead of refusing the whole command
+            // (homescoop#945).
+            // Removed from the child's environment too: a value fnox resolved
+            // can be in its own environment, which the child inherits.
+            for key in std::mem::take(&mut plan.files).into_keys() {
+                eprintln!(
+                    "fnox: warning: {key} is not set: it is an as_file secret, and seven doesn't write secret values to files"
+                );
+                plan.remove.push(key);
             }
             let literal: Vec<&str> = plan
                 .set
