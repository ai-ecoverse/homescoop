From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Sat, 7 Nov 2026 02:10:00 +0100
Subject: [PATCH 11/19] wasi: allow the lints that code compiled out on WASI triggers

---
 crates/fnox-core/src/lib.rs | 11 +++++++++++
 src/lib.rs                  | 11 +++++++++++
 2 files changed, 22 insertions(+)

diff --git a/crates/fnox-core/src/lib.rs b/crates/fnox-core/src/lib.rs
index 1d1bfe5..179bb07 100644
--- a/crates/fnox-core/src/lib.rs
+++ b/crates/fnox-core/src/lib.rs
@@ -8,6 +8,17 @@
 //! The `fnox` binary depends on this crate and adds CLI-shaped bits (commands, MCP
 //! server, TUI, shell integration, hook-env machinery) on top.
 
+#![cfg_attr(
+    target_os = "wasi",
+    allow(
+        dead_code,
+        unused_imports,
+        unused_variables,
+        unused_mut,
+        unreachable_code
+    )
+)]
+
 pub mod audit;
 pub mod auth_prompt;
 pub mod config;
diff --git a/src/lib.rs b/src/lib.rs
index 1d5b269..7c438d0 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1,3 +1,14 @@
+#![cfg_attr(
+    target_os = "wasi",
+    allow(
+        dead_code,
+        unused_imports,
+        unused_variables,
+        unused_mut,
+        unreachable_code
+    )
+)]
+
 // Library interface for fnox
 //
 // The provider library, config types, and secret resolver live in the `fnox-core`

