From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Mon, 12 Oct 2026 15:20:29 +0200
Subject: [PATCH 11/13] wasi: allow the lints that code compiled out on WASI
 leaves behind

Gating providers, leases and the local proxy on WASI leaves imports, helpers and early returns that only the native build uses. Both crates allow dead_code, unused_imports, unused_variables, unused_mut and unreachable_code on WASI only, so the WASI build is warning-free and native lints are unchanged.

diff --git a/crates/fnox-core/src/lib.rs b/crates/fnox-core/src/lib.rs
--- a/crates/fnox-core/src/lib.rs
+++ b/crates/fnox-core/src/lib.rs
@@ -7,6 +7,17 @@
 //!
 //! The `fnox` binary depends on this crate and adds CLI-shaped bits (commands, MCP
 //! server, TUI, shell integration, hook-env machinery) on top.
+
+#![cfg_attr(
+    target_os = "wasi",
+    allow(
+        dead_code,
+        unused_imports,
+        unused_variables,
+        unused_mut,
+        unreachable_code
+    )
+)]
 
 pub mod audit;
 pub mod auth_prompt;
diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1,3 +1,14 @@
+#![cfg_attr(
+    target_os = "wasi",
+    allow(
+        dead_code,
+        unused_imports,
+        unused_variables,
+        unused_mut,
+        unreachable_code
+    )
+)]
+
 // Library interface for fnox
 //
 // The provider library, config types, and secret resolver live in the `fnox-core`
