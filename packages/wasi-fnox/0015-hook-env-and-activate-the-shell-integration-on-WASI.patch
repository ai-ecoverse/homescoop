From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Sat, 7 Nov 2026 02:10:00 +0100
Subject: [PATCH 15/19] hook-env and activate: the shell integration on WASI

diff --git a/crates/fnox-core/src/temp_file_secrets.rs b/crates/fnox-core/src/temp_file_secrets.rs
index 75fd08e..dd5501f 100644
--- a/crates/fnox-core/src/temp_file_secrets.rs
+++ b/crates/fnox-core/src/temp_file_secrets.rs
@@ -62,6 +62,11 @@ pub fn create_ephemeral_secret_file(key: &str, value: &str) -> Result<NamedTempF
 /// The `prefix` is used to distinguish caller contexts (e.g., `\"fnox-\"`, `\"fnox-export-\"`,
 /// `\"fnox-hook-\"`). Returns the file path as a `String`.
 pub fn create_persistent_secret_file(prefix: &str, key: &str, value: &str) -> Result<String> {
+    // In seven a value in a file is in every program's reach, and std's
+    // temp_dir() and process::id() panic on WASI: refuse, as exec does.
+    #[cfg(target_os = "wasi")]
+    return Err(FnoxError::Seven(crate::sealed::REFUSED_IN_SEVEN.to_string()));
+
     // Create a unique filename in the system temp directory
     let temp_dir = env::temp_dir();
     let timestamp = SystemTime::now()
diff --git a/src/commands/activate.rs b/src/commands/activate.rs
index 7d1390a..a866a56 100644
--- a/src/commands/activate.rs
+++ b/src/commands/activate.rs
@@ -48,8 +48,19 @@ impl ActivateCommand {
             .or_else(|| std::env::current_exe().ok())
             .or_else(|| which::which("fnox").ok())
             .unwrap_or_else(|| std::path::PathBuf::from("fnox"));
+        // std has no current_exe() on WASI, and a bare `fnox` makes the
+        // shell's fnox() wrapper call itself until the shell's stack runs out:
+        // find fnox on PATH, as the which fallback above does.
         #[cfg(target_os = "wasi")]
-        let exe = std::path::PathBuf::from("fnox");
+        let exe = std::env::var("PATH")
+            .ok()
+            .and_then(|path| {
+                path.split(':')
+                    .filter(|dir| !dir.is_empty())
+                    .map(|dir| std::path::Path::new(dir).join("fnox"))
+                    .find(|candidate| candidate.is_file())
+            })
+            .unwrap_or_else(|| std::path::PathBuf::from("/usr/bin/fnox"));
 
         let opts = ActivateOptions {
             exe,
diff --git a/src/hook_env.rs b/src/hook_env.rs
index bc56d41..4a20540 100644
--- a/src/hook_env.rs
+++ b/src/hook_env.rs
@@ -85,6 +85,12 @@ impl HookEnvSession {
 
         // Generate a random key for this session's hashes
         use blake3::Hasher;
+        // std's process::id panics on WASI ("no pids on this platform"); the
+        // kernel knows the pid.
+        #[cfg(not(target_os = "wasi"))]
+        let pid = std::process::id();
+        #[cfg(target_os = "wasi")]
+        let pid = wasix_command::process::id();
         let hash_key = *Hasher::new()
             .update(b"fnox-session-")
             .update(
@@ -94,7 +100,7 @@ impl HookEnvSession {
                     .as_nanos()
                     .to_le_bytes(),
             )
-            .update(&std::process::id().to_le_bytes())
+            .update(&pid.to_le_bytes())
             .finalize()
             .as_bytes();
 
