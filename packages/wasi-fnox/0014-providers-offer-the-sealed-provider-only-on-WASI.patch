From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Mon, 12 Oct 2026 15:48:08 +0200
Subject: [PATCH 14/14] providers: offer the sealed provider only on WASI

The sealed provider only works inside seven's kernel, where /dev/sealed
exists. Native builds still parse `type = "sealed"` and fail cleanly when
it is used, but `fnox provider add` no longer lists it among the provider
types, and the setup wizard no longer offers it.

diff --git a/crates/fnox-core/build/generate_providers.rs b/crates/fnox-core/build/generate_providers.rs
index ed48ac3..834c8fb 100644
--- a/crates/fnox-core/build/generate_providers.rs
+++ b/crates/fnox-core/build/generate_providers.rs
@@ -719,6 +719,12 @@ fn wasi_enabled(module: &str) -> bool {
     matches!(module, "age" | "plain" | "sealed")
 }
 
+/// Whether the provider is offered by the setup wizard. The `sealed` provider
+/// only works inside seven's kernel, so native builds do not offer it.
+fn wizard_listed(module: &str) -> bool {
+    module != "sealed" || std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("wasi")
+}
+
 fn generate_provider_instantiate(
     providers: &[(String, ProviderToml)],
 ) -> Result<String, Box<dyn std::error::Error>> {
@@ -887,7 +893,7 @@ fn generate_provider_wizard(
 ) -> Result<String, Box<dyn std::error::Error>> {
     let mut wizard_info_entries = Vec::new();
 
-    for (_name, provider) in providers {
+    for (_name, provider) in providers.iter().filter(|(_, p)| wizard_listed(&p.module)) {
         let provider_type = &provider.serde_rename;
         let display_name = &provider.display_name;
         let description = &provider.description;
diff --git a/src/commands/provider/add.rs b/src/commands/provider/add.rs
index 7b7456a..6ae09f6 100644
--- a/src/commands/provider/add.rs
+++ b/src/commands/provider/add.rs
@@ -312,6 +312,7 @@ impl AddCommand {
                 auth_command: None,
                 daemon_cache: None,
             },
+            #[cfg(target_os = "wasi")]
             ProviderType::Sealed => crate::config::ProviderConfig::Sealed {
                 auth_command: None,
                 daemon_cache: None,
diff --git a/src/commands/provider/mod.rs b/src/commands/provider/mod.rs
index f86395b..7517751 100644
--- a/src/commands/provider/mod.rs
+++ b/src/commands/provider/mod.rs
@@ -101,7 +101,9 @@ pub enum ProviderType {
     /// Plain text provider
     #[usage(name = "plain")]
     Plain,
+    // Only offered on WASI: the store exists only inside seven's kernel.
     /// Seven's sealed store (slicc-kernel /dev/sealed)
+    #[cfg(target_os = "wasi")]
     #[usage(name = "sealed")]
     Sealed,
     /// Proton Pass
@@ -180,6 +182,8 @@ mod tests {
             })
             // fido2 is excluded from musl builds — mirror build/generate_providers.rs.
             .filter(|name| !(cfg!(target_env = "musl") && name == "fido2"))
+            // sealed is only offered on WASI, where seven's kernel provides it.
+            .filter(|name| cfg!(target_os = "wasi") || name != "sealed")
             .map(|provider_type| normalize_provider_type_for_add(&provider_type))
             .collect();
 
