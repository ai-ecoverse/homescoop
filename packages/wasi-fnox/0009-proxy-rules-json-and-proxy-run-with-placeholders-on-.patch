index 0000000..d34ad8e
--- /dev/null
+++ b/src/proxy/wasi.rs
@@ -0,0 +1,236 @@
+use super::*;
+use globset::{GlobBuilder, GlobSet, GlobSetBuilder};
+use ipnet::IpNet;
+use std::net::IpAddr;
+
+const MCP_RELAY_ENV: &str = "FNOX_PROXY_MCP";
+const MCP_RELAY_PROFILE_ENV: &str = "FNOX_PROXY_MCP_PROFILE";
+
+pub fn target_label(rule: &ProxyRule) -> String {
+    match &rule.query {
+        Some(name) => format!("query={name}"),
+        None => format!(
+            "header={}",
+            rule.header
+                .as_deref()
+                .unwrap_or(DEFAULT_HEADER)
+                .to_ascii_lowercase()
+        ),
+    }
+}
+
+pub fn validate_config(config: &ProxyConfig) -> Result<()> {
+    if config.rules.is_empty() {
+        return Err(proxy_error("no rules are configured"));
+    }
+    for rule in &config.rules {
+        validate_rule(rule)?;
+    }
+    for domain in &config.allow_domains {
+        if !is_valid_domain_pattern(domain) {
+            return Err(proxy_error(format!(
+                "allow_domains entry '{domain}' is not a valid domain"
+            )));
+        }
+    }
+    for entry in &config.allow_private {
+        parse_allowed(entry)?;
+    }
+    Ok(())
+}
+
+fn is_valid_domain_pattern(domain: &str) -> bool {
+    if domain.trim().is_empty()
+        || domain.contains('/')
+        || domain.contains(':')
+        || domain.ends_with('.')
+        || domain.chars().any(char::is_whitespace)
+    {
+        return false;
+    }
+    let host = domain.strip_prefix("*.").unwrap_or(domain);
+    let wildcard = host.len() != domain.len();
+    !(host.contains('*')
+        || host.starts_with('.')
+        || host.contains("..")
+        || (wildcard && !host.contains('.')))
+}
+
+fn validate_rule(rule: &ProxyRule) -> Result<()> {
+    match (&rule.secret, &rule.lease) {
+        (Some(_), Some(_)) => {
+            return Err(proxy_error(format!(
+                "rule for '{}' sets both secret and lease; choose one",
+                rule.name()
+            )));
+        }
+        (None, None) => {
+            return Err(proxy_error(format!(
+                "rule for domain '{}' needs a secret or a lease",
+                rule.domain
+            )));
+        }
+        (Some(secret), None) if secret.trim().is_empty() => {
+            return Err(proxy_error("rule secret cannot be empty"));
+        }
+        (None, Some(lease)) if lease.trim().is_empty() => {
+            return Err(proxy_error("rule lease cannot be empty"));
+        }
+        (Some(secret), None) if rule.credential.is_some() => {
+            return Err(proxy_error(format!(
+                "rule for '{secret}' sets credential, which only a lease rule can use"
+            )));
+        }
+        (None, Some(lease))
+            if rule
+                .credential
+                .as_deref()
+                .is_some_and(|c| c.trim().is_empty()) =>
+        {
+            return Err(proxy_error(format!(
+                "rule for lease '{lease}' has an empty credential"
+            )));
+        }
+        (None, Some(_)) => {
+            return Err(proxy_error(format!(
+                "rule for lease '{}' is not available in seven",
+                rule.name()
+            )));
+        }
+        _ => {}
+    }
+    if let Some(env_name) = rule
+        .env
+        .as_deref()
+        .or(rule.secret.as_deref())
+        .or(rule.credential.as_deref())
+    {
+        if [MCP_RELAY_ENV, MCP_RELAY_PROFILE_ENV].contains(&env_name) {
+            return Err(proxy_error(format!(
+                "rule for '{}' can't use the environment variable '{env_name}', which fnox reserves",
+                rule.name()
+            )));
+        }
+    }
+    if !is_valid_domain_pattern(&rule.domain) {
+        return Err(proxy_error(format!(
+            "rule for '{}' has an invalid domain '{}'",
+            rule.name(),
+            rule.domain
+        )));
+    }
+    if rule.header.is_some() && rule.query.is_some() {
+        return Err(proxy_error(format!(
+            "rule for '{}' sets both header and query; choose one",
+            rule.name()
+        )));
+    }
+    if let Some(header) = &rule.header
+        && (header.trim().is_empty()
+            || !header
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-'))
+    {
+        return Err(proxy_error(format!(
+            "rule for '{}' has an invalid header name",
+            rule.name()
+        )));
+    }
+    if let Some(query) = &rule.query
+        && query.is_empty()
+    {
+        return Err(proxy_error(format!(
+            "rule for '{}' has an empty query parameter name",
+            rule.name()
+        )));
+    }
+    for method in &rule.methods {
+        let valid = !method.is_empty()
+            && method
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || b"!#$%&'*+-.^_`|~".contains(&byte));
+        if !valid {
+            return Err(proxy_error(format!(
+                "rule for '{}' has an invalid HTTP method '{method}'",
+                rule.name()
+            )));
+        }
+    }
+    compile_paths(&rule.paths)?;
+    Ok(())
+}
+
+fn compile_paths(paths: &[String]) -> Result<Option<GlobSet>> {
+    if paths.is_empty() {
+        return Ok(None);
+    }
+    let mut builder = GlobSetBuilder::new();
+    for path in paths {
+        if !path.starts_with('/') {
+            return Err(proxy_error(format!(
+                "path pattern '{path}' must start with '/'"
+            )));
+        }
+        builder.add(
+            GlobBuilder::new(path)
+                .literal_separator(true)
+                .build()
+                .map_err(|error| proxy_error(format!("invalid path pattern '{path}': {error}")))?,
+        );
+    }
+    Ok(Some(builder.build().map_err(|error| {
+        proxy_error(format!("invalid path patterns: {error}"))
+    })?))
+}
+
+fn parse_allowed(entry: &str) -> Result<()> {
+    let invalid = || {
+        proxy_error(format!(
+            "allow_private entry '{entry}' is not an IP address or CIDR block, optionally with a port"
+        ))
+    };
+    let (network, port) = if let Some(bracketed) = entry.strip_prefix('[') {
+        let (network, rest) = bracketed.split_once(']').ok_or_else(invalid)?;
+        match rest {
+            "" => (network, None),
+            _ => (network, Some(rest.strip_prefix(':').ok_or_else(invalid)?)),
+        }
+    } else if entry.matches(':').count() == 1 {
+        let (network, port) = entry.split_once(':').ok_or_else(invalid)?;
+        (network, Some(port))
+    } else {
+        (entry, None)
+    };
+    if let Some(port) = port {
+        port.parse::<u16>()
+            .ok()
+            .filter(|port| *port != 0)
+            .ok_or_else(invalid)?;
+    }
+    parse_network(network).map_err(|_| invalid())?;
+    Ok(())
+}
+
+fn parse_network(entry: &str) -> Result<IpNet> {
+    entry
+        .parse::<IpNet>()
+        .or_else(|_| entry.parse::<IpAddr>().map(IpNet::from))
+        .map(|network| canonical_network(network.trunc()))
+        .map_err(|_| {
+            proxy_error(format!(
+                "allow_private entry '{entry}' is not an IP address or CIDR block"
+            ))
+        })
+}
+
+fn canonical_network(network: IpNet) -> IpNet {
+    if let IpNet::V6(v6) = network
+        && v6.prefix_len() >= 96
+        && let Some(v4) = v6.addr().to_ipv4_mapped()
+    {
+        return IpNet::V4(
+            ipnet::Ipv4Net::new(v4, v6.prefix_len() - 96).expect("a prefix of 32 or less is valid"),
+        );
+    }
+    network
+}
