From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Sat, 7 Nov 2026 02:10:00 +0100
Subject: [PATCH 17/19] plain: read the secrets file in place on WASI

---
 crates/fnox-core/src/providers/plain.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/crates/fnox-core/src/providers/plain.rs b/crates/fnox-core/src/providers/plain.rs
index 04f8ecc..44d0e29 100644
--- a/crates/fnox-core/src/providers/plain.rs
+++ b/crates/fnox-core/src/providers/plain.rs
@@ -77,7 +77,13 @@ impl SecretFile {
     async fn secrets(&self) -> Result<&HashMap<String, String>> {
         self.secrets
             .get_or_init(|| async {
-                let input = tokio::fs::read_to_string(&self.path).await.map_err(|e| {
+                // tokio::fs reads on a blocking-pool thread, which WASI
+                // can't spawn (the read panicked, rc 134): read in place.
+                #[cfg(target_os = "wasi")]
+                let read = std::fs::read_to_string(&self.path);
+                #[cfg(not(target_os = "wasi"))]
+                let read = tokio::fs::read_to_string(&self.path).await;
+                let input = read.map_err(|e| {
                     FnoxError::Provider(format!(
                         "plain provider: failed to read '{}': {e}",
                         self.path.display()

