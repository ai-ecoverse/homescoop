         set_transport(None);
     }
 
+    #[test]
+    fn materialize_shell_grants_sends_no_names() {
+        let (_g, mock) = install();
+        mock.reply(
+            json!({ "v": 1, "ticket": "t2", "expiresAt": 1, "real": { "OPENAI_API_KEY": true } }),
+        );
+        let argv = vec![
+            "/bin/bash".to_string(),
+            "-c".to_string(),
+            "make".to_string(),
+        ];
+        let ticket = materialize_shell_grants("/bin/bash", &argv, "/home/demo").unwrap();
+        assert_eq!(ticket.real.get("OPENAI_API_KEY"), Some(&true));
+        let sent = mock.requests.lock().unwrap()[0].clone();
+        assert_eq!(
+            sent,
+            json!({ "v": 1, "op": "materialize", "shellGrants": true, "path": "/bin/bash", "argv": ["/bin/bash", "-c", "make"], "cwd": "/home/demo" })
+        );
+        set_transport(None);
+    }
