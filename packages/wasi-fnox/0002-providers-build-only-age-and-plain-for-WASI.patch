+/// The variable names `env_dependencies()` returns in
+/// `src/providers/<module>.rs` (or `<module>/mod.rs`), for a provider whose
+/// module is compiled out on WASI. The build fails if the function is not a
+/// literal list of string literals, so an upstream change can't silently
+/// empty it.
+fn disabled_env_dependencies(module: &str) -> Vec<String> {
+    let file = format!("src/providers/{module}.rs");
+    let path = if std::path::Path::new(&file).exists() {
+        file
+    } else {
+        format!("src/providers/{module}/mod.rs")
+    };
+    println!("cargo:rerun-if-changed={path}");
+    let src = fs::read_to_string(&path).unwrap_or_else(|e| panic!("{path}: {e}"));
+    let sig = "pub fn env_dependencies() -> &'static [&'static str] {";
+    let (_, rest) = src
+        .split_once(sig)
+        .unwrap_or_else(|| panic!("{path}: no `{sig}`"));
+    let (body, _) = rest
+        .split_once("\n}")
+        .unwrap_or_else(|| panic!("{path}: env_dependencies() has no end"));
+    let body = const_list(&path, &src, body.trim());
+    let list = body
+        .strip_prefix("&[")
+        .and_then(|l| l.strip_suffix(']'))
+        .unwrap_or_else(|| panic!("{path}: env_dependencies() is not a literal list: {body}"));
+    list.split(',')
+        .map(str::trim)
+        .filter(|item| !item.is_empty())
+        .map(|item| {
+            item.strip_prefix('"')
+                .and_then(|i| i.strip_suffix('"'))
+                .filter(|i| !i.contains(['"', '\\']))
+                .unwrap_or_else(|| {
+                    panic!("{path}: env_dependencies() entry {item} is not a plain string")
+                })
+                .to_string()
+        })
+        .collect()
+}
+
+/// `body` itself, or, when it names a constant (`SERVICE_PRINCIPAL_ENV_VARS`),
+/// that constant's value from the module's source or another provider module.
+fn const_list(path: &str, src: &str, body: &str) -> String {
+    if !body.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+        return body.to_string();
+    }
+    let decl = format!("const {body}: &[&str] =");
+    let mut sources = vec![(path.to_string(), src.to_string())];
+    let mut others: Vec<_> = fs::read_dir("src/providers")
+        .unwrap_or_else(|e| panic!("src/providers: {e}"))
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|other| other.extension().is_some_and(|ext| ext == "rs"))
+        .collect();
+    others.sort();
+    for other in others {
+        let other = other.to_string_lossy().into_owned();
+        let text = fs::read_to_string(&other).unwrap_or_else(|e| panic!("{other}: {e}"));
+        sources.push((other, text));
+    }
+    for (file, text) in sources {
+        if let Some((_, rest)) = text.split_once(&decl) {
+            println!("cargo:rerun-if-changed={file}");
+            let (value, _) = rest
+                .split_once(';')
+                .unwrap_or_else(|| panic!("{file}: {body} has no end"));
+            return value.trim().to_string();
+        }
+    }
+    panic!("{path}: env_dependencies() names {body}, which no provider module defines")
+}
+
+fn wasi_enabled(module: &str) -> bool {
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("wasi") {
+        return true;
+    }
+    matches!(module, "age" | "plain")
+}
