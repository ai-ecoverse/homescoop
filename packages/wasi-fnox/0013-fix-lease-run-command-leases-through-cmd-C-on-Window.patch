From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Mon, 12 Oct 2026 15:20:27 +0200
Subject: [PATCH 13/14] fix(lease): run command leases through cmd /C on
 Windows

The `command` lease backend always ran `sh -c`, so it failed on Windows
unless a POSIX shell was on PATH. It now uses the same platform shell as
`credential_command`: `sh -c` on Unix and `cmd /C` on Windows.

On Windows the command line now reaches `cmd` as written (`cmd /S /C "..."`
with the raw command), so quoted paths and arguments work. Ordinary argument
quoting escaped inner quotes with backslashes, which `cmd` does not
understand; this also fixes quoted `credential_command` values.

diff --git a/crates/fnox-core/src/credential_command.rs b/crates/fnox-core/src/credential_command.rs
index 4f9e1ec..882f803 100644
--- a/crates/fnox-core/src/credential_command.rs
+++ b/crates/fnox-core/src/credential_command.rs
@@ -147,15 +147,23 @@ fn cache_key(provider: &str, command: &str, envs: &[(&str, String)]) -> String {
     hasher.finalize().to_hex().to_string()
 }
 
-fn shell_command(command: &str) -> Command {
-    // `cfg!` selects the shell for the target binary at compile time, which
-    // matches fnox's native build/release flow. Cross-compiled artifacts should
-    // be built per target so Windows binaries use cmd and Unix binaries use sh.
-    if cfg!(target_os = "windows") {
+/// A command that runs `command` through the platform shell: `sh -c` on Unix
+/// and `cmd /C` on Windows.
+///
+/// On Windows the command line is handed to `cmd` as written. `/S` makes `cmd`
+/// strip exactly the outer quotes added here, so quoted paths and arguments in
+/// `command` reach it unchanged rather than with the backslash escapes that
+/// ordinary argument quoting would add, which `cmd` does not understand.
+pub(crate) fn shell_command(command: &str) -> Command {
+    #[cfg(windows)]
+    {
         let mut cmd = Command::new("cmd");
-        cmd.args(["/C", command]);
+        cmd.args(["/S", "/C"]);
+        cmd.raw_arg(format!("\"{command}\""));
         cmd
-    } else {
+    }
+    #[cfg(not(windows))]
+    {
         let mut cmd = Command::new("sh");
         cmd.args(["-c", command]);
         cmd
@@ -167,6 +175,23 @@ mod tests {
     use super::*;
     use serde_json::json;
 
+    #[cfg(windows)]
+    #[tokio::test]
+    async fn credential_command_passes_quotes_to_cmd_unchanged() {
+        let token = run(
+            "TestQuotes",
+            r#"echo "quoted token""#,
+            json!({}),
+            &[],
+            DEFAULT_TIMEOUT,
+            "https://example.com",
+        )
+        .await
+        .unwrap();
+
+        assert_eq!(token, r#""quoted token""#);
+    }
+
     #[cfg(unix)]
     #[tokio::test]
     async fn credential_command_output_is_cached() {
diff --git a/crates/fnox-core/src/lease_backends/command.rs b/crates/fnox-core/src/lease_backends/command.rs
index 9cc671e..53208e1 100644
--- a/crates/fnox-core/src/lease_backends/command.rs
+++ b/crates/fnox-core/src/lease_backends/command.rs
@@ -3,8 +3,6 @@ use crate::lease_backends::{Lease, LeaseBackend};
 use async_trait::async_trait;
 use indexmap::IndexMap;
 use std::time::Duration;
-#[cfg(not(target_os = "wasi"))]
-use tokio::process::Command;
 
 const URL: &str = "https://fnox.jdx.dev/leases/command";
 
@@ -45,8 +43,7 @@ impl CommandBackend {
         envs: &[(&str, String)],
         action: &str,
     ) -> Result<std::process::Output> {
-        let mut cmd = Command::new("sh");
-        cmd.arg("-c").arg(cmd_str);
+        let mut cmd = crate::credential_command::shell_command(cmd_str);
         for (k, v) in envs {
             cmd.env(k, v);
         }
@@ -192,3 +189,50 @@ impl LeaseBackend for CommandBackend {
         Duration::from_secs(24 * 3600)
     }
 }
+
+#[cfg(all(test, not(target_os = "wasi")))]
+mod tests {
+    use super::*;
+
+    // Each command only works under the platform's own shell: `printf` with a
+    // POSIX `$VAR` on Unix, and `echo` with a `%VAR%` expansion under `cmd`.
+    #[cfg(unix)]
+    const CREATE_COMMAND: &str = r#"printf '{"credentials":{"LABEL":"%s","DURATION":"%s"}}' "$FNOX_LEASE_LABEL" "$FNOX_LEASE_DURATION""#;
+    #[cfg(windows)]
+    const CREATE_COMMAND: &str =
+        r#"echo {"credentials":{"LABEL":"%FNOX_LEASE_LABEL%","DURATION":"%FNOX_LEASE_DURATION%"}}"#;
+
+    #[tokio::test]
+    async fn create_command_runs_through_the_platform_shell() {
+        let backend =
+            CommandBackend::new(CREATE_COMMAND.to_string(), None, Duration::from_secs(30));
+
+        let lease = backend
+            .create_lease(Duration::from_secs(300), "fnox-test")
+            .await
+            .unwrap();
+
+        assert_eq!(lease.credentials["LABEL"], "fnox-test");
+        assert_eq!(lease.credentials["DURATION"], "300");
+        assert!(lease.lease_id.starts_with("cmd"));
+    }
+
+    #[tokio::test]
+    async fn revoke_command_runs_through_the_platform_shell() {
+        let tempdir = tempfile::tempdir().unwrap();
+        let revoked = tempdir.path().join("revoked");
+        #[cfg(unix)]
+        let command = format!(r#"printf '%s' "$FNOX_LEASE_ID" > '{}'"#, revoked.display());
+        #[cfg(windows)]
+        let command = format!(r#"echo %FNOX_LEASE_ID%> "{}""#, revoked.display());
+        let backend =
+            CommandBackend::new("exit 1".to_string(), Some(command), Duration::from_secs(30));
+
+        backend.revoke_lease("cmd-lease-1", None).await.unwrap();
+
+        assert_eq!(
+            std::fs::read_to_string(&revoked).unwrap().trim(),
+            "cmd-lease-1"
+        );
+    }
+}
