From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Sat, 7 Nov 2026 02:10:00 +0100
Subject: [PATCH 4/19] wasi: take the working directory and home from the environment
 environment

---
 crates/fnox-core/src/env.rs | 14 ++++++++++----
 src/main.rs                 |  7 ++++++-
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/crates/fnox-core/src/env.rs b/crates/fnox-core/src/env.rs
index 3c004d2..2df64f9 100644
--- a/crates/fnox-core/src/env.rs
+++ b/crates/fnox-core/src/env.rs
@@ -40,12 +40,18 @@ pub fn remove_var<K: AsRef<OsStr>>(key: K) {
 }
 
 // Directory configuration
-pub static HOME_DIR: LazyLock<PathBuf> = LazyLock::new(|| dirs::home_dir().unwrap_or_default());
+pub static HOME_DIR: LazyLock<PathBuf> = LazyLock::new(|| {
+    #[cfg(target_os = "wasi")]
+    if let Some(home) = std::env::var_os("HOME").filter(|h| !h.is_empty()) {
+        return PathBuf::from(home);
+    }
+    dirs::home_dir().unwrap_or_default()
+});
 pub static FNOX_CONFIG_DIR: LazyLock<PathBuf> = LazyLock::new(|| {
     var_path("FNOX_CONFIG_DIR").unwrap_or_else(|| {
         var_path("XDG_CONFIG_HOME")
             .unwrap_or_else(|| {
-                #[cfg(unix)]
+                #[cfg(any(unix, target_os = "wasi"))]
                 return HOME_DIR.join(".config");
                 #[cfg(windows)]
                 return HOME_DIR.join("AppData").join("Local");
@@ -58,7 +64,7 @@ pub static FNOX_STATE_DIR: LazyLock<PathBuf> = LazyLock::new(|| {
     var_path("FNOX_STATE_DIR").unwrap_or_else(|| {
         var_path("XDG_STATE_HOME")
             .unwrap_or_else(|| {
-                #[cfg(unix)]
+                #[cfg(any(unix, target_os = "wasi"))]
                 return HOME_DIR.join(".local").join("state");
                 #[cfg(windows)]
                 return HOME_DIR.join("AppData").join("Local");
@@ -71,7 +77,7 @@ pub static FNOX_DATA_DIR: LazyLock<PathBuf> = LazyLock::new(|| {
     var_path("FNOX_DATA_DIR").unwrap_or_else(|| {
         var_path("XDG_DATA_HOME")
             .unwrap_or_else(|| {
-                #[cfg(unix)]
+                #[cfg(any(unix, target_os = "wasi"))]
                 return HOME_DIR.join(".local").join("share");
                 #[cfg(windows)]
                 return HOME_DIR.join("AppData").join("Local");
diff --git a/src/main.rs b/src/main.rs
index fbc65cb..a973b03 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -3,6 +3,10 @@ use fnox::settings;
 use tracing_subscriber::{layer::SubscriberExt, util::SubscriberInitExt};
 
 fn main() -> miette::Result<()> {
+    #[cfg(target_os = "wasi")]
+    if let Some(pwd) = std::env::var_os("PWD") {
+        let _ = std::env::set_current_dir(pwd);
+    }
     let argv: Vec<std::ffi::OsString> = std::env::args_os().skip(1).collect();
     if fnox::hook_env::can_exit_before_startup(&argv) {
         return Ok(());
@@ -10,7 +14,8 @@ fn main() -> miette::Result<()> {
     run(argv)
 }
 
