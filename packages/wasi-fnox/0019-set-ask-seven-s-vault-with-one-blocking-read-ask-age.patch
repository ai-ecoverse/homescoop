+pub const MAX_PROMPT: usize = 200;
+
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Ask<'a> {
+    pub name: &'a str,
+    pub prompt: Option<&'a str>,
+    pub reveal: bool,
+    pub replace: bool,
+}
+
+#[derive(Clone, Deserialize, PartialEq, Eq)]
+pub struct Answer {
+    pub state: String,
+    #[serde(default)]
+    pub placeholder: Option<String>,
+    #[serde(default)]
+    pub record: Option<String>,
+    #[serde(default)]
+    pub value: Option<String>,
+}
+
+impl std::fmt::Debug for Answer {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Answer")
+            .field("state", &self.state)
+            .field("placeholder", &self.placeholder)
+            .field("record", &self.record)
+            .field("value", &self.value.as_ref().map(|_| "<redacted>"))
+            .finish()
+    }
+}
+
+impl Drop for Answer {
+    fn drop(&mut self) {
+        if let Some(value) = self.value.take() {
+            let mut bytes = value.into_bytes();
+            wipe(&mut bytes);
+        }
+    }
+}
+
+#[derive(Debug)]
+pub enum Asked {
+    Answered(Answer),
+    Interrupted,
+}
+
+pub fn clip_prompt(prompt: &str) -> String {
+    let mut units = 0;
+    prompt
+        .chars()
+        .take_while(|c| {
+            units += c.len_utf16();
+            units <= MAX_PROMPT
+        })
+        .collect()
+}
+
+pub fn ask(ask: &Ask, stop: &dyn Fn() -> bool) -> Result<Asked> {
+    let mut fields = json!({
+        "name": ask.name,
+        "reveal": ask.reveal,
+        "replace": ask.replace,
+    });
+    if let Some(prompt) = ask.prompt.map(clip_prompt).filter(|p| !p.is_empty()) {
+        fields["prompt"] = json!(prompt);
+    }
+    let bytes = encode("ask", fields)?;
+    let reply = match transport().wait(&bytes, stop) {
+        Err(e) if e.kind() == io::ErrorKind::Interrupted => return Ok(Asked::Interrupted),
+        reply => reply,
+    };
+    Ok(Asked::Answered(parse("ask", decode("ask", reply)?)?))
+}
