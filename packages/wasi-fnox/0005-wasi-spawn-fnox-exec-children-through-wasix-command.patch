From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lars Trieloff <lars@trieloff.net>
Date: Sat, 7 Nov 2026 02:10:00 +0100
Subject: [PATCH 5/19] wasi: spawn fnox exec children through wasix-command

diff --git a/Cargo.lock b/Cargo.lock
index 922baa6..af9f450 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2491,6 +2491,7 @@ dependencies = [
  "tracing-subscriber",
  "url",
  "usage-rs",
+ "wasix-command",
  "which",
 ]
 
@@ -8211,6 +8212,14 @@ dependencies = [
  "wit-bindgen",
 ]
 
+[[package]]
+name = "wasix-command"
+version = "0.1.0"
+dependencies = [
+ "libc",
+ "tokio",
+]
+
 [[package]]
 name = "wasm-bindgen"
 version = "0.2.129"
diff --git a/Cargo.toml b/Cargo.toml
index 3e07ab2..5abfa01 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -192,6 +192,7 @@ which = { workspace = true }
 tokio = { workspace = true, features = ["full"] }
 
 [target.'cfg(target_os = "wasi")'.dependencies]
+wasix-command = { path = "crates/wasix-command" }
 tokio = { workspace = true, features = ["rt", "macros", "sync", "time", "io-util", "fs", "io-std"] }
 
 [dev-dependencies]
diff --git a/src/commands/exec.rs b/src/commands/exec.rs
index 7637b23..1d4fc5a 100644
--- a/src/commands/exec.rs
+++ b/src/commands/exec.rs
@@ -5,7 +5,10 @@ use crate::secret_filter::SecretFilter;
 use crate::temp_file_secrets::create_ephemeral_secret_file;
 use crate::{commands::Cli, config::Config};
 use std::io::IsTerminal;
+#[cfg(not(target_os = "wasi"))]
 use std::process::{Command, Stdio};
+#[cfg(target_os = "wasi")]
+use wasix_command::{Command, Stdio};
 use tempfile::NamedTempFile;
 
 /// Run a command with secrets in its environment
@@ -135,6 +138,10 @@ impl ExecCommand {
         let filter = SecretFilter::new(&self.only, &self.except)?;
 
         let redact_on = self.redact || (!self.no_redact && config.should_redact_exec());
+        #[cfg(target_os = "wasi")]
+        if redact_on {
+            return Err(FnoxError::Config("exec output redaction is not available in seven".into()));
+        }
 
         #[cfg(unix)]
         if self.replace {
