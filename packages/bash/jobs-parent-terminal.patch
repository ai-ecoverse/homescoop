 static int sigchld;
 static int queue_sigchld;
 
+#if defined (__EMSCRIPTEN__)
+/* slicc (homescoop wasm-bash): terminal signals that reach the shell while
+   it forks a new foreground job, before the job has the terminal. */
+/* Global: the slicc exec shim (shims/slicc/slicc_exec.c) checks it too. */
+volatile sig_atomic_t slicc_fork_tty_sig;
+static void
+slicc_record_tty_sig (int sig)
+{
+  slicc_fork_tty_sig = sig;
+}
+static const int slicc_tty_sigs[3] = { SIGINT, SIGQUIT, SIGTSTP };
+
+/* From the moment the shell has read a command until it reads the next one,
+   record a SIGTSTP (an interactive shell ignores it) so that make_child can
+   pass a ^Z typed before the job was forked on to the job. eval.c calls
+   these around execute_command. */
+static struct sigaction slicc_tstp_old;
+static int slicc_tstp_on;
+
+void
+slicc_tty_sig_begin (void)
+{
+  struct sigaction act, cur;
+
+  slicc_fork_tty_sig = 0;
+  if (slicc_tstp_on || job_control == 0)
+    return;
+  if (sigaction (SIGTSTP, NULL, &cur) == 0 && (cur.sa_flags & SA_SIGINFO) == 0 && cur.sa_handler == SIG_IGN)
+    {
+      memset (&act, 0, sizeof (act));
+      act.sa_handler = slicc_record_tty_sig;
+      sigemptyset (&act.sa_mask);
+      sigaction (SIGTSTP, &act, &slicc_tstp_old);
+      slicc_tstp_on = 1;
+    }
+}
+
+void
+slicc_tty_sig_end (void)
+{
+  if (slicc_tstp_on)
+    {
+      sigaction (SIGTSTP, &slicc_tstp_old, NULL);
+      slicc_tstp_on = 0;
+    }
+  slicc_fork_tty_sig = 0;
+}
+#endif
+
