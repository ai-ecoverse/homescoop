{
  "name": "@ai-ecoverse/py-pandas",
  "version": "2.3.2-5",
  "description": "Pandas 2.3.2 for slicc WASIX CPython 3.14 (cp314-wasix_wasm32 side modules)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-pandas/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/py-pandas",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "slicc",
    "homescoop",
    "python",
    "pandas"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-ecoverse/wasix-python": "^3.14.2-5",
    "@ai-ecoverse/py-numpy": "^2.3.2-2",
    "@ai-ecoverse/py-python-dateutil": "2.9.0-post0.2",
    "@ai-ecoverse/py-pytz": "2026.4.0-2",
    "@ai-ecoverse/py-tzdata": "2026.4.0-2",
    "@ai-ecoverse/py-six": "1.17.0-2"
  },
  "homescoop": {
    "recipe": "py-pandas",
    "upstream": "2.3.2",
    "cython": "3.1.3",
    "platform": "wasix_wasm32",
    "patches": [
      "0001-pin-cython-3.1.x",
      "0002-lazy-ctypes"
    ]
  },
  "slicc": {
    "python": {
      "sitePackages": "lib/python3.14/site-packages",
      "requires": {
        "abi": "cp314",
        "platform": "wasix_wasm32"
      }
    }
  }
}
