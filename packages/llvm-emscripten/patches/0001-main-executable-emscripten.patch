llvm/lib/Support/Unix/Path.inc: getMainExecutable from argv[0] on Emscripten

Emscripten defines none of the platforms Path.inc lists (no __linux__, no
/proc/self/exe), so sys::fs::getMainExecutable falls to the HAVE_DLOPEN
dladdr branch, which returns "" there. clang then has an empty
InstalledDir and spawns "" -cc1, which slicc-kernel answers with
"posix_spawn failed: No such file or directory". Use argv[0], resolved
through PATH (getprogpath), as OpenBSD and Haiku do. The patch was
written and checked by thr_t4h9qnrjas for wasm-clang (homescoop#859
stage F).

--- a/llvm/lib/Support/Unix/Path.inc
+++ b/llvm/lib/Support/Unix/Path.inc
@@ -130,7 +130,7 @@
     defined(__CYGWIN__) || defined(__DragonFly__) || defined(_AIX) ||          \
     defined(__GNU__) ||                                                        \
     (defined(__sun__) && defined(__svr4__) || defined(__HAIKU__)) ||           \
-    defined(__managarm__)
+    defined(__managarm__) || defined(__EMSCRIPTEN__)
 static int test_dir(char ret[PATH_MAX], const char *dir, const char *bin) {
   struct stat sb;
   char fullpath[PATH_MAX];
@@ -287,7 +287,7 @@
   // Fall back to the classical detection.
   if (getprogpath(exe_path, argv0))
     return exe_path;
-#elif defined(__OpenBSD__) || defined(__HAIKU__)
+#elif defined(__OpenBSD__) || defined(__HAIKU__) || defined(__EMSCRIPTEN__)
   char exe_path[PATH_MAX];
   // argv[0] only
   if (getprogpath(exe_path, argv0) != NULL)
