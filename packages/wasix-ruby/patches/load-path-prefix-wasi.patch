--- ruby.c
+++ ruby.c
@@ -757,9 +757,25 @@
     ruby_push_include(getenv("RUBYLIB"), identical_path);
 
     id_initial_load_path_mark = INITIAL_LOAD_PATH_MARK;
+#if defined(__wasi__) && !(defined(LOAD_RELATIVE) && LOAD_RELATIVE)
+    /* WASIX_LOAD_PATH (homescoop#597): the package sets WASIX_RUBY_PREFIX
