+            path = rubylib_path_new(wasix_prefix, wasix_prefix_len);
+            rb_str_cat(path, paths + exec_prefix_len, len - exec_prefix_len);
+        }
+        else
+#endif
+        path = RUBY_RELATIVE(paths, len);
