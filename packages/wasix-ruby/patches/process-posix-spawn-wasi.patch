 static rb_pid_t
+wasix_proc_posix_spawn(struct rb_execarg *eargp, char *errmsg, size_t errmsg_buflen)
+{
+    posix_spawn_file_actions_t fa;
+    posix_spawnattr_t attr;
+    rb_pid_t pid = -1;
+    int err;
+    int fa_ok = 0, attr_ok = 0;
+    char **envp = NULL;
+    extern char **environ;
+    mode_t saved_umask = 0;
+    int umask_set = 0;
+
+    err = posix_spawn_file_actions_init(&fa);
+    if (err) { errno = err; ERRMSG("posix_spawn_file_actions_init"); return -1; }
+    fa_ok = 1;
+    err = posix_spawnattr_init(&attr);
+    if (err) { errno = err; ERRMSG("posix_spawnattr_init"); goto out; }
+    attr_ok = 1;
+
+    /* fd_open already resolved to parent fds + fd_dup2 in rb_execarg_parent_start1 */
+    if (wasix_posix_spawn_add_dup2(&fa, eargp->fd_dup2, errmsg, errmsg_buflen) < 0)
+        goto out;
+    if (wasix_posix_spawn_add_close(&fa, eargp->fd_close, errmsg, errmsg_buflen) < 0)
+        goto out;
+    if (wasix_posix_spawn_add_dup2(&fa, eargp->fd_dup2_child, errmsg, errmsg_buflen) < 0)
+        goto out;
+
+    if (eargp->chdir_given) {
+        err = posix_spawn_file_actions_addchdir_np(&fa, RSTRING_PTR(eargp->chdir_dir));
+        if (err) { errno = err; ERRMSG("posix_spawn_file_actions_addchdir_np"); goto out; }
+    }
+
+#ifdef POSIX_SPAWN_SETPGROUP
+    if (eargp->pgroup_given) {
+        short flags = 0;
+        posix_spawnattr_getflags(&attr, &flags);
+        flags |= POSIX_SPAWN_SETPGROUP;
+        err = posix_spawnattr_setflags(&attr, flags);
+        if (err) { /* unsupported — ignore pgroup */
+            /* leave flags unchanged */
+        }
+        else {
+            err = posix_spawnattr_setpgroup(&attr, eargp->pgroup_pgid);
+            if (err) {
+                /* ignore */
+            }
+        }
+    }
+#else
+    (void)eargp->pgroup_given;
+#endif
+
+    if (eargp->umask_given) {
+        saved_umask = umask(eargp->umask_mask);
+        umask_set = 1;
+    }
+
+    if (eargp->envp_str)
+        envp = (char **)RB_IMEMO_TMPBUF_PTR(eargp->envp_str);
+    else
+        envp = environ;
+
+    if (eargp->use_shell) {
+        char *script = RSTRING_PTR(eargp->invoke.sh.shell_script);
+        char *argv_sh[4];
+        char fbuf[MAXPATHLEN];
+        char *shell = dln_find_exe_r("sh", 0, fbuf, sizeof(fbuf));
+        argv_sh[0] = shell ? shell : (char *)"/bin/sh";
+        argv_sh[1] = (char *)"-c";
+        argv_sh[2] = script;
+        argv_sh[3] = 0;
+        err = posix_spawn(&pid, argv_sh[0], &fa, &attr, argv_sh, envp);
+    }
+    else {
+        char **argv = ARGVSTR2ARGV(eargp->invoke.cmd.argv_str);
+        VALUE prog = eargp->invoke.cmd.command_name;
+        const char *path;
+        char fbuf[MAXPATHLEN];
+        if (prog && !eargp->use_shell) {
+            argv[0] = RSTRING_PTR(prog);
+        }
+        if (!NIL_P(eargp->invoke.cmd.command_abspath)) {
+            path = RSTRING_PTR(eargp->invoke.cmd.command_abspath);
+            err = posix_spawn(&pid, path, &fa, &attr, argv, envp);
+        }
+        else {
+            path = argv[0] ? argv[0] : "";
+            if (!dln_find_exe_r(path, 0, fbuf, sizeof(fbuf))) {
+                errno = ENOENT;
+                ERRMSG("posix_spawn");
+                pid = -1;
+                goto out;
+            }
+            err = posix_spawn(&pid, fbuf, &fa, &attr, argv, envp);
+        }
+    }
+
+    if (err) {
+        errno = err;
+        ERRMSG("posix_spawn");
+        pid = -1;
+    }
+
+out:
+    if (umask_set) umask(saved_umask);
+    if (attr_ok) posix_spawnattr_destroy(&attr);
+    if (fa_ok) posix_spawn_file_actions_destroy(&fa);
+    return pid;
+}
