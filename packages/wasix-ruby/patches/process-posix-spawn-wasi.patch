+/* WASIX_POSIX_SPAWN: map rb_execarg redirects onto posix_spawn file_actions
+ * (wasix-libc -> WASIX proc_spawn3). Never fork. */
+
+static int
+wasix_posix_spawn_add_dup2(posix_spawn_file_actions_t *fa, VALUE ary, char *errmsg, size_t errmsg_buflen)
+{
+    long i;
+    if (ary == Qfalse || NIL_P(ary)) return 0;
+    for (i = 0; i < RARRAY_LEN(ary); i++) {
+        VALUE elt = RARRAY_AREF(ary, i);
+        int newfd = FIX2INT(RARRAY_AREF(elt, 0));
+        int oldfd = FIX2INT(RARRAY_AREF(elt, 1));
+        int err = posix_spawn_file_actions_adddup2(fa, oldfd, newfd);
+        if (err) {
+            errno = err;
+            ERRMSG("posix_spawn_file_actions_adddup2");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static int
+wasix_posix_spawn_add_close(posix_spawn_file_actions_t *fa, VALUE ary, char *errmsg, size_t errmsg_buflen)
+{
+    long i;
+    if (ary == Qfalse || NIL_P(ary)) return 0;
+    for (i = 0; i < RARRAY_LEN(ary); i++) {
+        VALUE elt = RARRAY_AREF(ary, i);
+        int fd = FIX2INT(RARRAY_AREF(elt, 0));
+        int err = posix_spawn_file_actions_addclose(fa, fd);
+        if (err) {
+            errno = err;
+            ERRMSG("posix_spawn_file_actions_addclose");
+            return -1;
+        }
+    }
+    return 0;
+}
