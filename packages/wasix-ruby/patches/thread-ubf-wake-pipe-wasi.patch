+#ifdef __wasi__
+/*
+ * WASIX_UBF_PIPE: Ruby interrupts a thread blocked in poll()/select()
+ * (Thread#kill, Thread#raise, Timeout) with pthread_kill(SIGVTALRM), which
+ * makes the system call fail with EINTR. slicc-kernel delivers no such
+ * signal to a thread of a WASIX process: the process gets killed instead.
+ * So each native thread has a wakeup pipe, its blocking waits poll the read
+ * end too, and the unblocking function writes a byte to it.
+ */
+static int
+wasix_wake_fd(struct rb_native_thread *nt)
+{
+    if (!nt) return -1;
+    if (!nt->wasix_wake_ok) {
+        if (pipe2(nt->wasix_wake, O_NONBLOCK | O_CLOEXEC) != 0) return -1;
+        nt->wasix_wake_ok = 1;
+    }
+    return nt->wasix_wake[0];
+}
+
+static void
+wasix_wake_drain(struct rb_native_thread *nt)
+{
+    char buf[64];
+    if (nt && nt->wasix_wake_ok) {
+        while (read(nt->wasix_wake[0], buf, sizeof buf) > 0)
+            ;
+    }
+}
+
+static void
+wasix_wake_thread(struct rb_native_thread *nt)
+{
+    if (nt && nt->wasix_wake_ok) {
+        char c = 0;
+        (void)!write(nt->wasix_wake[1], &c, 1);
+    }
+}
+
+static void
+wasix_wake_close(struct rb_native_thread *nt)
+{
+    if (nt && nt->wasix_wake_ok) {
+        close(nt->wasix_wake[0]);
+        close(nt->wasix_wake[1]);
+        nt->wasix_wake_ok = 0;
+    }
+}
+#endif
