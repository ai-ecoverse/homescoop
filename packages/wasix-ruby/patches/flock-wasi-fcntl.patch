--- missing/flock.c
+++ missing/flock.c
@@ -3,12 +3,52 @@
 
 #if defined _WIN32
 #elif defined __wasi__
+/* WASIX_FLOCK_FCNTL (homescoop#578): flock as whole-file fcntl record locks,
+ * which slicc-kernel enforces between processes from 1.100.0
+ * (slicc.fcntl_lock; engines.slicc-kernel), as wasix-perl does (#631). Up to
+ * 3.4.11-16 this was a no-op that succeeded, so it excluded nobody. fcntl
+ * semantics: the lock belongs to the process (a second handle in the same
+ * process isn't refused, closing any handle on the file drops it). */
 #include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
 
 int
 flock(int fd, int operation)
 {
-    errno = EINVAL;
+    struct flock lock;
+    struct stat st;
+    int cmd;
+
+    memset(&lock, 0, sizeof lock);
+    switch (operation & ~LOCK_NB) {
+      case LOCK_SH: lock.l_type = F_RDLCK; break;
+      case LOCK_EX: lock.l_type = F_WRLCK; break;
+      case LOCK_UN: lock.l_type = F_UNLCK; break;
+      default: errno = EINVAL; return -1;
+    }
+    lock.l_whence = SEEK_SET; /* l_start 0, l_len 0: the whole file */
+    /* slicc-kernel keeps record locks on regular files only. flock(2) on a
+     * pipe, a terminal, /dev/null or a directory succeeds on Linux: grant
+     * it, excluding nobody (slicc-kernel#757). */
+    if (fstat(fd, &st) != 0) return -1;
+    if (!S_ISREG(st.st_mode)) return 0;
+    cmd = (operation & LOCK_NB) ? F_SETLK : F_SETLKW;
+    if (fcntl(fd, cmd, &lock) == 0) return 0;
+    /* fcntl wants a handle open for writing for F_WRLCK and one open for
+     * reading for F_RDLCK; flock takes either on any handle (bundler opens
+     * its lock files "w", lock files are often opened read-only). On a
+     * handle of the other mode take the other kind: LOCK_EX on a read-only
+     * handle is a read lock (it keeps writers out), LOCK_SH on a write-only
+     * one a write lock. */
+    if (errno == EBADF && lock.l_type != F_UNLCK) {
+        lock.l_type = lock.l_type == F_WRLCK ? F_RDLCK : F_WRLCK;
+        if (fcntl(fd, cmd, &lock) == 0) return 0;
+    }
+    if (errno == EACCES || errno == EAGAIN) errno = EWOULDBLOCK;
     return -1;
 }
 #elif defined HAVE_FCNTL && defined HAVE_FCNTL_H
