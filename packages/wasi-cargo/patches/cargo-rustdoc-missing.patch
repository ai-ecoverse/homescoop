+/// Whether rustdoc can't be run here: slicc's Rust (wasi-rustc) ships no
+/// rustdoc (homescoop#1463). The configured path, or `rustdoc` on PATH.
+#[cfg(target_os = "wasi")]
+pub fn rustdoc_unavailable(gctx: &crate::GlobalContext) -> bool {
+    let Ok(path) = gctx.rustdoc() else { return true };
+    if path.components().count() > 1 {
+        return !path.is_file();
+    }
+    let Some(paths) = std::env::var("PATH").ok() else { return true };
+    !paths.split(':').filter(|d| !d.is_empty()).any(|d| std::path::Path::new(d).join(path).is_file())
+}
+
+/// The reason, for `cargo doc`, `cargo test --doc` and skipped doc tests.
+#[cfg(target_os = "wasi")]
+pub const RUSTDOC_UNAVAILABLE: &str = "rustdoc isn't available in slicc (@ai-ecoverse/wasi-rustc ships no rustdoc)";
