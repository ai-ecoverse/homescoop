[host_machine]
system = 'wasi'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[binaries]
c = 'wasixcc'
cpp = 'wasixcc++'
ar = 'wasixar'
pkg-config = 'pkg-config'

[properties]
needs_exe_wrapper = true
skip_sanity_check = true
longdouble_format = 'IEEE_QUAD_LE'
pkg_config_libdir = '/tmp/wasix-numpy-build/python-prefix/lib/pkgconfig'
c_args = ['-I/tmp/wasix-numpy-build/python-prefix/include/python3.14', '-I/Users/trieloff/Developer/ai-ecoverse/homescoop/packages/wasix-python/package/include/python3.14']
cpp_args = ['-I/tmp/wasix-numpy-build/python-prefix/include/python3.14', '-I/Users/trieloff/Developer/ai-ecoverse/homescoop/packages/wasix-python/package/include/python3.14']
c_link_args = ['-shared', '-nostdlib', '-Wl,--allow-undefined']
cpp_link_args = ['-shared', '-nostdlib', '-Wl,--allow-undefined']
