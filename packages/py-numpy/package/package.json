{
  "name": "@ai-ecoverse/py-numpy",
  "version": "2.5.4-4",
  "description": "NumPy, the fundamental package for array computing in Python.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-numpy/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/py-numpy",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "slicc",
    "homescoop",
    "python",
    "numpy"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-ecoverse/wasix-python": "3.15.0-6"
  },
  "homescoop": {
    "recipe": "py-numpy",
    "upstream": "2.5.4"
  },
  "slicc": {
    "commands": {
      "f2py": {
        "script": "bin/f2py"
      },
      "numpy-config": {
        "script": "bin/numpy-config"
      }
    },
    "python": {
      "sitePackages": "lib/python3.15/site-packages",
      "requires": {
        "abi": "cp315",
        "platform": "wasix_wasm32"
      }
    }
  }
}
