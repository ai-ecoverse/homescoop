+/// Re-apply the mode the target was created with, since the umask can
+/// narrow it. On wasi that is a host call per copied file, skipped when
+/// the umask clears none of its bits and the host has been seen to apply
+/// creation modes (homescoop: one `fchmod` per imported file otherwise).
+fn assert_permissions(target: &fs::File, permissions: &CopyPermissions) -> io::Result<()> {
+    #[cfg(target_os = "wasi")]
+    {
+        if crate::wasi_fs::creation_mode_is_exact(*permissions) {
+            return Ok(());
+        }
+        if let Ok(current) = crate::wasi_fs::file_mode(target) {
+            crate::wasi_fs::creation_mode_checked(*permissions, current);
+            if crate::wasi_fs::creation_mode_is_exact(*permissions) {
+                return Ok(());
+            }
+        }
+    }
+    set_file_permissions(target, permissions)
+}
