+/// The mode of the directory a file is created in, looked up once per
+/// directory for the process (homescoop: the CAS writer creates every
+/// store file through here, one `lstat` of its shard each, and the
+/// shards' modes don't change during an install). `None` for a path that
+/// isn't a directory, which isn't cached.
+fn parent_dir_mode(parent: &Path) -> Option<u32> {
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+    static MODES: OnceLock<Mutex<HashMap<std::path::PathBuf, u32>>> = OnceLock::new();
+    let modes = MODES.get_or_init(|| Mutex::new(HashMap::new()));
+    if let Some(mode) = modes.lock().unwrap_or_else(std::sync::PoisonError::into_inner).get(parent) {
+        return Some(*mode);
+    }
+    let mode = path_mode(parent).ok().filter(|mode| mode & libc::S_IFMT == libc::S_IFDIR)?;
+    modes.lock().unwrap_or_else(std::sync::PoisonError::into_inner).insert(parent.to_path_buf(), mode);
+    Some(mode)
+}
+
+/// Whether a file created with `mode` is known to carry exactly `mode`
+/// without asking (homescoop: one `fstat` per created file otherwise).
+/// That needs the umask to clear none of its bits, and a host that applies
+/// the creation mode: [`creation_mode_checked`] learns that from the first
+/// file whose mode is checked, and until then nothing is skipped.
+pub(crate) fn creation_mode_is_exact(mode: u32) -> bool {
+    CREATION_MODE.load(std::sync::atomic::Ordering::Relaxed) == 1 && mode & current_umask() & 0o777 == 0
+}
+
+/// Record whether a file created with `wanted` (which the umask didn't
+/// narrow) came out with exactly that mode.
+pub(crate) fn creation_mode_checked(wanted: u32, current: u32) {
+    if wanted & current_umask() & 0o777 == 0 {
+        let seen = if current & 0o7777 == wanted & 0o7777 { 1 } else { 2 };
+        let _ = CREATION_MODE.compare_exchange(0, seen, std::sync::atomic::Ordering::Relaxed, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// 0: not known yet; 1: the host applies the creation mode; 2: it doesn't.
+static CREATION_MODE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
 fn grant_file_mode(file: &std::fs::File, wanted: u32) -> io::Result<()> {
+    if creation_mode_is_exact(wanted) {
+        return Ok(());
+    }
     let current = file_mode(file)? & 0o777;
+    creation_mode_checked(wanted, current);
     if current | wanted == current {
         return Ok(());
     }
