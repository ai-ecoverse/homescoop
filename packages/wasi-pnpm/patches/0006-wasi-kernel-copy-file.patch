+/// [`copy_file_exclusive`] with nothing to do on the created file, so on
+/// wasi the host may copy it itself (homescoop: slicc-kernel >= 1.128.0's
+/// `ctx.fs.copyFile`, one kernel call per file and no bytes through the
+/// process). The kernel creates the target exclusively with `permissions`
+/// (applied under the umask, as `open(O_CREAT)`), doesn't follow a link at
+/// it, and removes a partial target on failure. A host without the op
+/// answers `ENOSYS`, and a copy across mounts `EXDEV`: both fall back to
+/// the copy through the process.
+pub fn copy_file_new(
+    source_path: &Path,
+    target_path: &Path,
+    permissions: &CopyPermissions,
+) -> io::Result<()> {
+    #[cfg(target_os = "wasi")]
+    match crate::wasi_fs::kernel_copy_file(source_path, target_path, *permissions) {
+        Ok(()) => return Ok(()),
+        Err(error) if matches!(error.raw_os_error(), Some(libc::ENOSYS | libc::EXDEV)) => {}
+        Err(error) => return Err(error),
+    }
+    copy_file_exclusive(source_path, target_path, permissions, |_| Ok(()))
+}
