+/// Copy `source` to a new `target` in the host (homescoop: one kernel call
+/// per file where slicc-kernel has `ctx.fs.copyFile`). `ENOSYS` once means
+/// the host has no such op; it isn't asked again.
+pub(crate) fn kernel_copy_file(source: &Path, target: &Path, mode: u32) -> io::Result<()> {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    static UNSUPPORTED: AtomicBool = AtomicBool::new(false);
+    if UNSUPPORTED.load(Ordering::Relaxed) {
+        return Err(io::Error::from_raw_os_error(libc::ENOSYS));
+    }
+    let result = with_absolute_path(source, |source| {
+        with_absolute_path(target, |target| {
+            // SAFETY: both paths are readable for the synchronous call; the
+            // host retains neither pointer.
+            check(unsafe { host::copy_file(source.as_ptr(), source.len(), target.as_ptr(), target.len(), mode & 0o7777, 1) })
+        })
+    });
+    if result.as_ref().err().and_then(io::Error::raw_os_error) == Some(libc::ENOSYS) {
+        UNSUPPORTED.store(true, Ordering::Relaxed);
+    }
+    result
+}
