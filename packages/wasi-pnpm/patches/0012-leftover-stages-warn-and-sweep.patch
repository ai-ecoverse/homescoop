new file mode 100644
index 00000000..1d59d06c
--- /dev/null
+++ b/pnpm/crates/deps-restorer/src/leftover_stages.rs
@@ -0,0 +1,139 @@
+use std::{
+    collections::BTreeSet,
+    fs,
+    io::{self, Write},
+    path::{Component, Path, PathBuf},
+    sync::Mutex,
+};
+
+pub const RECORD: &str = ".pacquet-stage-leftovers";
+const MARK: &str = "_pacquet-stage_";
+static RECORD_LOCK: Mutex<()> = Mutex::new(());
+
+fn outermost_modules_dir(path: &Path) -> Option<&Path> {
+    path.ancestors().skip(1).filter(|a| a.file_name().is_some_and(|n| n == "node_modules")).last()
+}
+
+fn has_mark(path: &Path) -> bool {
+    path.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.contains(MARK))
+}
+
+fn warn(message: &str) {
+    eprintln!(" WARN  {message}");
+}
+
+pub fn record_leftover_stage(aside: &Path, package: &Path, error: &io::Error) {
+    let recorded = outermost_modules_dir(aside).or_else(|| aside.parent()).and_then(|root| {
+        let relative = aside.strip_prefix(root).ok()?.to_str()?;
+        let _guard = RECORD_LOCK.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let mut file =
+            fs::OpenOptions::new().create(true).append(true).open(root.join(RECORD)).ok()?;
+        file.write_all(format!("{relative}\n").as_bytes()).ok()
+    });
+    let later = if recorded.is_some() {
+        "a later pnpm install removes it once it can be deleted"
+    } else {
+        "pnpm could not record it, so delete it by hand"
+    };
+    warn(&format!(
+        "Could not delete the replaced copy of {} ({error}). It stays at {}; {later}.",
+        package.display(),
+        aside.display(),
+    ));
+}
+
+fn recorded_entry(line: &str) -> Option<PathBuf> {
+    let path = Path::new(line);
+    let plain = !line.is_empty() && path.components().all(|c| matches!(c, Component::Normal(_)));
+    (plain && has_mark(path)).then(|| path.to_path_buf())
+}
+
+fn scan(modules_dir: &Path, found: &mut BTreeSet<PathBuf>) {
+    let Ok(entries) = fs::read_dir(modules_dir) else { return };
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else { continue };
+        if name.contains(MARK) {
+            found.insert(PathBuf::from(name));
+        } else if name.starts_with('@')
+            && entry.file_type().is_ok_and(|t| t.is_dir())
+            && let Ok(scoped) = fs::read_dir(entry.path())
+        {
+            for inner in scoped.flatten() {
+                if let Some(inner) = inner.file_name().to_str()
+                    && inner.contains(MARK)
+                {
+                    found.insert(Path::new(name).join(inner));
+                }
+            }
+        }
+    }
+}
+
+fn remove(path: &Path) -> io::Result<()> {
+    match pnpm_fs::remove_dirent(path) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        result => result,
+    }
+}
+
+pub fn sweep_leftover_stages(modules_dirs: &[PathBuf]) -> Vec<PathBuf> {
+    let mut left = Vec::new();
+    for modules_dir in modules_dirs {
+        sweep_one(modules_dir, &mut left);
+    }
+    left
+}
+
+fn sweep_one(modules_dir: &Path, left: &mut Vec<PathBuf>) {
+    let record = modules_dir.join(RECORD);
+    let recorded: BTreeSet<PathBuf> = match fs::read_to_string(&record) {
+        Ok(text) => text.lines().filter_map(recorded_entry).collect(),
+        Err(_) => BTreeSet::new(),
+    };
+    let mut unrecorded = BTreeSet::new();
+    scan(modules_dir, &mut unrecorded);
+    let mut kept = Vec::new();
+    for relative in &recorded {
+        let path = modules_dir.join(relative);
+        if let Err(error) = remove(&path) {
+            warn(&format!(
+                "Could not delete {}, a replaced package copy an earlier update left ({error}). \
+                 The next pnpm install tries again.",
+                path.display(),
+            ));
+            kept.push(relative.clone());
+            left.push(path);
+        }
+    }
+    for relative in unrecorded.difference(&recorded) {
+        let path = modules_dir.join(relative);
+        if fs::symlink_metadata(path.join("node_modules")).is_ok() {
+            warn(&format!(
+                "{} is left over from an earlier update and holds a node_modules, which a failed \
+                 update may have set aside; pnpm leaves it. Check it and delete it by hand.",
+                path.display(),
+            ));
+            left.push(path);
+        } else if let Err(error) = remove(&path) {
+            warn(&format!(
+                "Could not delete {}, left over from an earlier update ({error}). The next pnpm \
+                 install tries again.",
+                path.display(),
+            ));
+            left.push(path);
+        }
+    }
+    if recorded.is_empty() && kept.is_empty() {
+        return;
+    }
+    let result = if kept.is_empty() {
+        remove(&record)
+    } else {
+        let text: String = kept.iter().filter_map(|p| p.to_str()).map(|p| format!("{p}\n")).collect();
+        fs::write(&record, text)
+    };
+    if let Err(error) = result {
+        warn(&format!("Could not update {} ({error}).", record.display()));
+    }
+}
