+
+pub(crate) fn sweep_leftover_stages<'p>(
+    config: &Config,
+    projects: impl Iterator<Item = (&'p Path, &'p PackageManifest)>,
+) {
+    let mut dirs = vec![config.modules_dir.clone()];
+    for (project_dir, manifest) in projects {
+        let name = manifest_string_field(manifest, "name");
+        for dir in [
+            config.project_modules_dir(project_dir, name.as_deref()),
+            crate::optimistic_repeat_install::hoisted_project_modules_dir(project_dir),
+        ] {
+            if !dirs.contains(&dir) {
+                dirs.push(dir);
+            }
+        }
+    }
+    pnpm_deps_restorer::sweep_leftover_stages(&dirs);
+}
