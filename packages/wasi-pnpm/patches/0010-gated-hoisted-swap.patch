+/// The host's answer, asked once: 1 when a directory rename is a cheap,
+/// atomic move (homescoop#1128).
+pub(crate) fn directory_rename_is_cheap() -> bool {
+    use std::sync::OnceLock;
+    static CHEAP: OnceLock<bool> = OnceLock::new();
+    // SAFETY: this import takes no pointers.
+    *CHEAP.get_or_init(|| unsafe { host::directory_rename_cheap() } == 1)
+}
