#!/bin/sh
# pnpm for slicc (12.9.1-16): runs pnpm.wasm (the pnpm-wasm command) and
# retries it once when it dies of homescoop#1127's false trap: exit status
# 134 with "wasm trap in thread N: memory access out of bounds" on stderr
# (V8 bounds-checking a memset/memcpy against a thread's stale view of the
# shared memory; patches/0009 closes the window in pnpm's own allocator,
# this catches whatever is left). pnpm is idempotent over its store, so a
# second run finishes the install. Nothing else is retried. stderr is passed
# through as it comes and kept in a temp file to look for the signature.
# PNPM_RETRY_COMMAND names another command to run instead (the cert's fake).
cmd=${PNPM_RETRY_COMMAND:-pnpm-wasm}
tmp=${TMPDIR:-/tmp}/pnpm-stderr.$$
st=$tmp.status

run() {
  rm -f "$tmp" "$st"
  # stdout straight through (fd 3), stderr through tee into $tmp.
  { { "$cmd" "$@" 2>&1 1>&3 3>&-; echo $? > "$st"; } | tee "$tmp" >&2; } 3>&1
  rc=$(cat "$st" 2>/dev/null || echo 1)
}

# The trap line, if stderr has one (sh builtins only: no grep in the base set).
trap_line() {
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      *'wasm trap in thread '*': memory access out of bounds'*)
        echo "wasm trap in thread ${line#*wasm trap in thread }"
        return 0
        ;;
    esac
  done < "$tmp"
  return 1
}

run "$@"
if [ "$rc" = 134 ] && where=$(trap_line 2>/dev/null); then
  echo "pnpm: retrying once after a false trap (homescoop#1127): $where" >&2
  run "$@"
fi
rm -f "$tmp" "$st"
exit "$rc"
