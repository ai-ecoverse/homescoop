{
  "name": "@ai-ecoverse/wasi-pnpm",
  "version": "12.9.1-19",
  "description": "The pnpm package manager for SLICC, with npm, npx and i commands, to install and run JavaScript packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasi-pnpm/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasi-pnpm",
  "keywords": [
    "wasm",
    "wasi",
    "slicc",
    "homescoop",
    "pnpm"
  ],
  "type": "module",
  "engines": {
    "slicc-kernel": ">=1.7.2"
  },
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "host",
    "shims"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasi-pnpm",
    "upstream": "12.9.1",
    "source": "pnpm/pnpm@5dafb0980042af99fb1aa24478d16f03b8474b50",
    "patches": [
      "0001-parking-lot-core-nightly.patch",
      "0002-cli-no-source-checkout-path-on-wasm.patch",
      "0003-wasm-build-keep-linked-module.patch",
      "0005-wasi-fewer-mode-calls.patch",
      "0006-wasi-kernel-copy-file.patch",
      "0007-wasm-init-pins-the-running-pnpm.patch",
      "0008-wasm-root-is-not-a-local-prefix.patch",
      "0009-wasm-alloc-refreshes-memory-view.patch",
      "0010-gated-hoisted-swap.patch"
    ]
  },
  "slicc": {
    "abi": "wasi",
    "commands": {
      "pnpm": {
        "wasm": "bin/pnpm.wasm",
        "imports": "host/pnpm-host.mjs"
      },
      "pn": {
        "wasm": "bin/pnpm.wasm",
        "imports": "host/pnpm-host.mjs",
        "argv0": "pnpm"
      },
      "npm": {
        "script": "shims/npm"
      },
      "npx": {
        "script": "shims/npx"
      },
      "i": {
        "script": "shims/i"
      }
    },
    "env": {
      "PNPM_SLICC_PACKAGE": "${package}",
      "PNPM_WASM_EXECUTABLE": "${package}/bin/pnpm.wasm",
      "PNPM_WASM_PID": "1",
      "PNPM_WASM_CWD": "${cwd}",
      "PNPM_WASM_TMPDIR": "/tmp",
      "PNPM_WASM_HOSTNAME": "slicc",
      "PNPM_WASM_PLATFORM": "wasi",
      "PNPM_WASM_ARCH": "wasm32",
      "PNPM_WASM_ENDIANNESS": "LE",
      "PNPM_CONFIG_NODE_LINKER": "hoisted",
      "PNPM_CONFIG_PACKAGE_IMPORT_METHOD": "copy",
      "PNPM_CONFIG_IGNORE_SCRIPTS": "true",
      "PNPM_CONFIG_UPDATE_NOTIFIER": "false",
      "PNPM_SLICC_HTTP_PROXY": "${http_proxy}",
      "PNPM_SLICC_HTTPS_PROXY": "${https_proxy}",
      "PNPM_SLICC_NO_PROXY": "${no_proxy}",
      "PNPM_SLICC_SSL_CERT_FILE": "${SSL_CERT_FILE}",
      "http_proxy": null,
      "https_proxy": null,
      "HTTP_PROXY": null,
      "HTTPS_PROXY": null,
      "SSL_CERT_FILE": null,
      "SLICC_WASM_THREADS": "256"
    }
  }
}
