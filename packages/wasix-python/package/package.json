{
  "name": "@ai-ecoverse/wasix-python",
  "version": "3.15.0-6",
  "description": "The Python 3.15 programming language, with pip.",
  "license": "PSF-2.0 AND GPL-3.0-or-later",
  "engines": {
    "slicc-kernel": ">=1.122.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasix-python/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasix-python",
  "keywords": [
    "wasm",
    "wasi",
    "wasix",
    "slicc",
    "homescoop",
    "python",
    "cpython"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "lib",
    "include",
    "SOABI.assert"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasix-python",
    "upstream": "3.15.0"
  },
  "slicc": {
    "abi": "wasi",
    "commands": {
      "python3": {
        "wasm": "bin/python.wasm",
        "variants": [
          {
            "env": {
              "PYTHON_FORK": "true"
            },
            "wasm": "bin/python-fork.wasm"
          }
        ],
        "argv0Path": true,
        "env": {
          "PYTHONHOME": "./",
          "PYTHONDONTWRITEBYTECODE": "1"
        },
        "args": [
          "-X",
          "slicc_home=${package}/"
        ]
      },
      "python": {
        "wasm": "bin/python.wasm",
        "variants": [
          {
            "env": {
              "PYTHON_FORK": "true"
            },
            "wasm": "bin/python-fork.wasm"
          }
        ],
        "argv0Path": true,
        "env": {
          "PYTHONHOME": "./",
          "PYTHONDONTWRITEBYTECODE": "1"
        },
        "args": [
          "-X",
          "slicc_home=${package}/"
        ]
      },
      "pip": {
        "wasm": "bin/python.wasm",
        "variants": [
          {
            "env": {
              "PYTHON_FORK": "true"
            },
            "wasm": "bin/python-fork.wasm"
          }
        ],
        "argv0Path": true,
        "env": {
          "PYTHONHOME": "./",
          "PYTHONDONTWRITEBYTECODE": "1"
        },
        "argv0": "python3",
        "args": [
          "-X",
          "slicc_home=${package}/",
          "-m",
          "pip"
        ]
      },
      "pip3": {
        "wasm": "bin/python.wasm",
        "variants": [
          {
            "env": {
              "PYTHON_FORK": "true"
            },
            "wasm": "bin/python-fork.wasm"
          }
        ],
        "argv0Path": true,
        "env": {
          "PYTHONHOME": "./",
          "PYTHONDONTWRITEBYTECODE": "1"
        },
        "argv0": "python3",
        "args": [
          "-X",
          "slicc_home=${package}/",
          "-m",
          "pip"
        ]
      }
    },
    "python": {
      "version": "3.15",
      "abi": "cp315",
      "platform": "wasix_wasm32",
      "soabi": "cpython-315-wasm32-wasix",
      "stdlib": "lib/python3.15",
      "sitePackages": "lib/python3.15/site-packages"
    }
  }
}
