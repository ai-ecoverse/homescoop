getpath: honour PYTHONHOME under -E/-I (homescoop#1144); venv: always
symlink the interpreter on wasi (homescoop#1269).

The slicc command runs python as /usr/bin/python3 (a registered copy) with
PYTHONHOME set to the package; -I/-E ignored it ("No module named
'encodings'"). A venv's copied bin/python runs as a bare wasm, without the
command's env and with argv[0] reduced to its name, so it finds neither
PYTHONHOME nor pyvenv.cfg; a symlink resolves to the registered command.

--- a/Modules/getpath.py
+++ b/Modules/getpath.py
@@ -332,7 +332,11 @@
 
 if home:
     home_was_set = True
-elif use_environment and ENV_PYTHONHOME and not py_setpath:
+elif ENV_PYTHONHOME and not py_setpath:
+    # homescoop wasix-python (homescoop#1144): the slicc command sets
+    # PYTHONHOME to the package (its 'env'); the executable is a registered
+    # copy at /usr/bin/python3, so nothing else can find the stdlib. Honour
+    # it under -E / -I too (they still ignore PYTHONPATH and the rest).
     home = ENV_PYTHONHOME
 
 
--- a/Lib/venv/__init__.py
+++ b/Lib/venv/__init__.py
@@ -52,6 +52,13 @@
         self.system_site_packages = system_site_packages
         self.clear = clear
         self.symlinks = symlinks
+        # homescoop wasix-python (homescoop#1269): a copied interpreter can't
+        # run. The kernel starts a bare copy of python.wasm without the slicc
+        # command's environment and with argv[0] reduced to its name, so it
+        # can find neither PYTHONHOME nor its pyvenv.cfg. A symlink resolves to
+        # the registered /usr/bin/python3 and works: always link.
+        if sys.platform == 'wasi' and not symlinks:
+            self.symlinks = True
         self.upgrade = upgrade
         self.with_pip = with_pip
         self.orig_prompt = prompt
