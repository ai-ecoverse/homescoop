getpath: under -E/-I, find the home from SLICC_PYTHONHOME, which only the
slicc command sets (homescoop#1504, #1144); venv: always symlink the
interpreter on wasi (homescoop#1269).

The slicc command runs python as /usr/bin/python3 (a registered copy) with
PYTHONHOME and SLICC_PYTHONHOME set to the package. -I/-E ignore PYTHONHOME
as stock CPython does, caller-set or not, and take the home from
SLICC_PYTHONHOME instead, so the stdlib is still found. A venv's copied
bin/python runs as a bare wasm, without the command's env and with argv[0]
reduced to its name, so it finds neither PYTHONHOME nor pyvenv.cfg; a
symlink resolves to the registered command.

--- a/Lib/venv/__init__.py
+++ b/Lib/venv/__init__.py
@@ -52,6 +52,13 @@
         self.system_site_packages = system_site_packages
         self.clear = clear
         self.symlinks = symlinks
+        # homescoop wasix-python (homescoop#1269): a copied interpreter can't
+        # run. The kernel starts a bare copy of python.wasm without the slicc
+        # command's environment and with argv[0] reduced to its name, so it
+        # can find neither PYTHONHOME nor its pyvenv.cfg. A symlink resolves to
+        # the registered /usr/bin/python3 and works: always link.
+        if sys.platform == 'wasi' and not symlinks:
+            self.symlinks = True
         self.upgrade = upgrade
         self.with_pip = with_pip
         self.orig_prompt = prompt
--- a/Modules/getpath.c
+++ b/Modules/getpath.c
@@ -936,6 +936,7 @@
         !wchar_to_dict(dict, "EXE_SUFFIX", EXE_SUFFIX) ||
         !env_to_dict(dict, "ENV_PATH", 0) ||
         !env_to_dict(dict, "ENV_PYTHONHOME", 0) ||
+        !env_to_dict(dict, "ENV_SLICC_PYTHONHOME", 0) ||
         !env_to_dict(dict, "ENV_PYTHONEXECUTABLE", 0) ||
         !env_to_dict(dict, "ENV___PYVENV_LAUNCHER__", 1) ||
         !progname_to_dict(dict, "real_executable") ||
--- a/Modules/getpath.py
+++ b/Modules/getpath.py
@@ -334,6 +334,8 @@
     home_was_set = True
 elif use_environment and ENV_PYTHONHOME and not py_setpath:
     home = ENV_PYTHONHOME
+elif ENV_SLICC_PYTHONHOME and not py_setpath:
+    home = ENV_SLICC_PYTHONHOME
 
 
