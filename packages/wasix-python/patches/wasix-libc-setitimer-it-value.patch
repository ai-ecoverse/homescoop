+/**
+ * Send a signal after an initial delay, optionally repeating.
+ * Note: Like POSIX `setitimer`, with separate initial (it_value) and
+ * interval (it_interval). Added as `proc_raise_interval2` so the legacy
+ * 3-arg `proc_raise_interval` import stays ABI-compatible with stock Wasmer.
+ *
+ * Times are `__wasi_timestamp_t` nanoseconds. Zero initial with zero
+ * interval cancels. One-shot: non-zero initial, zero interval, repeat=FALSE.
+ */
+__wasi_errno_t __wasi_proc_raise_interval2(
+    /**
+     * The signal condition to trigger.
+     */
+    __wasi_signal_t sig,
+    /**
+     * Initial delay before the first raise (it_value), in nanoseconds.
+     * Zero together with a zero interval cancels the timer.
+     */
+    __wasi_timestamp_t initial,
+    /**
+     * Repeat period (it_interval), in nanoseconds.
+     * Zero means one-shot (no further raises after the first).
+     */
+    __wasi_timestamp_t interval,
+    /**
+     * TRUE iff interval != 0.
+     */
+    __wasi_bool_t repeat
+) __attribute__((__warn_unused_result__));
 /**
  * Forks the current process into a new subprocess. If the function
  * returns a zero then its the new subprocess. If it returns a positive
