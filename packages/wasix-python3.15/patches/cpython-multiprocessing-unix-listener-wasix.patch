WASI: slicc-kernel keeps path-bound AF_UNIX sockets out of the
filesystem (slicc-kernel#753), so SocketListener's unlink of its path at
close gets ENOENT and multiprocessing.Manager() prints a traceback at exit
(homescoop#515). Tolerate a socket path that is already gone.

--- a/Lib/multiprocessing/connection.py
+++ b/Lib/multiprocessing/connection.py
@@ -659,7 +659,8 @@ class SocketListener(object):
         if family == 'AF_UNIX' and not util.is_abstract_socket_namespace(address):
             # Linux abstract socket namespaces do not need to be explicitly unlinked
             self._unlink = util.Finalize(
-                self, os.unlink, args=(address,), exitpriority=0
+                self, _unlink_socket if sys.platform == 'wasi' else os.unlink,
+                args=(address,), exitpriority=0
                 )
         else:
             self._unlink = None
@@ -679,6 +680,13 @@ class SocketListener(object):
                 unlink()
 
 
+def _unlink_socket(path):
+    try:
+        os.unlink(path)
+    except FileNotFoundError:
+        pass
+
