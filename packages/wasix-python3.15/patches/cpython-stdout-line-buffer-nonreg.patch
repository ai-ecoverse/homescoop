stdout: line-buffered unless a regular file (WASI pipes report st_mode 0).
Shipped since 3.14.2-7; regenerated against pristine 3.15.0.

--- a/Python/pylifecycle.c
+++ b/Python/pylifecycle.c
@@ -50,6 +50,9 @@
 #ifdef HAVE_UNISTD_H
 #  include <unistd.h>             // isatty()
 #endif
+#ifdef HAVE_SYS_STAT_H
+#  include <sys/stat.h>           // fstat(), S_ISREG()
+#endif
 
 #if defined(__APPLE__)
 #  include <AvailabilityMacros.h>
@@ -3044,10 +3047,29 @@ create_stdio(const PyConfig *config, PyObject* io,
         write_through = Py_True;
     else
         write_through = Py_False;
-    if (buffered_stdio && (isatty || fd == fileno(stderr)))
+    /* Line-buffer tty and stderr as usual. On WASIX/WASI, pipes report
+       st_mode==0 (not a regular file); line-buffer stdout in that case so
+       agent/harness pipes stream output and survive crashes. Regular-file
+       redirects stay block-buffered. fstat failure keeps historic behaviour. */
+    if (buffered_stdio && (isatty || fd == fileno(stderr))) {
         line_buffering = Py_True;
-    else
+    }
+    else if (buffered_stdio && fd == fileno(stdout)) {
+#ifdef HAVE_SYS_STAT_H
+        struct stat st;
+        if (fstat(fd, &st) == 0 && !S_ISREG(st.st_mode)) {
+            line_buffering = Py_True;
+        }
+        else {
+            line_buffering = Py_False;
+        }
+#else
+        line_buffering = Py_False;
+#endif
+    }
+    else {
         line_buffering = Py_False;
+    }
 
     Py_CLEAR(raw);
     Py_CLEAR(text);
