+#ifndef __EMSCRIPTEN__
+// homescoop: a variadic argument in clang's wasm32 C ABI (va_arg): 4-byte
+// slots, values at their natural alignment (8 for 64-bit, 16 for long
+// double), aggregates by pointer (structs that replace_type kept as structs).
+static size_t vararg_align(ffi_type *type) {
+  switch (type->type) {
+  case FFI_TYPE_UINT64:
+  case FFI_TYPE_SINT64:
+  case FFI_TYPE_DOUBLE:
+    return 8;
+  case FFI_TYPE_LONGDOUBLE:
+    return 16;
+  default:
+    return 4;
+  }
+}
+
+static size_t vararg_size(ffi_type *type) {
+  switch (type->type) {
+  case FFI_TYPE_VOID:
+    return 0;
+  case FFI_TYPE_UINT64:
+  case FFI_TYPE_SINT64:
+  case FFI_TYPE_DOUBLE:
+    return 8;
+  case FFI_TYPE_LONGDOUBLE:
+    return 16;
+  default:
+    return 4; // i32-sized scalars, pointers, structs by pointer
+  }
+}
+#endif
