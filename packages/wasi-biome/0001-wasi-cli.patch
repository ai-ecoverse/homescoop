diff --git a/crates/biome_cli/src/commands/upgrade_wasi.rs b/crates/biome_cli/src/commands/upgrade_wasi.rs
--- /dev/null
+++ b/crates/biome_cli/src/commands/upgrade_wasi.rs
@@ -0,0 +1,11 @@
+use crate::{CliDiagnostic, CliSession};
+
+/// `biome upgrade` replaces the running binary with a release downloaded over
+/// HTTPS. A WASI build has neither, and comes from an npm package: upgrade
+/// that package instead.
+pub(crate) fn upgrade(_session: CliSession) -> Result<(), CliDiagnostic> {
+    Err(CliDiagnostic::upgrade_error(
+        "`biome upgrade` is not available in the WASI build. Upgrade Biome with the package manager you installed it with.",
+        None,
+    ))
+}
diff --git a/crates/biome_cli/src/service/wasi.rs b/crates/biome_cli/src/service/wasi.rs
