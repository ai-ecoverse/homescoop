+/// [env::temp_dir] panics on WASI, which has no notion of one: take `TMPDIR`
+/// there, or `/tmp`.
+fn temp_dir() -> path::PathBuf {
+    #[cfg(target_os = "wasi")]
+    {
+        env::var_os("TMPDIR").map_or_else(|| path::PathBuf::from("/tmp"), path::PathBuf::from)
+    }
+    #[cfg(not(target_os = "wasi"))]
+    {
+        env::temp_dir()
+    }
+}
