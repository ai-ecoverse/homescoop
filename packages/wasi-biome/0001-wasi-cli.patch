+/// The process's working directory, for wasi-libc's, which is always "/" at
+/// start. Relative paths reach the real one (the kernel's `.` preopen), but
+/// nothing gives its path. PWD names it only when it is the same directory
+/// as `.` (device and inode), as POSIX shells check it: a parent can change
+/// a child's directory without rewriting PWD, as Node's `spawn` with `cwd`
+/// does. Otherwise the path is found as getcwd(3) finds it, by walking `..`
+/// up to the root and looking for each directory in its parent. PWD=/ is
+/// never taken: "/" is not a preopen, so before the chdir it reaches `.`.
+#[cfg(target_os = "wasi")]
+fn wasi_working_directory() -> Option<std::path::PathBuf> {
+    use std::ffi::CString;
+    use std::os::wasi::ffi::OsStrExt;
+    use std::path::{Component, Path, PathBuf};
+
+    fn id(path: &Path) -> Option<(libc::dev_t, libc::ino_t)> {
+        let path = CString::new(path.as_os_str().as_bytes()).ok()?;
+        let mut st = std::mem::MaybeUninit::<libc::stat>::uninit();
+        // SAFETY: `path` is NUL-terminated, and `st` is read only after
+        // stat(2) has filled it.
+        let st = unsafe {
+            if libc::stat(path.as_ptr(), st.as_mut_ptr()) != 0 {
+                return None;
+            }
+            st.assume_init()
+        };
+        Some((st.st_dev, st.st_ino))
+    }
+
+    let here = id(Path::new("."))?;
+    if let Some(pwd) = std::env::var_os("PWD").map(PathBuf::from) {
+        let plain = pwd.is_absolute()
+            && pwd.parent().is_some()
+            && pwd
+                .components()
+                .all(|part| matches!(part, Component::RootDir | Component::Normal(_)));
+        if plain && id(&pwd) == Some(here) {
+            return Some(pwd);
+        }
+    }
+    let (mut dir, mut at, mut names) = (PathBuf::from("."), here, Vec::new());
+    loop {
+        let parent = dir.join("..");
+        let up = id(&parent)?;
+        if up == at {
+            break;
+        }
+        let name = std::fs::read_dir(&parent)
+            .ok()?
+            .flatten()
+            .map(|entry| entry.file_name())
+            .find(|name| id(&parent.join(name)) == Some(at))?;
+        names.push(name);
+        (dir, at) = (parent, up);
+    }
+    Some(names.iter().rev().fold(PathBuf::from("/"), |path, name| path.join(name)))
+}
