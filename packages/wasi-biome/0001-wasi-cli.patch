@@ -0,0 +1,45 @@
+//! WASI preview1 has no domain sockets and cannot start a daemon process, so
+//! there is no Biome server to connect to: `--use-server` finds none, and the
+//! daemon commands (`start`, `lsp-proxy`, `__run_server`, `__print_socket`)
+//! report that they are unsupported. Every other command runs in-process.
+
+use crate::logging::LogOptions;
+use biome_lsp::ServerFactory;
+use biome_service::WatcherOptions;
+use camino::Utf8PathBuf;
+use std::{
+    convert::Infallible,
+    io::{self, ErrorKind},
+};
+use tokio::io::{Empty, Sink};
+
+fn unsupported() -> io::Error {
+    io::Error::new(
+        ErrorKind::Unsupported,
+        "the Biome daemon needs sockets and child processes, which this WASI build does not have",
+    )
+}
+
+pub(crate) fn enumerate_pipes() -> io::Result<impl Iterator<Item = (String, Utf8PathBuf)>> {
+    Ok(std::iter::empty())
+}
+
+pub(crate) async fn open_socket() -> io::Result<Option<(Empty, Sink)>> {
+    Ok(None)
+}
+
+pub(crate) async fn ensure_daemon(
+    _stop_on_disconnect: bool,
+    _watcher_configuration: WatcherOptions,
+    _log_options: LogOptions,
+) -> io::Result<bool> {
+    Err(unsupported())
+}
+
+pub(crate) async fn print_socket() -> io::Result<()> {
+    Err(unsupported())
+}
+
+pub(crate) async fn run_daemon(_factory: ServerFactory) -> io::Result<Infallible> {
+    Err(unsupported())
+}
