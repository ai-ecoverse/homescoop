{
  "name": "@ai-ecoverse/wasi-biome",
  "version": "2.5.15-6",
  "description": "Biome, the formatter and linter for JavaScript, TypeScript, JSON and CSS, for SLICC.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasi-biome/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasi-biome",
  "keywords": [
    "wasm",
    "wasi",
    "slicc",
    "homescoop",
    "biome",
    "lint",
    "format"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
