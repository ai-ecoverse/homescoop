  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasi-biome/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasi-biome",
  "keywords": [
