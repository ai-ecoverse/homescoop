diff --git a/awscli/botocore/sigv4a.py b/awscli/botocore/sigv4a.py
new file mode 100644
index 0000000..7712d0b
--- /dev/null
+++ b/awscli/botocore/sigv4a.py
@@ -0,0 +1,169 @@
+# homescoop (slicc): SigV4a, AWS4-ECDSA-P256-SHA256, without awscrt.
+#
+# botocore signs SigV4a only through awscrt (botocore/crt/auth.py's
+# CrtSigV4AsymAuth and friends hand the whole request to awscrt.auth). Here
+# the signers are botocore's own SigV4 ones, which already build the canonical
+# request, with what SigV4a changes on top (the AWS signing spec; awscrt's
+# aws-c-auth implements the same):
+#
+#   - the algorithm is AWS4-ECDSA-P256-SHA256;
+#   - the credential scope has no region: <date>/<service>/aws4_request;
+#   - the region set (botocore passes it as the region, "*" for a
+#     multi-region access point) is signed, as the X-Amz-Region-Set header,
+#     or the X-Amz-Region-Set query parameter of a presigned URL;
+#   - the signature is an ECDSA P-256 signature (DER, in hex) of the string to
+#     sign's SHA-256, with a key derived from the credentials: NIST SP 800-108
+#     HMAC-SHA256 in counter mode, keyed with "AWS4A" + the secret key, over
+#     1 || "AWS4-ECDSA-P256-SHA256" || 0x00 || access key id || counter || 256,
+#     the first result k0 with k0 <= n - 2 (counter 1, 2, ...) giving the
+#     private key k0 + 1 (aws-c-auth's key_derivation.c).
+#
+# cert/sigv4a.mjs checks it against aws-c-auth's SigV4a test suite: the
+# derived public keys, the canonical requests, the strings to sign, and
+# signatures that verify with the suite's keys.
+import functools
+import hashlib
+import hmac
+
+from botocore.auth import (
+    S3SigV4Auth,
+    S3SigV4QueryAuth,
+    SigV4Auth,
+    SigV4QueryAuth,
+)
+from botocore.compat import urlsplit, urlunsplit
+from botocore.useragent import register_feature_id
+from botocore.utils import percent_encode_sequence
+
+ALGORITHM = 'AWS4-ECDSA-P256-SHA256'
+REGION_SET = 'X-Amz-Region-Set'
+# The order of P-256.
+_N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
+
+
+def _cryptography():
+    try:
+        from cryptography.hazmat.primitives import hashes
+        from cryptography.hazmat.primitives.asymmetric import ec
+    except ImportError as e:
+        from botocore.exceptions import MissingDependencyException
+
+        raise MissingDependencyException(
+            msg=(
+                'SigV4a signing needs cryptography (@ai-ecoverse/py-cryptography, '
+                'which this AWS CLI build installs beside it), and it could not '
+                f'be imported: {e}'
+            )
+        ) from None
+    return ec, hashes
+
+
+def derive_private_value(access_key, secret_key):
+    """The SigV4a private key (an integer) for a pair of credentials."""
+    secret = ('AWS4A' + secret_key).encode('utf-8')
+    for counter in range(1, 255):
+        fixed = (
+            b'\x00\x00\x00\x01'
+            + ALGORITHM.encode()
+            + b'\x00'
+            + access_key.encode('utf-8')
+            + bytes([counter])
+            + b'\x00\x00\x01\x00'
+        )
+        k0 = int.from_bytes(hmac.new(secret, fixed, hashlib.sha256).digest(), 'big')
+        if k0 <= _N - 2:
+            return k0 + 1
+    raise ValueError('SigV4a key derivation found no key')  # 2**-8000 or so
+
+
+@functools.lru_cache(maxsize=8)
+def derive_key(access_key, secret_key):
+    """The SigV4a key pair (cryptography's EllipticCurvePrivateKey)."""
+    ec, _ = _cryptography()
+    return ec.derive_private_key(derive_private_value(access_key, secret_key), ec.SECP256R1())
+
+
+class _SigV4Asym:
+    """What SigV4a changes in botocore's SigV4Auth (see the top of the file)."""
+
+    def add_auth(self, request):
+        register_feature_id('SIGV4A_SIGNING')
+        super().add_auth(request)
+
+    def credential_scope(self, request):
+        return '/'.join(
+            [request.context['timestamp'][0:8], self._service_name, 'aws4_request']
+        )
+
+    def scope(self, request):
+        return f'{self.credentials.access_key}/{self.credential_scope(request)}'
+
+    def string_to_sign(self, request, canonical_request):
+        return '\n'.join(
+            [
+                ALGORITHM,
+                request.context['timestamp'],
+                self.credential_scope(request),
+                hashlib.sha256(canonical_request.encode('utf-8')).hexdigest(),
+            ]
+        )
+
+    def signature(self, string_to_sign, request):
+        ec, hashes = _cryptography()
+        key = derive_key(self.credentials.access_key, self.credentials.secret_key)
+        return key.sign(string_to_sign.encode('utf-8'), ec.ECDSA(hashes.SHA256())).hex()
+
+
+class _SigV4AsymHeaders(_SigV4Asym):
+    def _modify_request_before_signing(self, request):
+        super()._modify_request_before_signing(request)
+        if REGION_SET in request.headers:
+            del request.headers[REGION_SET]
+        request.headers[REGION_SET] = self._region_name
+
+    def _inject_signature_to_request(self, request, signature):
+        signed = self.signed_headers(self.headers_to_sign(request))
+        request.headers['Authorization'] = (
+            f'{ALGORITHM} Credential={self.scope(request)}, '
+            f'SignedHeaders={signed}, Signature={signature}'
+        )
+        return request
+
+
+class _SigV4AsymQuery(_SigV4Asym):
+    def _modify_request_before_signing(self, request):
+        # SigV4QueryAuth puts its X-Amz-* parameters last; swap in the
+        # algorithm and add the region set (the canonical query is sorted).
+        super()._modify_request_before_signing(request)
+        p = urlsplit(request.url)
+        pairs = [
+            f'X-Amz-Algorithm={ALGORITHM}'
+            if pair == 'X-Amz-Algorithm=AWS4-HMAC-SHA256'
+            else pair
+            for pair in p.query.split('&')
+        ]
+        pairs.append(percent_encode_sequence({REGION_SET: self._region_name}))
+        request.url = urlunsplit((p[0], p[1], p[2], '&'.join(pairs), p[4]))
+
+
+class SigV4AsymAuth(_SigV4AsymHeaders, SigV4Auth):
+    """'v4a': SigV4a in the Authorization header."""
+
+
+class SigV4AsymQueryAuth(_SigV4AsymQuery, SigV4QueryAuth):
+    """A SigV4a presigned URL (as botocore.crt.auth's, which isn't mapped)."""
+
+
+class S3SigV4AsymAuth(_SigV4AsymHeaders, S3SigV4Auth):
+    """'s3v4a': S3's SigV4a (no path normalization, X-Amz-Content-SHA256)."""
+
+
+class S3SigV4AsymQueryAuth(_SigV4AsymQuery, S3SigV4QueryAuth):
+    """'s3v4a-query': a SigV4a presigned S3 URL (UNSIGNED-PAYLOAD)."""
+
+
+SIGV4A_AUTH_TYPE_MAPS = {
+    'v4a': SigV4AsymAuth,
+    's3v4a': S3SigV4AsymAuth,
+    's3v4a-query': S3SigV4AsymQueryAuth,
+}
