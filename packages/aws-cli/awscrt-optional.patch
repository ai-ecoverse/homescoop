diff --git a/awscli/botocore/crc.py b/awscli/botocore/crc.py
new file mode 100644
index 0000000..166c5a9
--- /dev/null
+++ b/awscli/botocore/crc.py
@@ -0,0 +1,111 @@
+# homescoop (slicc): pure-Python CRC32C and CRC64NVME, and CRC combining,
+# for when awscrt is not available (botocore.compat.HAS_CRT is False).
+#
+# The functions take and return the same values as awscrt.checksums:
+# crc32c(data, previous_crc32c=0) and crc64nvme(data, previous_crc64nvme=0)
+# continue a running checksum the way zlib.crc32 does, and
+# combine_*(crc1, crc2, len2) give the checksum of A + B from the checksums
+# of A and B and the length of B.
+#
+#   CRC-32C    (Castagnoli) reflected poly 0x82F63B78, init/xorout 0xFFFFFFFF
+#   CRC-64/NVME             reflected poly 0x9A6C9329AC4BC9B5,
+#                           init/xorout 0xFFFFFFFFFFFFFFFF
+#   CRC-32     (zlib)       reflected poly 0xEDB88320, init/xorout 0xFFFFFFFF
+#
+# Check values ("123456789"): CRC-32C 0xE3069283, CRC-64/NVME
+# 0xAE8B14860A799888, CRC-32 0xCBF43926.
+from binascii import crc32 as _zlib_crc32
+
+_CRC32_POLY = 0xEDB88320
+_CRC32C_POLY = 0x82F63B78
+_CRC64NVME_POLY = 0x9A6C9329AC4BC9B5
+_MASK32 = 0xFFFFFFFF
+_MASK64 = 0xFFFFFFFFFFFFFFFF
+
+
+def _table(poly):
+    table = []
+    for n in range(256):
+        c = n
+        for _ in range(8):
+            c = (c >> 1) ^ poly if c & 1 else c >> 1
+        table.append(c)
+    return tuple(table)
+
+
+_CRC32C_TABLE = _table(_CRC32C_POLY)
+_CRC64NVME_TABLE = _table(_CRC64NVME_POLY)
+
+
+def _update(table, mask, data, crc):
+    crc = (crc & mask) ^ mask
+    for b in memoryview(data).cast('B'):
+        crc = table[(crc ^ b) & 0xFF] ^ (crc >> 8)
+    return crc ^ mask
+
+
+def crc32c(data, previous_crc32c=0):
+    return _update(_CRC32C_TABLE, _MASK32, data, previous_crc32c)
+
+
+def crc64nvme(data, previous_crc64nvme=0):
+    return _update(_CRC64NVME_TABLE, _MASK64, data, previous_crc64nvme)
+
+
+def crc32(data, previous_crc32=0):
+    return _zlib_crc32(data, previous_crc32) & _MASK32
+
+
+# Combining, as zlib's crc32_combine: the register of A advanced over len2
+# zero bytes (a linear map over GF(2), applied as a matrix and squared for
+# each bit of the length), then xor the checksum of B. The init and xorout
+# terms cancel, so the same holds for the conditioned values.
+def _gf2_times(mat, vec):
+    s = 0
+    i = 0
+    while vec:
+        if vec & 1:
+            s ^= mat[i]
+        vec >>= 1
+        i += 1
+    return s
+
+
+def _gf2_square(mat):
+    return [_gf2_times(mat, m) for m in mat]
+
+
+def _combine(poly, width, crc1, crc2, len2):
+    if len2 <= 0:
+        return crc1
+    # The operator for one zero bit, then two, then four.
+    odd = [poly] + [1 << n for n in range(width - 1)]
+    even = _gf2_square(odd)
+    odd = _gf2_square(even)
+    while True:
+        # Each pass applies a square of the operator: 1, 2, 4, ... zero bytes.
+        even = _gf2_square(odd)
+        if len2 & 1:
+            crc1 = _gf2_times(even, crc1)
+        len2 >>= 1
+        if not len2:
+            break
+        odd = _gf2_square(even)
+        if len2 & 1:
+            crc1 = _gf2_times(odd, crc1)
+        len2 >>= 1
+        if not len2:
+            break
+    return crc1 ^ crc2
+
+
+def combine_crc32(crc1, crc2, len2):
+    return _combine(_CRC32_POLY, 32, crc1, crc2, len2)
+
+
+def combine_crc32c(crc1, crc2, len2):
+    return _combine(_CRC32C_POLY, 32, crc1, crc2, len2)
+
+
+def combine_crc64nvme(crc1, crc2, len2):
+    return _combine(_CRC64NVME_POLY, 64, crc1, crc2, len2)
