+MagickExport int HomescoopPrepareReplace(int file,const char *target,
+  struct stat *target_status)
+{
+  int
+    mode;
+
+  struct stat
+    link_status,
+    temp_status;
+
+  mode=0;
+  if (lstat(target,&link_status) != 0)
+    return(-1);
+  if (S_ISLNK(link_status.st_mode))
+    {
+      if (stat(target,target_status) != 0)
+        return(-1);
+      mode=2;
+    }
+  else
+    *target_status=link_status;
+  if (S_ISREG(target_status->st_mode) == 0)
+    return(-1);
+  if ((mode == 0) && (target_status->st_nlink > 1))
+    mode=1;
+  if (mode != 0)
+    return(mode);
+  if (fstat(file,&temp_status) != 0)
+    return(1);
+  if (((temp_status.st_uid != target_status->st_uid) ||
+       (temp_status.st_gid != target_status->st_gid)) &&
+      (fchown(file,target_status->st_uid,target_status->st_gid) != 0))
+    return(1);
+  if ((fchmod(file,target_status->st_mode & 07777) != 0) ||
+      (fstat(file,&temp_status) != 0) ||
+      (temp_status.st_uid != target_status->st_uid) ||
+      (temp_status.st_gid != target_status->st_gid) ||
+      ((temp_status.st_mode & 07777) != (target_status->st_mode & 07777)))
+    return(1);
+  return(0);
+}
+
+MagickExport int HomescoopReplaceFile(const char *temp,const char *target,
+  const struct stat *target_status,int mode)
+{
+  char
+    buffer[65536];
+
+  int
+    in,
+    out,
+    saved;
+
+  MagickOffsetType
+    total;
+
+  ssize_t
+    count,
+    done,
+    n;
+
+  struct stat
+    now;
+
+  if (mode == 0)
+    {
+      if ((lstat(target,&now) != 0) || (S_ISREG(now.st_mode) == 0) ||
+          (now.st_dev != target_status->st_dev) ||
+          (now.st_ino != target_status->st_ino))
+        {
+          (void) remove_utf8(temp);
+          errno=EBUSY;
+          return(-1);
+        }
+      if (rename_utf8(temp,target) != 0)
+        {
+          saved=errno;
+          (void) remove_utf8(temp);
+          errno=saved;
+          return(-1);
+        }
+      return(0);
+    }
+  in=open_utf8(temp,O_RDONLY | O_BINARY,0);
+  if (in < 0)
+    {
+      saved=errno;
+      (void) remove_utf8(temp);
+      errno=saved;
+      return(-1);
+    }
+  out=open_utf8(target,O_WRONLY | O_BINARY | (mode == 1 ? O_NOFOLLOW : 0),0);
+  if ((out < 0) || (fstat(out,&now) != 0) || (S_ISREG(now.st_mode) == 0) ||
+      (now.st_dev != target_status->st_dev) ||
+      (now.st_ino != target_status->st_ino))
+    {
+      saved=(out < 0) ? errno : EBUSY;
+      if (out >= 0)
+        (void) close_utf8(out);
+      (void) close_utf8(in);
+      (void) remove_utf8(temp);
+      errno=saved;
+      return(-1);
+    }
+  total=0;
+  saved=0;
+  for ( ; ; )
+  {
+    count=read(in,buffer,sizeof(buffer));
+    if (count < 0)
+      {
+        if (errno == EINTR)
+          continue;
+        saved=errno;
+        break;
+      }
+    if (count == 0)
+      break;
+    for (done=0; done < count; done+=n)
+    {
+      n=write(out,buffer+done,(size_t) (count-done));
+      if (n < 0)
+        {
+          if (errno == EINTR)
+            {
+              n=0;
+              continue;
+            }
+          saved=errno;
+          break;
+        }
+    }
+    if (saved != 0)
+      break;
+    total+=count;
+  }
+  if ((saved == 0) && (ftruncate(out,(off_t) total) != 0))
+    saved=errno;
+  if ((close_utf8(out) != 0) && (saved == 0))
+    saved=errno;
+  (void) close_utf8(in);
+  (void) remove_utf8(temp);
+  if (saved != 0)
+    {
+      errno=saved;
+      return(-1);
+    }
+  return(0);
+}
