--- a/MagickCore/constitute.c
+++ b/MagickCore/constitute.c
@@ -75,6 +75,7 @@
 #include "MagickCore/semaphore.h"
 #include "MagickCore/statistic.h"
 #include "MagickCore/stream.h"
+#include "MagickCore/random_.h"
 #include "MagickCore/string_.h"
 #include "MagickCore/string-private.h"
 #include "MagickCore/timer.h"
@@ -1590,12 +1591,26 @@
   Image
     *p;
 
+  char
+    atomic_path[MagickPathExtent],
+    atomic_tmp[MagickPathExtent],
+    atomic_name[MagickPathExtent];
+
+  struct stat
+    atomic_status;
+
+  MagickBooleanType
+    atomic_existed;
+
   assert(image_info != (const ImageInfo *) NULL);
   assert(image_info->signature == MagickCoreSignature);
   assert(images != (Image *) NULL);
   assert(images->signature == MagickCoreSignature);
   if (IsEventLogging() != MagickFalse)
     (void) LogMagickEvent(TraceEvent,GetMagickModule(),"%s",images->filename);
+  *atomic_tmp='\0';
+  *atomic_name='\0';
+  atomic_existed=MagickFalse;
   assert(exception != (ExceptionInfo *) NULL);
   write_info=CloneImageInfo(image_info);
   *write_info->magick='\0';
@@ -1613,6 +1628,124 @@
   sans_exception=DestroyExceptionInfo(sans_exception);
   if (*write_info->magick == '\0')
     (void) CopyMagickString(write_info->magick,images->magick,MagickPathExtent);
+  /*
+    homescoop#562: write a single output file to a temporary file beside it
+    and rename it over the target only once the write succeeded, so a failed
+    write never leaves a truncated file or clobbers an existing one. Only for
+    the single-file raster coders below, named by the target's extension or
+    by the same explicit prefix: never for registers (mpr:), coders that
+    write companion files or display, unknown prefixes, formats without an
+    encoder, or a target the user may not write (homescoop#1244, #1245,
+    #1207), which all keep upstream's direct write.
+  */
+  (void) CopyMagickString(atomic_path,write_info->filename,MagickPathExtent);
+  {
+    static const char
+      *atomic_modules[] = { "PNG", "JPEG", "WEBP", "GIF", "TIFF", "BMP",
+        "PNM", "HEIC", "JXL", "JP2", "QOI", "TGA", "ICON", "PSD",
+        (const char *) NULL };
+
+    const MagickInfo
+      *atomic_info;
+
+    ExceptionInfo
+      *atomic_exception;
+
+    const char
+      *colon,
+      *module;
+
+    MagickBooleanType
+      atomic_ok;
+
+    ssize_t
+      k;
+
+    atomic_exception=AcquireExceptionInfo();
+    atomic_info=GetMagickInfo(write_info->magick,atomic_exception);
+    atomic_exception=DestroyExceptionInfo(atomic_exception);
+    atomic_ok=MagickFalse;
+    if ((atomic_info != (const MagickInfo *) NULL) &&
+        (GetImageEncoder(atomic_info) != (EncodeImageHandler *) NULL))
+      {
+        module=GetMagickModuleName(atomic_info);
+        for (k=0; atomic_modules[k] != (const char *) NULL; k++)
+          if ((module != (const char *) NULL) &&
+              (LocaleCompare(module,atomic_modules[k]) == 0))
+            atomic_ok=MagickTrue;
+      }
+    colon=strchr(images->filename,':');
+    if ((colon != (const char *) NULL) && (atomic_ok != MagickFalse))
+      {
+        char
+          prefix[MagickPathExtent];
+
+        (void) CopyMagickString(prefix,images->filename,(size_t)
+          (colon-images->filename+1));
+        if ((LocaleCompare(prefix,write_info->magick) != 0) ||
+            (LocaleCompare(colon+1,atomic_path) != 0))
+          atomic_ok=MagickFalse;
+      }
+    if ((atomic_ok != MagickFalse) &&
+        ((strchr(atomic_path,':') != (char *) NULL) ||
+         ((access_utf8(atomic_path,F_OK) == 0) &&
+          (access_utf8(atomic_path,W_OK) != 0))))
+      atomic_ok=MagickFalse;
+    if ((atomic_ok != MagickFalse) &&
+      (write_info->blob == (void *) NULL) && (write_info->file == (FILE *) NULL) &&
+      ((GetImageListLength(images) == 1) || (write_info->adjoin != MagickFalse)) &&
+      (*atomic_path != '\0') && (LocaleCompare(atomic_path,"-") != 0) &&
+      (*atomic_path != '|') && (strchr(atomic_path,'%') == (char *) NULL) &&
+      (strlen(atomic_path) < (MagickPathExtent-16)) &&
+      ((lstat(atomic_path,&atomic_status) != 0 && errno == ENOENT) ||
+       (lstat(atomic_path,&atomic_status) == 0 && S_ISREG(atomic_status.st_mode))))
+    {
+      RandomInfo
+        *random_info;
+
+      ssize_t
+        j;
+
+      int
+        file = -1;
+
+      atomic_existed=lstat(atomic_path,&atomic_status) == 0 ? MagickTrue :
+        MagickFalse;
+      random_info=AcquireRandomInfo();
+      for (j=0; j < 64; j++)
+      {
+        StringInfo
+          *key_info;
+
+        unsigned char
+          *key_bytes;
+
+        key_info=GetRandomKey(random_info,4);
+        if (key_info == (StringInfo *) NULL)
+          break;
+        key_bytes=GetStringInfoDatum(key_info);
+        (void) FormatLocaleString(atomic_tmp,MagickPathExtent,
+          "%s.%02x%02x%02x%02x~",atomic_path,key_bytes[0],key_bytes[1],
+          key_bytes[2],key_bytes[3]);
+        key_info=DestroyStringInfo(key_info);
+        file=open_utf8(atomic_tmp,O_RDWR | O_CREAT | O_EXCL | O_BINARY,0666);
+        if ((file >= 0) || (errno != EEXIST))
+          break;
+      }
+      random_info=DestroyRandomInfo(random_info);
+      if (file < 0)
+        *atomic_tmp='\0';
+      else
+        {
+          (void) close_utf8(file);
+          (void) CopyMagickString(atomic_name,images->filename,
+            MagickPathExtent);
+          for (p=images; p != (Image *) NULL; p=GetNextImageInList(p))
+            (void) FormatLocaleString(p->filename,MagickPathExtent,"%s:%s",
+              write_info->magick,atomic_tmp);
+        }
+    }
+  }
   p=images;
   for ( ; GetNextImageInList(p) != (Image *) NULL; p=GetNextImageInList(p))
   {
@@ -1661,5 +1794,27 @@
       }
   }
   write_info=DestroyImageInfo(write_info);
+  if (*atomic_tmp != '\0')
+    {
+      for (p=images; p != (Image *) NULL; p=GetNextImageInList(p))
+        (void) CopyMagickString(p->filename,atomic_name,MagickPathExtent);
+      if ((status != 0) && (exception->severity < ErrorException))
+        {
+          if (atomic_existed != MagickFalse)
+            (void) chmod(atomic_tmp,atomic_status.st_mode & 07777);
+          if (rename_utf8(atomic_tmp,atomic_path) != 0)
+            {
+              (void) remove_utf8(atomic_tmp);
+              ThrowFileException(exception,FileOpenError,"UnableToWriteFile",
+                atomic_path);
+              status=0;
+            }
+        }
+      else
+        {
+          (void) remove_utf8(atomic_tmp);
+          status=0;
+        }
+    }
   return(status != 0 ? MagickTrue : MagickFalse);
 }
