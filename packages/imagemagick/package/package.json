{
  "name": "@ai-ecoverse/wasm-imagemagick",
  "version": "7.1.2-32-3",
  "description": "ImageMagick 7.1.2-32 magick CLI for wasm / slicc (emscripten)",
  "license": "ImageMagick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/imagemagick/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/imagemagick",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "imagemagick",
    "magick",
    "convert"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "etc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "imagemagick",
    "upstream": "7.1.2-32"
  },
  "slicc": {
    "abi": "emscripten",
    "env": {
      "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
    },
    "commands": {
      "magick": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "convert": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "convert",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "identify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "identify",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      },
      "mogrify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "mogrify",
        "env": {
          "MAGICK_CONFIGURE_PATH": "etc/ImageMagick-7"
        }
      }
    }
  }
}
