{
  "name": "@ai-ecoverse/wasm-imagemagick",
  "version": "0.0.0",
  "description": "ImageMagick (slicc ladder utilities/magick) (WASM / emscripten) — name reservation stub; real artifacts TBD",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/imagemagick/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/imagemagick",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "imagemagick"
  ],
  "files": [
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "imagemagick",
    "upstream": "7.1.2-31"
  },
  "slicc": {
    "abi": "emscripten",
    "commands": {
      "magick": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm"
      },
      "convert": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "convert"
      },
      "identify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "identify"
      },
      "mogrify": {
        "glue": "bin/magick",
        "wasm": "bin/magick.wasm",
        "argv0": "mogrify"
      }
    }
  }
}
