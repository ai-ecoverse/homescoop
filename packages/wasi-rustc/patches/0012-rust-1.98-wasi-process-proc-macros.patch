+//! Proc macros as separate processes, for hosts without `dlopen` (WASI).
+//!
+//! On WASI a proc-macro crate is linked as a program whose entry point is
+//! [`serve`]. The compiler starts it as a child process and relays the
+//! bridge's RPC buffers over the child's stdin and stdout: the macro runs
+//! in the child, and every call it makes into the compiler comes back over
+//! the pipe as a buffer for the compiler's dispatcher. Handles stay the
+//! compiler's, so spans and hygiene are exactly as with a dylib.
+//!
+//! Frames start with [`MAGIC`]. Bytes before it are a macro's own output
+//! to stdout and go to stderr. A panic aborts the child (WASI has no
+//! unwinding); its hook sends the message first, and the compiler reports
+//! it as the macro's panic.
+
+use std::io::{self, BufRead, BufReader, Write};
+use std::fs::File;
+use std::panic;
+use std::sync::{Arc, Mutex};
+
+use super::client::Client;
+use super::{BridgeConfig, Buffer, Encode, PanicMessage, closure};
+
+const MAGIC: [u8; 4] = *b"\0PMB";
+/// Child to compiler: the number of macros, as a `u32`.
+const HELLO: u8 = 0;
+/// Compiler to child: macro index (`u32`), force-show-panics (`u8`), input buffer.
+const EXPAND: u8 = 1;
+/// Child to compiler: a request buffer for the dispatcher.
+const CALL: u8 = 2;
+/// Compiler to child: the dispatcher's reply.
+const REPLY: u8 = 3;
+/// Child to compiler: the macro's output buffer.
+const DONE: u8 = 4;
+/// Child to compiler: a panic message, sent before the child aborts.
+const PANIC: u8 = 5;
+
+fn write_frame(w: &mut impl Write, tag: u8, body: &[u8]) -> io::Result<()> {
+    let mut frame = Vec::with_capacity(MAGIC.len() + 5 + body.len());
+    frame.extend_from_slice(&MAGIC);
+    frame.push(tag);
+    frame.extend_from_slice(&(body.len() as u32).to_le_bytes());
+    frame.extend_from_slice(body);
+    w.write_all(&frame)?;
+    w.flush()
+}
+
+/// Reads up to and including the next [`MAGIC`]; what came before it goes to `stray`.
+fn skip_to_magic(r: &mut impl BufRead, stray: &mut Vec<u8>) -> io::Result<()> {
+    let mut matched = 0;
+    while matched < MAGIC.len() {
+        let mut byte = [0u8];
+        r.read_exact(&mut byte)?;
+        if byte[0] == MAGIC[matched] {
+            matched += 1;
+        } else {
+            stray.extend_from_slice(&MAGIC[..matched]);
+            matched = usize::from(byte[0] == MAGIC[0]);
+            if matched == 0 {
+                stray.push(byte[0]);
+            }
+        }
+    }
+    Ok(())
+}
+
+fn read_frame(r: &mut impl BufRead) -> io::Result<(u8, Vec<u8>)> {
+    let mut stray = Vec::new();
+    let found = skip_to_magic(r, &mut stray);
+    if !stray.is_empty() {
+        let _ = io::stderr().write_all(&stray);
+    }
+    found?;
+    let mut head = [0u8; 5];
+    r.read_exact(&mut head)?;
+    let mut body = vec![0u8; u32::from_le_bytes([head[1], head[2], head[3], head[4]]) as usize];
+    r.read_exact(&mut body)?;
+    Ok((head[0], body))
+}
+
+/// The entry point of a proc-macro program: serves its macros on stdin and
+/// stdout until the compiler closes stdin.
+pub fn serve(clients: &[Client]) {
+    // The bridge's hook (which hides panic output during expansion) goes
+    // under this one, which reports the panic and ends the process: WASI
+    // cannot unwind, and an abort would trap.
+    super::client::maybe_install_panic_hook(false);
+    let prev = panic::take_hook();
+    panic::set_hook(Box::new(move |info| {
+        let message = info.payload_as_str().unwrap_or("Box<dyn Any>");
+        let _ = write_frame(&mut io::stdout().lock(), PANIC, message.as_bytes());
+        prev(info);
+        std::process::exit(101);
+    }));
+    let mut input = io::stdin().lock();
+    let count = clients.len() as u32;
+    if write_frame(&mut io::stdout().lock(), HELLO, &count.to_le_bytes()).is_err() {
+        return;
+    }
+    while let Ok((EXPAND, body)) = read_frame(&mut input) {
+        let Some(client) = body.get(..4).and_then(|index| {
+            clients.get(u32::from_le_bytes(index.try_into().unwrap()) as usize)
+        }) else {
+            return;
+        };
+        let force_show_panics = body.get(4) == Some(&1);
+        let mut dispatch = |request: Buffer| -> Buffer {
+            let reply = write_frame(&mut io::stdout().lock(), CALL, &request)
+                .and_then(|()| read_frame(&mut input));
+            match reply {
+                Ok((REPLY, reply)) => Buffer::from(reply),
+                _ => std::process::exit(1),
+            }
+        };
+        let output = (client.run)(BridgeConfig {
+            input: Buffer::from(body[5..].to_vec()),
+            dispatch: (&mut dispatch).into(),
+            force_show_panics,
+        });
+        if write_frame(&mut io::stdout().lock(), DONE, &output).is_err() {
+            return;
+        }
+    }
+}
+
+/// Starts a proc-macro program: returns its stdout (to read) and its stdin
+/// (to write).
+pub type Spawn = Box<dyn FnMut() -> io::Result<(File, File)> + Send>;
+
+struct Server {
+    spawn: Spawn,
+    child: Option<(BufReader<File>, File)>,
+}
+
+impl Server {
+    fn start(spawn: &mut Spawn) -> io::Result<(u32, (BufReader<File>, File))> {
+        let (stdout, stdin) = spawn()?;
+        let mut stdout = BufReader::new(stdout);
+        match read_frame(&mut stdout)? {
+            (HELLO, count) if count.len() == 4 => {
+                Ok((u32::from_le_bytes(count.try_into().unwrap()), (stdout, stdin)))
+            }
+            _ => Err(io::Error::other("not a proc-macro program")),
+        }
+    }
+
+    fn expand(
+        &mut self,
+        index: u32,
+        force_show_panics: bool,
+        input: &[u8],
+        dispatch: &mut closure::Closure<'_>,
+    ) -> Result<Buffer, String> {
+        if self.child.is_none() {
+            let (_, child) = Self::start(&mut self.spawn)
+                .map_err(|e| format!("cannot restart the proc-macro process: {e}"))?;
+            self.child = Some(child);
+        }
+        let (stdout, stdin) = self.child.as_mut().unwrap();
+        let mut body = Vec::with_capacity(5 + input.len());
+        body.extend_from_slice(&index.to_le_bytes());
+        body.push(u8::from(force_show_panics));
+        body.extend_from_slice(input);
+        let lost = |e: io::Error| format!("lost the proc-macro process: {e}");
+        write_frame(stdin, EXPAND, &body).map_err(lost)?;
+        let mut panicked = None;
+        loop {
+            match read_frame(stdout) {
+                Ok((CALL, request)) => {
+                    let reply = dispatch.call(Buffer::from(request));
+                    write_frame(stdin, REPLY, &reply).map_err(lost)?;
+                }
+                Ok((DONE, output)) => return Ok(Buffer::from(output)),
+                Ok((PANIC, message)) => {
+                    panicked = Some(String::from_utf8_lossy(&message).into_owned());
+                }
+                Ok(_) => return Err("unexpected message from the proc-macro process".into()),
+                Err(e) => return Err(panicked.unwrap_or_else(|| lost(e))),
+            }
+        }
+    }
+}
+
+struct Remote {
+    server: Arc<Mutex<Server>>,
+    index: u32,
+}
+
+static REMOTES: Mutex<Vec<Remote>> = Mutex::new(Vec::new());
+
+/// Starts a proc-macro program and returns a client for each of its macros.
+/// The program stays running for the session and is restarted after a panic.
+pub fn clients(mut spawn: Spawn) -> io::Result<&'static [Client]> {
+    let (count, child) = Server::start(&mut spawn)?;
+    let server = Arc::new(Mutex::new(Server { spawn, child: Some(child) }));
+    let mut remotes = REMOTES.lock().unwrap();
+    let first = remotes.len();
+    if first + count as usize > TRAMPOLINES.len() {
+        return Err(io::Error::other("too many proc macros in one compiler session"));
+    }
+    let clients = (0..count)
+        .map(|index| {
+            remotes.push(Remote { server: Arc::clone(&server), index });
+            Client { run: TRAMPOLINES[first + index as usize] }
+        })
+        .collect::<Vec<_>>();
+    Ok(clients.leak())
+}
+
+fn panic_buffer(message: String) -> Buffer {
+    let mut buf = Buffer::new();
+    Result::<(), PanicMessage>::Err(PanicMessage::String(message)).encode(&mut buf, &mut ());
+    buf
+}
+
+fn run_remote(slot: usize, config: BridgeConfig<'_>) -> Buffer {
+    let BridgeConfig { input, mut dispatch, force_show_panics } = config;
+    let (server, index) = {
+        let remotes = REMOTES.lock().unwrap();
+        (Arc::clone(&remotes[slot].server), remotes[slot].index)
+    };
+    let Ok(mut server) = server.try_lock() else {
+        return panic_buffer("nested expansion of a process proc macro is not supported".into());
+    };
+    server.expand(index, force_show_panics, &input, &mut dispatch).unwrap_or_else(|message| {
+        server.child = None;
+        panic_buffer(message)
+    })
+}
+
+// A client is only a function pointer, so each process-backed macro needs a
+// function of its own: one per slot.
+extern "C" fn trampoline<const SLOT: usize>(config: BridgeConfig<'_>) -> Buffer {
+    run_remote(SLOT, config)
+}
+
+static TRAMPOLINES: [extern "C" fn(BridgeConfig<'_>) -> Buffer; 256] = [
