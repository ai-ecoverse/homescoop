+mod wasix {
+    use std::ffi::CString;
+    use std::fs::File;
+    use std::io;
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::wasi::ffi::OsStrExt;
+    use std::path::Path;
+
+    #[link(wasm_import_module = "wasix_32v1")]
+    unsafe extern "C" {
+        fn fd_pipe(read: *mut u32, write: *mut u32) -> u16;
+        fn proc_spawn3(
+            name: *const u8,
+            name_len: u32,
+            argv: *const *const u8,
+            argc: u32,
+            env: *const *const u8,
+            envc: u32,
+            ops: *const u8,
+            op_count: u32,
+            signal: u32,
+            priority: u32,
+            search: u32,
+            path: *const u8,
+            path_len: u32,
+            pid: *mut u32,
+        ) -> u16;
+    }
+
+    /// A pipe's read and write ends.
+    fn pipe() -> io::Result<(File, File)> {
+        let (mut read, mut write) = (0, 0);
+        match unsafe { fd_pipe(&mut read, &mut write) } {
+            0 => unsafe { Ok((File::from_raw_fd(read as i32), File::from_raw_fd(write as i32))) },
+            errno => Err(io::Error::from_raw_os_error(errno.into())),
+        }
+    }
+
+    /// `__wasi_proc_spawn_fd_op_t` dup2: `fd` becomes a copy of `src`.
+    fn dup2(fd: u32, src: &File) -> [u8; 56] {
+        let mut op = [0u8; 56];
+        op[0] = 1;
+        op[4..8].copy_from_slice(&fd.to_le_bytes());
+        op[8..12].copy_from_slice(&(src.as_raw_fd() as u32).to_le_bytes());
+        op
+    }
+
+    /// Starts `program` with pipes on its stdin and stdout; returns its
+    /// stdout (to read) and its stdin (to write). stderr is inherited.
+    pub(super) fn spawn_piped(program: &Path) -> io::Result<(File, File)> {
+        let name = program.as_os_str().as_bytes();
+        let argv0 = CString::new(name).map_err(io::Error::other)?;
+        let argv = [argv0.as_ptr().cast::<u8>()];
+        let env: Vec<CString> = std::env::vars_os()
+            .filter_map(|(key, value)| {
+                let mut entry = key.as_bytes().to_vec();
+                entry.push(b'=');
+                entry.extend_from_slice(value.as_bytes());
+                CString::new(entry).ok()
+            })
+            .collect();
+        let envp: Vec<*const u8> = env.iter().map(|entry| entry.as_ptr().cast()).collect();
+        let (child_in, to_child) = pipe()?;
+        let (from_child, child_out) = pipe()?;
+        let ops = [dup2(0, &child_in), dup2(1, &child_out)];
+        let mut pid = 0;
+        let errno = unsafe {
+            proc_spawn3(
+                name.as_ptr(),
+                name.len() as u32,
+                argv.as_ptr(),
+                1,
+                envp.as_ptr(),
+                envp.len() as u32,
+                ops.as_ptr().cast(),
+                ops.len() as u32,
+                0,
+                0,
+                0,
+                [].as_ptr(),
+                0,
+                &mut pid,
+            )
+        };
+        // The child has its own copies; the compiler keeps only its ends.
+        drop((child_in, child_out));
+        match errno {
+            0 => Ok((from_child, to_child)),
+            errno => Err(io::Error::from_raw_os_error(errno.into())),
+        }
+    }
+}
