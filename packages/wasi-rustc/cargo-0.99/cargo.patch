diff --git a/src/cargo/util/network/http_async_wasi.rs b/src/cargo/util/network/http_async_wasi.rs
new file mode 100644
index 0000000..00ecb57
--- /dev/null
+++ b/src/cargo/util/network/http_async_wasi.rs
@@ -0,0 +1,449 @@
+//! SLICC: Cargo's HTTP client on WASI, where there is no libcurl.
+//!
+//! Every request goes as plain HTTP/1.1 to the realm's proxy, the one
+//! `https_proxy` / `http_proxy` name (or `http.proxy`), in absolute form:
+//! `GET https://index.crates.io/se/rd/serde HTTP/1.1`. The proxy fetches it
+//! and does the TLS itself, so Cargo needs no TLS stack. The proxy is
+//! reached over a WASIX socket (`sock_open` + `sock_connect`); only
+//! loopback addresses resolve in the realm.
+//!
+//! Requests run one at a time on one kept-alive connection. Bodies come
+//! back chunked or with a length; redirects are followed.
+
+use std::fs::File;
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::os::fd::FromRawFd;
+use std::str::FromStr;
+use std::sync::Mutex;
+
+use tracing::debug;
+
+use crate::util::network::http::HandleConfiguration;
+
+type Response = http::Response<Vec<u8>>;
+type Request = http::Request<Vec<u8>>;
+type HttpResult<T> = std::result::Result<T, Error>;
+
+const MAX_REDIRECTS: usize = 10;
+
+#[derive(Debug, Clone, thiserror::Error)]
+#[non_exhaustive]
+pub enum Error {
+    #[error(
+        "no HTTP proxy is set: in the SLICC realm, network access goes through \
+         its proxy (https_proxy / http_proxy); without it, use --offline"
+    )]
+    NoProxy,
+    #[error("the realm's HTTP proxy `{0}` must be an http:// URL on a loopback address")]
+    BadProxy(String),
+    #[error("cannot reach the realm's HTTP proxy at {addr}: {message}")]
+    Connect { addr: String, message: String },
+    #[error("lost the connection to the realm's HTTP proxy: {0}")]
+    Io(String),
+    #[error("malformed response from the realm's HTTP proxy: {0}")]
+    Protocol(String),
+    #[error("too many redirects fetching `{0}`")]
+    TooManyRedirects(String),
+    #[error("failed to convert header value of `{name}` to string: {bytes:?}")]
+    BadHeader { name: String, bytes: Vec<u8> },
+}
+
+impl Error {
+    /// A dropped or refused connection is worth a retry.
+    pub fn is_spurious(&self) -> bool {
+        matches!(self, Error::Io(_) | Error::Connect { .. })
+    }
+}
+
+fn io_error(e: io::Error) -> Error {
+    Error::Io(e.to_string())
+}
+
+mod wasix {
+    #[link(wasm_import_module = "wasix_32v1")]
+    unsafe extern "C" {
+        pub fn sock_open(af: u32, socktype: u32, proto: u32, fd: *mut u32) -> u16;
+        pub fn sock_connect(fd: u32, addr: *const u8) -> u16;
+    }
+}
+
+/// A TCP connection to `127.x.y.z:port` in the realm's loopback namespace.
+fn connect(ip: [u8; 4], port: u16) -> io::Result<File> {
+    let mut fd = 0u32;
+    // AF_INET = 1, SOCK_STREAM = 1
+    let errno = unsafe { wasix::sock_open(1, 1, 0, &mut fd) };
+    if errno != 0 {
+        return Err(io::Error::from_raw_os_error(errno.into()));
+    }
+    // SAFETY: `sock_open` returned a new descriptor that we now own.
+    let file = unsafe { File::from_raw_fd(fd as i32) };
+    // __wasi_addr_port_t: family tag, then at 2 the port (little-endian)
+    // and at 4 the IPv4 address.
+    let mut addr = [0u8; 110];
+    addr[0] = 1;
+    addr[2..4].copy_from_slice(&port.to_le_bytes());
+    addr[4..8].copy_from_slice(&ip);
+    let errno = unsafe { wasix::sock_connect(fd, addr.as_ptr()) };
+    if errno != 0 {
+        return Err(io::Error::from_raw_os_error(errno.into()));
+    }
+    Ok(file)
+}
+
+/// The proxy's address from `http://host:port[/]`.
+fn proxy_addr(proxy: &str) -> HttpResult<([u8; 4], u16)> {
+    let bad = || Error::BadProxy(proxy.to_string());
+    let rest = proxy.strip_prefix("http://").unwrap_or(proxy);
+    let authority = rest.split('/').next().unwrap_or_default();
+    let authority = authority.rsplit('@').next().unwrap_or_default();
+    let (host, port) = match authority.rsplit_once(':') {
+        Some((host, port)) => (host, port.parse::<u16>().map_err(|_| bad())?),
+        None => (authority, 80),
+    };
+    let ip = if host == "localhost" {
+        [127, 0, 0, 1]
+    } else {
+        let parts: Vec<u8> = host.split('.').filter_map(|p| p.parse().ok()).collect();
+        <[u8; 4]>::try_from(parts).map_err(|_| bad())?
+    };
+    if ip[0] != 127 {
+        return Err(bad());
+    }
+    Ok((ip, port))
+}
+
+struct Connection {
+    stream: BufReader<File>,
+    /// Whether this connection already carried a request.
+    used: bool,
+}
+
+pub struct Client {
+    handle_config: HandleConfiguration,
+    connection: Mutex<Option<Connection>>,
+}
+
+impl std::fmt::Debug for Client {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("http_async::Client").finish()
+    }
+}
+
+impl Client {
+    pub fn new(handle_config: HandleConfiguration) -> Client {
+        Client {
+            handle_config,
+            connection: Mutex::new(None),
+        }
+    }
+
+    pub fn request_blocking(&self, request: Request) -> HttpResult<Response> {
+        self.send(request)
+    }
+
+    pub async fn request(&self, request: Request) -> HttpResult<Response> {
+        self.send(request)
+    }
+
+    /// Bytes still to download; requests here complete before they return.
+    pub fn bytes_pending(&self) -> u64 {
+        0
+    }
+
+    fn proxy(&self) -> HttpResult<String> {
+        if let Some(proxy) = &self.handle_config.proxy {
+            return Ok(proxy.clone());
+        }
+        for var in ["https_proxy", "HTTPS_PROXY", "http_proxy", "HTTP_PROXY"] {
+            if let Ok(value) = std::env::var(var) {
+                if !value.is_empty() {
+                    return Ok(value);
+                }
+            }
+        }
+        Err(Error::NoProxy)
+    }
+
+    fn send(&self, request: Request) -> HttpResult<Response> {
+        let (ip, port) = proxy_addr(&self.proxy()?)?;
+        let (parts, body) = request.into_parts();
+        let mut url = parts.uri.to_string();
+        let mut method = parts.method.clone();
+        let mut body = body;
+        for _ in 0..=MAX_REDIRECTS {
+            debug!(target: "network::fetch", url);
+            let head = self.request_head(&method, &url, &parts.headers, body.len())?;
+            let response = self.exchange(ip, port, &head, &body, method == http::Method::HEAD)?;
+            let (status, headers, payload) = response;
+            if status.is_redirection() {
+                if let Some(location) = headers.get(http::header::LOCATION) {
+                    let location = location.to_str().map_err(|_| {
+                        Error::Protocol("non-UTF-8 redirect location".into())
+                    })?;
+                    url = url::Url::parse(&url)
+                        .and_then(|base| base.join(location))
+                        .map_err(|e| Error::Protocol(format!("bad redirect location: {e}")))?
+                        .to_string();
+                    if status == http::StatusCode::SEE_OTHER {
+                        method = http::Method::GET;
+                        body = Vec::new();
+                    }
+                    continue;
+                }
+            }
+            let mut response = http::Response::builder().status(status);
+            *response.headers_mut().unwrap() = headers;
+            let mut response = response
+                .body(payload)
+                .map_err(|e| Error::Protocol(e.to_string()))?;
+            response.extensions_mut().insert(Extensions {
+                client_ip: None,
+                effective_url: Some(url),
+            });
+            return Ok(response);
+        }
+        Err(Error::TooManyRedirects(parts.uri.to_string()))
+    }
+
+    fn request_head(
+        &self,
+        method: &http::Method,
+        url: &str,
+        headers: &http::HeaderMap,
+        body_len: usize,
+    ) -> HttpResult<Vec<u8>> {
+        let uri = http::Uri::from_str(url).map_err(|e| Error::Protocol(e.to_string()))?;
+        let authority = uri
+            .authority()
+            .map(|a| a.as_str().to_string())
+            .ok_or_else(|| Error::Protocol(format!("no host in `{url}`")))?;
+        let mut head = format!(
+            "{method} {url} HTTP/1.1\r\nHost: {authority}\r\nUser-Agent: {}\r\n\
+             Accept-Encoding: identity\r\nConnection: keep-alive\r\n",
+            self.handle_config.useragent
+        );
+        for (name, value) in headers {
+            if matches!(
+                name.as_str(),
+                "host" | "connection" | "user-agent" | "content-length" | "accept-encoding"
+            ) {
+                continue;
+            }
+            let value = value.to_str().map_err(|_| Error::BadHeader {
+                name: name.to_string(),
+                bytes: value.as_bytes().to_owned(),
+            })?;
+            head.push_str(&format!("{name}: {value}\r\n"));
+        }
+        if body_len > 0 || matches!(*method, http::Method::POST | http::Method::PUT) {
+            head.push_str(&format!("Content-Length: {body_len}\r\n"));
+        }
+        head.push_str("\r\n");
+        Ok(head.into_bytes())
+    }
+
+    /// Sends one request and reads its response, on the kept-alive
+    /// connection when there is one (reconnecting once if it went stale).
+    fn exchange(
+        &self,
+        ip: [u8; 4],
+        port: u16,
+        head: &[u8],
+        body: &[u8],
+        is_head: bool,
+    ) -> HttpResult<(http::StatusCode, http::HeaderMap, Vec<u8>)> {
+        let mut slot = self.connection.lock().unwrap();
+        for attempt in 0..2 {
+            if slot.is_none() {
+                let stream = connect(ip, port).map_err(|e| Error::Connect {
+                    addr: format!("{}.{}.{}.{}:{port}", ip[0], ip[1], ip[2], ip[3]),
+                    message: e.to_string(),
+                })?;
+                *slot = Some(Connection {
+                    stream: BufReader::new(stream),
+                    used: false,
+                });
+            }
+            let connection = slot.as_mut().unwrap();
+            let reused = connection.used;
+            connection.used = true;
+            let result = (|| {
+                let file = connection.stream.get_mut();
+                file.write_all(head)?;
+                file.write_all(body)?;
+                file.flush()?;
+                read_response(&mut connection.stream, is_head)
+            })();
+            match result {
+                Ok((status, headers, payload, keep_alive)) => {
+                    if !keep_alive {
+                        *slot = None;
+                    }
+                    return Ok((status, headers, payload));
+                }
+                // A kept-alive connection the proxy closed: once more, fresh.
+                Err(ReadError::Io(_)) if reused && attempt == 0 => *slot = None,
+                Err(e) => {
+                    *slot = None;
+                    return Err(e.into());
+                }
+            }
+        }
+        unreachable!()
+    }
+}
+
+enum ReadError {
+    Io(io::Error),
+    Protocol(String),
+}
+
+impl From<io::Error> for ReadError {
+    fn from(e: io::Error) -> ReadError {
+        ReadError::Io(e)
+    }
+}
+
+impl From<ReadError> for Error {
+    fn from(e: ReadError) -> Error {
+        match e {
+            ReadError::Io(e) => io_error(e),
+            ReadError::Protocol(message) => Error::Protocol(message),
+        }
+    }
+}
+
+fn read_line(r: &mut impl BufRead) -> Result<String, ReadError> {
+    let mut line = Vec::new();
+    if r.read_until(b'\n', &mut line)? == 0 {
+        return Err(ReadError::Io(io::ErrorKind::UnexpectedEof.into()));
+    }
+    while matches!(line.last(), Some(b'\n' | b'\r')) {
+        line.pop();
+    }
+    String::from_utf8(line).map_err(|_| ReadError::Protocol("non-UTF-8 header line".into()))
+}
+
+/// Status, headers, body, and whether the connection stays open.
+fn read_response(
+    r: &mut BufReader<File>,
+    is_head: bool,
+) -> Result<(http::StatusCode, http::HeaderMap, Vec<u8>, bool), ReadError> {
+    loop {
+        let status_line = read_line(r)?;
+        let code = status_line
+            .split_whitespace()
+            .nth(1)
+            .and_then(|c| c.parse::<u16>().ok())
+            .ok_or_else(|| ReadError::Protocol(format!("bad status line `{status_line}`")))?;
+        let status = http::StatusCode::from_u16(code)
+            .map_err(|_| ReadError::Protocol(format!("bad status {code}")))?;
+        let mut headers = http::HeaderMap::new();
+        loop {
+            let line = read_line(r)?;
+            if line.is_empty() {
+                break;
+            }
+            let (name, value) = line
+                .split_once(':')
+                .ok_or_else(|| ReadError::Protocol(format!("bad header line `{line}`")))?;
+            let name = http::HeaderName::from_str(name.trim())
+                .map_err(|_| ReadError::Protocol(format!("bad header name `{name}`")))?;
+            let value = http::HeaderValue::from_str(value.trim())
+                .map_err(|_| ReadError::Protocol(format!("bad value for header `{name}`")))?;
+            headers.append(name, value);
+        }
+        // An interim response (100 Continue) precedes the real one.
+        if status.is_informational() {
+            continue;
+        }
+        let header = |name: http::header::HeaderName| {
+            headers
+                .get(name)
+                .and_then(|v| v.to_str().ok())
+                .map(|v| v.to_ascii_lowercase())
+        };
+        let keep_alive = header(http::header::CONNECTION).as_deref() != Some("close");
+        let no_body = is_head
+            || status == http::StatusCode::NO_CONTENT
+            || status == http::StatusCode::NOT_MODIFIED;
+        let body = if no_body {
+            Vec::new()
+        } else if header(http::header::TRANSFER_ENCODING).is_some_and(|te| te.contains("chunked")) {
+            read_chunked(r)?
+        } else if let Some(len) = header(http::header::CONTENT_LENGTH) {
+            let len: usize = len
+                .parse()
+                .map_err(|_| ReadError::Protocol(format!("bad content-length `{len}`")))?;
+            let mut body = vec![0u8; len];
+            r.read_exact(&mut body)?;
+            body
+        } else {
+            // Neither: the body runs to the end of the connection.
+            let mut body = Vec::new();
+            r.read_to_end(&mut body)?;
+            return Ok((status, headers, body, false));
+        };
+        return Ok((status, headers, body, keep_alive));
+    }
+}
+
+fn read_chunked(r: &mut BufReader<File>) -> Result<Vec<u8>, ReadError> {
+    let mut body = Vec::new();
+    loop {
+        let line = read_line(r)?;
+        let size = line.split(';').next().unwrap_or_default().trim();
+        let size = usize::from_str_radix(size, 16)
+            .map_err(|_| ReadError::Protocol(format!("bad chunk size `{line}`")))?;
+        if size == 0 {
+            // Trailers, up to the empty line.
+            while !read_line(r)?.is_empty() {}
+            return Ok(body);
+        }
+        let start = body.len();
+        body.resize(start + size, 0);
+        r.read_exact(&mut body[start..])?;
+        if !read_line(r)?.is_empty() {
+            return Err(ReadError::Protocol("chunk not followed by CRLF".into()));
+        }
+    }
+}
+
+#[derive(Clone)]
+struct Extensions {
+    client_ip: Option<String>,
+    effective_url: Option<String>,
+}
+
+pub trait ResponsePartsExtensions {
+    fn client_ip(&self) -> Option<&str>;
+    fn effective_url(&self) -> Option<&str>;
+}
+
+impl ResponsePartsExtensions for http::response::Parts {
+    fn client_ip(&self) -> Option<&str> {
+        self.extensions
+            .get::<Extensions>()
+            .and_then(|extensions| extensions.client_ip.as_deref())
+    }
+
+    fn effective_url(&self) -> Option<&str> {
+        self.extensions
+            .get::<Extensions>()
+            .and_then(|extensions| extensions.effective_url.as_deref())
+    }
+}
+
+impl ResponsePartsExtensions for Response {
+    fn client_ip(&self) -> Option<&str> {
+        self.extensions()
+            .get::<Extensions>()
+            .and_then(|extensions| extensions.client_ip.as_deref())
+    }
+
+    fn effective_url(&self) -> Option<&str> {
+        self.extensions()
+            .get::<Extensions>()
+            .and_then(|extensions| extensions.effective_url.as_deref())
+    }
+}
