+/// WASI std cannot spawn processes; SLICC's WASIX host can. Children run
+/// through `wasix-command` with output collected in files, and an exit code
+/// other than 0 is an error (WASI std cannot construct a failing
+/// `ExitStatus`).
+#[cfg(target_os = "wasi")]
+mod wasi {
+    use super::{ProcessBuilder, ProcessError};
+    use anyhow::{Context as _, Result, bail};
+    use std::io;
+    use std::process::{ExitStatus, Output};
+
+    fn failed(code: i32, stderr: &[u8]) -> io::Error {
+        io::Error::other(format!(
+            "child exited with status {code}: {}",
+            String::from_utf8_lossy(stderr)
+        ))
+    }
+
+    pub fn status(pb: &ProcessBuilder) -> io::Result<ExitStatus> {
+        let result = wasix_command::run(&pb.build_command(), pb.stdin.as_deref(), false)?;
+        match result.code {
+            0 => Ok(ExitStatus::default()),
+            code => Err(failed(code, &result.stderr)),
+        }
+    }
+
+    pub fn output(pb: &ProcessBuilder) -> io::Result<Output> {
+        let result = wasix_command::run(&pb.build_command(), pb.stdin.as_deref(), true)?;
+        match result.code {
+            0 => Ok(Output { status: ExitStatus::default(), stdout: result.stdout, stderr: result.stderr }),
+            code => Err(failed(code, &result.stderr)),
+        }
+    }
+
+    pub fn exec_with_streaming(
+        pb: &ProcessBuilder,
+        on_stdout_line: &mut dyn FnMut(&str) -> Result<()>,
+        on_stderr_line: &mut dyn FnMut(&str) -> Result<()>,
+        capture_output: bool,
+    ) -> Result<Output> {
+        let result = wasix_command::run(&pb.build_command(), pb.stdin.as_deref(), true)
+            .with_context(|| ProcessError::could_not_execute(pb))?;
+        for line in String::from_utf8_lossy(&result.stdout).lines() {
+            on_stdout_line(line)?;
+        }
+        for line in String::from_utf8_lossy(&result.stderr).lines() {
+            on_stderr_line(line)?;
+        }
+        if result.code != 0 {
+            bail!("process didn't exit successfully: {pb} (exit status: {})", result.code);
+        }
+        Ok(Output {
+            status: ExitStatus::default(),
+            stdout: if capture_output { result.stdout } else { Vec::new() },
+            stderr: if capture_output { result.stderr } else { Vec::new() },
+        })
+    }
+}
+
+#[cfg(target_os = "wasi")]
+mod imp {
+    use super::ProcessBuilder;
+    use anyhow::Result;
+    use std::io;
+
+    // No exec on WASI: run the process and return when it ends.
+    pub fn exec_replace(process_builder: &ProcessBuilder) -> Result<()> {
+        process_builder.exec()
+    }
+
+    pub fn command_line_too_big(_err: &io::Error) -> bool {
+        false
+    }
+}
