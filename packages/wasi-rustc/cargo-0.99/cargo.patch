@@ -0,0 +1,77 @@
+//! SLICC: HTTP configuration on WASI, where there is no libcurl.
+//!
+//! Requests go as plain HTTP/1.1 to the realm's proxy (see `http_async`),
+//! which does TLS itself, so the TLS settings of `[http]` do not apply.
+
+use std::time::Duration;
+
+use crate::util::context::GlobalContext;
+use crate::util::errors::CargoResult;
+use anyhow::bail;
+
+/// Whether git needs a custom HTTP transport. Git has no network transport
+/// on WASI, so never.
+pub fn needs_custom_http_transport(_gctx: &GlobalContext) -> CargoResult<bool> {
+    Ok(false)
+}
+
+pub struct HandleConfiguration {
+    /// `http.proxy` from Cargo or git configuration; otherwise the
+    /// environment's `https_proxy` / `http_proxy`.
+    pub proxy: Option<String>,
+    pub useragent: String,
+    pub timeout: HttpTimeout,
+    pub verbose: bool,
+    pub multiplexing: bool,
+}
+
+impl HandleConfiguration {
+    pub fn new(gctx: &GlobalContext) -> CargoResult<Self> {
+        if let Some(offline_flag) = gctx.offline_flag() {
+            bail!(
+                "attempting to make an HTTP request, but {offline_flag} was \
+                specified"
+            )
+        }
+
+        let http = gctx.http_config()?;
+        let useragent = if let Some(user_agent) = http.user_agent.clone() {
+            user_agent
+        } else {
+            format!("cargo/{}", crate::version())
+        };
+        Ok(HandleConfiguration {
+            proxy: super::proxy::http_proxy(http),
+            useragent,
+            timeout: HttpTimeout::new(gctx)?,
+            verbose: http.debug == Some(true),
+            multiplexing: false,
+        })
+    }
+}
+
+#[must_use]
+#[derive(Clone)]
+pub struct HttpTimeout {
+    pub dur: Duration,
+    pub low_speed_limit: u32,
+}
+
+impl HttpTimeout {
+    pub fn new(gctx: &GlobalContext) -> CargoResult<HttpTimeout> {
+        let http_config = gctx.http_config()?;
+        let low_speed_limit = http_config.low_speed_limit.unwrap_or(10);
+        let seconds = http_config
+            .timeout
+            .or_else(|| {
+                gctx.get_env("HTTP_TIMEOUT")
+                    .ok()
+                    .and_then(|s| s.parse().ok())
+            })
+            .unwrap_or(30);
+        Ok(HttpTimeout {
+            dur: Duration::new(seconds, 0),
+            low_speed_limit,
+        })
+    }
+}
