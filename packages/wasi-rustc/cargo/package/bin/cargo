#!/bin/sh
# Cargo in SLICC: use the installed rustc driver and its wasm32-wasip1 rustlib.
set -eu
SCRIPT=$0
case $SCRIPT in
  */*) ;;
  *) SCRIPT=$(command -v "$SCRIPT") ;;
esac
BINDIR=$(CDPATH= cd -- "${SCRIPT%/*}" && pwd)
CARGO=${CARGO:-$BINDIR/cargo}
export CARGO
# The installed wasi-rustc driver; Rust 1.98 answers `rustc -vV` itself.
RUSTC=${RUSTC:-$(command -v rustc)}
export RUSTC
: "${CARGO_BUILD_TARGET:=wasm32-wasip1}"
export CARGO_BUILD_TARGET
exec "$BINDIR/cargo.wasm" "$@"
