+# homescoop (wasi-bat): minus, the built-in pager, needs crossterm's terminal
+# I/O, which does not build for WASI. On WASI, --pager=builtin falls back to
+# stdout, as bat does when an external pager can't be started.
+[target.'cfg(not(target_os = "wasi"))'.dependencies.minus]
+version = "5.6"
+features = [
+    "dynamic_output",
+    "search",
+]
+optional = true
+
