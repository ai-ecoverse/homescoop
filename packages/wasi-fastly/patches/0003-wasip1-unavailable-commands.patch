+++ b/pkg/commands/auth/slicc.go
@@ -0,0 +1,22 @@
+package auth
+
+import (
+	"errors"
+	"runtime"
+
+	fsterr "github.com/fastly/cli/pkg/errors"
+)
+
+// SSOUnavailable is what SSO answers on wasip1 (the Fastly CLI for slicc,
+// @ai-ecoverse/wasi-fastly): fastly auth login --sso, fastly sso and
+// profile create/update --sso, and a stored SSO token that can no longer be
+// refreshed.
+func SSOUnavailable() error {
+	if runtime.GOOS != "wasip1" {
+		return nil
+	}
+	return fsterr.RemediationError{
+		Inner:       errors.New("SSO is not available in the Fastly CLI for slicc: it waits for the browser to come back to http://localhost:8080/callback, and a slicc command cannot receive that redirect"),
+		Remediation: "Create an API token at https://manage.fastly.com/account/personal/tokens, then set FASTLY_API_TOKEN, or store it with 'fastly auth add <name> --api-token <token>' or 'fastly auth login' (paste the token).",
+	}
+}
