diff --git a/pkg/app/slicc.go b/pkg/app/slicc.go
--- /dev/null
+++ b/pkg/app/slicc.go
@@ -0,0 +1,70 @@
+package app
+
+import (
+	"fmt"
+	"runtime"
+	"slices"
+
+	authcmd "github.com/fastly/cli/pkg/commands/auth"
+	"github.com/fastly/cli/pkg/commands/compute"
+	fsterr "github.com/fastly/cli/pkg/errors"
+)
+
+// unavailableOnWasip1 names the commands that the Fastly CLI for slicc
+// (GOOS=wasip1, @ai-ecoverse/wasi-fastly) leaves out, and why. Each needs a
+// native program, a local port or a new fastly binary. Building a Compute
+// package (compute build and publish here, compute hash-files without
+// --package in compute.BuildCommand) is refused with compute.BuildUnavailable.
+var unavailableOnWasip1 = map[string][2]string{
+	"compute serve": {
+		"it builds the package and runs it under Viceroy, a native program, on a local port",
+		"Run 'fastly compute serve' where the toolchain and Viceroy are installed.",
+	},
+	"compute init": {
+		"it runs git and the starter kit's post-init scripts, and the project can only be built elsewhere",
+		"Run 'fastly compute init' where the toolchain is installed.",
+	},
+	"compute install-tools": {
+		"it downloads Viceroy, a native program",
+		"Run 'fastly compute install-tools' where Viceroy can run.",
+	},
+	"vcl serve": {
+		"it publishes the VCL to a Fiddle sandbox and then serves it on a local port, which a slicc command cannot open",
+		"Run 'fastly vcl serve' where it can listen on a local port; 'fastly vcl check' compiles the VCL from here.",
+	},
+	"update": {
+		"it replaces the fastly binary, which here comes from the npm package @ai-ecoverse/wasi-fastly",
+		"Install a newer version of @ai-ecoverse/wasi-fastly.",
+	},
+	"install": {
+		"it replaces the fastly binary, which here comes from the npm package @ai-ecoverse/wasi-fastly",
+		"Install another version of @ai-ecoverse/wasi-fastly.",
+	},
+}
+
+// checkAvailable refuses, on wasip1, a command the Fastly CLI for slicc
+// cannot run, before it does anything.
+func checkAvailable(commandName string, args []string) error {
+	if runtime.GOOS != "wasip1" {
+		return nil
+	}
+	switch commandName {
+	case "sso":
+		return authcmd.SSOUnavailable()
+	case "auth login", "profile create", "profile update":
+		if slices.Contains(args, "--sso") {
+			return authcmd.SSOUnavailable()
+		}
+	}
+	if commandName == "compute build" || commandName == "compute publish" {
+		return compute.BuildUnavailable()
+	}
+	why, ok := unavailableOnWasip1[commandName]
+	if !ok {
+		return nil
+	}
+	return fsterr.RemediationError{
+		Inner:       fmt.Errorf("'fastly %s' is not available in the Fastly CLI for slicc: %s", commandName, why[0]),
+		Remediation: why[1],
+	}
+}
