--- /dev/null
+++ b/pkg/commands/compute/slicc.go
@@ -0,0 +1,21 @@
+package compute
+
+import (
+	"errors"
+	"runtime"
+
+	fsterr "github.com/fastly/cli/pkg/errors"
+)
+
+// BuildUnavailable is what building a Compute package answers on wasip1
+// (the Fastly CLI for slicc, @ai-ecoverse/wasi-fastly): compute build,
+// compute publish and compute hash-files without --package.
+func BuildUnavailable() error {
+	if runtime.GOOS != "wasip1" {
+		return nil
+	}
+	return fsterr.RemediationError{
+		Inner:       errors.New("building a Compute package is not available in the Fastly CLI for slicc: it runs the project's language toolchain (cargo, npm, go, ...) and wasm-tools, which are native programs"),
+		Remediation: "Build the package where its toolchain is installed ('fastly compute build'), then deploy it from here with 'fastly compute deploy --package pkg/<name>.tar.gz'.",
+	}
+}
