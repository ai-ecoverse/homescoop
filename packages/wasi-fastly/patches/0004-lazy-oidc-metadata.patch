 }
 
+// tokenMayNeedSSO reports whether processToken may refresh or create an SSO
+// token for this command, which needs the auth server. A token from --token,
+// FASTLY_API_TOKEN or a stored API token does not, so those commands make no
+// request to the accounts endpoint before their own.
+func tokenMayNeedSSO(data *global.Data) bool {
+	_, source := data.Token()
+	switch source {
+	case lookup.SourceAuth:
+		name := data.AuthTokenName()
+		if name == "" {
+			return true
+		}
+		at := data.Config.GetAuthToken(name)
+		return at == nil || at.Type == config.AuthTokenTypeSSO
+	case lookup.SourceUndefined:
+		return data.Env.UseSSO == "1"
+	case lookup.SourceEnvironment, lookup.SourceFlag, lookup.SourceDefault, lookup.SourceFile:
+		return false
+	}
+	return true
+}
+
