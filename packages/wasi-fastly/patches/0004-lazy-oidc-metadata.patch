+		if data.AuthServer == nil && tokenMayNeedSSO(data) {
 			authServer, err := configureAuth(apiEndpoint, data.Args, data.Config, data.HTTPClient, data.Env)
 			if err != nil {
 				return fmt.Errorf("failed to configure authentication processes: %w", err)
