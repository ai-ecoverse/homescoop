--- /dev/null
+++ b/pkg/slicchost/slicchost.go
@@ -0,0 +1,10 @@
+// Package slicchost reaches the host functions that wasi-fastly's host
+// module (host/fastly-host.mjs) provides on slicc-kernel: sending HTTP
+// requests and setting file modes. Where the module is missing, HTTP returns
+// ErrUnsupported.
+package slicchost
+
+import "errors"
+
+// ErrUnsupported is returned when the runtime does not provide the host module.
+var ErrUnsupported = errors.New("this runtime cannot open network connections for fastly (it needs slicc-kernel with @ai-ecoverse/wasi-fastly's host module)")
