{
  "name": "@ai-ecoverse/py-contourpy",
  "version": "1.4.0-2",
  "description": "contourpy for slicc WASIX CPython 3.14 (cp314-wasix_wasm32)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-contourpy/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/py-contourpy",
  "keywords": ["wasm", "wasi", "wasix", "slicc", "homescoop", "python"],
  "files": ["README.md", "LICENSE", "lib"],
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@ai-ecoverse/wasix-python": "3.14.2-11",
    "@ai-ecoverse/py-numpy": "2.3.2-5"
  },
  "homescoop": {
    "recipe": "py-contourpy",
    "upstream": "1.4.0",
    "platform": "wasix_wasm32"
