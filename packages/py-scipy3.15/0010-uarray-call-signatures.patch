uarray: the Function getters and BackendState._pickle get CPython's second
parameter (homescoop#589).

CPython calls a getter as get(self, closure) and a METH_NOARGS method as
f(self, NULL). Declared with one parameter, the call traps on wasm (function
signature mismatch), as packages/py-kiwisolver/test/wasm-call-signatures.mjs
reports.

--- a/scipy/_lib/_uarray/_uarray_dispatch.cxx
+++ b/scipy/_lib/_uarray/_uarray_dispatch.cxx
@@ -327,7 +327,7 @@
     return reinterpret_cast<PyObject *>(self);
   }
 
-  static PyObject * pickle_(BackendState * self) {
+  static PyObject * pickle_(BackendState * self, PyObject * /*args*/) {
     try {
       py_ref py_global = BackendState::convert_py(self->globals);
       py_ref py_locals = BackendState::convert_py(self->locals);
@@ -1144,10 +1144,10 @@
   static PyObject * descr_get(PyObject * self, PyObject * obj, PyObject * type);
   static int traverse(Function * self, visitproc visit, void * arg);
   static int clear(Function * self);
-  static PyObject * get_extractor(Function * self);
-  static PyObject * get_replacer(Function * self);
-  static PyObject * get_domain(Function * self);
-  static PyObject * get_default(Function * self);
+  static PyObject * get_extractor(Function * self, void * /*closure*/);
+  static PyObject * get_replacer(Function * self, void * /*closure*/);
+  static PyObject * get_domain(Function * self, void * /*closure*/);
+  static PyObject * get_default(Function * self, void * /*closure*/);
 };
 
 
@@ -1449,22 +1449,22 @@
   return 0;
 }
 
-PyObject * Function::get_extractor(Function * self) {
+PyObject * Function::get_extractor(Function * self, void * /*closure*/) {
   Py_INCREF(self->extractor_.get());
   return self->extractor_.get();
 }
 
-PyObject * Function::get_replacer(Function * self) {
+PyObject * Function::get_replacer(Function * self, void * /*closure*/) {
   Py_INCREF(self->replacer_.get());
   return self->replacer_.get();
 }
 
-PyObject * Function::get_default(Function * self) {
+PyObject * Function::get_default(Function * self, void * /*closure*/) {
   Py_INCREF(self->def_impl_.get());
   return self->def_impl_.get();
 }
 
-PyObject * Function::get_domain(Function * self) {
+PyObject * Function::get_domain(Function * self, void * /*closure*/) {
   return PyUnicode_FromStringAndSize(
       self->domain_key_.c_str(), self->domain_key_.size());
 }
