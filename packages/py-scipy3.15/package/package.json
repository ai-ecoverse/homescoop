{
  "name": "@ai-ecoverse/py-scipy",
  "version": "1.18.1-2",
  "description": "SciPy 1.18.1 for slicc WASIX CPython 3.15 (cp315-wasix_wasm32 side modules, static OpenBLAS)",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/py-scipy3.15/package"
