+#ifdef __EMSCRIPTEN__
+static double
+slicc_elapsed (struct timespec const *start)
+{
+  struct timespec now;
+  clock_gettime (CLOCK_MONOTONIC, &now);
+  return (now.tv_sec - start->tv_sec) + (now.tv_nsec - start->tv_nsec) / 1e9;
+}
+
+/* slicc (wasm realm): there is no fork(), and no timer signal can interrupt
+   a blocked process.  Spawn the command through the kernel, give it its own
+   process group, and poll waitpid() with short sleeps, doing on the deadline
+   (and on --kill-after) what cleanup() does on SIGALRM.  Returns the child's
+   wait status, or -1 with *exit_status set if it could not be started.  */
+static int
+slicc_timeout (char **argv, double duration, sigset_t const *orig_set,
+               int *exit_status)
+{
+  pid_t pid;
+  int err = posix_spawnp (&pid, argv[0], NULL, NULL, argv, environ);
+  if (err != 0)
+    {
+      error (0, err, _("failed to run command %s"), quote (command));
+      *exit_status = err == ENOENT ? EXIT_ENOENT : EXIT_CANNOT_INVOKE;
+      return -1;
+    }
+  if (!foreground)
+    setpgid (pid, pid);
+  monitored_pid = pid;
+
+  struct timespec start;
+  clock_gettime (CLOCK_MONOTONIC, &start);
+  double deadline = duration;   /* 0: no timeout */
+  for (;;)
+    {
+      int status;
+      pid_t w = waitpid (pid, &status, WNOHANG);
+      if (w == pid)
+        return status;
+      if (w < 0 && errno != EINTR)
+        {
+          error (0, errno, _("error waiting for command"));
+          *exit_status = EXIT_CANCELED;
+          return -1;
+        }
+      if (0 < deadline && deadline <= slicc_elapsed (&start))
+        {
+          /* What cleanup (SIGALRM) does.  It would arm a timer for -k;
+             here -k is the next deadline, after which SIGKILL goes.  */
+          double next = kill_after ? slicc_elapsed (&start) + kill_after : 0;
+          kill_after = 0;
+          cleanup (SIGALRM);
+          if (next)
+            term_signal = SIGKILL;
+          deadline = next;
+        }
+      /* Let the cleanup signals in while we sleep, as sigsuspend() would.  */
+      sigset_t blocked;
+      sigprocmask (SIG_SETMASK, orig_set, &blocked);
+      struct timespec tick = { 0, 10 * 1000 * 1000 };
+      nanosleep (&tick, NULL);
+      sigprocmask (SIG_SETMASK, &blocked, NULL);
+    }
+}
+
+/* The exit status timeout reports for the command's wait status, as in the
+   fork path below.  */
+static int
+slicc_exit_status (int status)
+{
+  if (WIFEXITED (status))
+    status = WEXITSTATUS (status);
+  else if (WIFSIGNALED (status))
+    {
+      int sig = WTERMSIG (status);
+      /* Forcibly killed: let users tell (exit 128+9), as GNU does.  */
+      if (timed_out && sig == SIGKILL)
+        preserve_status = true;
+      status = sig + 128;
+    }
+  else
+    {
+      error (0, 0, _("unknown status from command (%d)"), status);
+      status = EXIT_FAILURE;
+    }
+  if (timed_out && !preserve_status)
+    status = EXIT_TIMEDOUT;
+  return status;
+}
