    "./roots.der": "./dist/roots.der"
  },
  "types": "./index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/tls-engine/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/tls-engine",
  "keywords": [
    "wasm",
    "emscripten",
    "slicc",
    "homescoop",
    "mbedtls",
    "tls"
