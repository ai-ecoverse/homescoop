{
  "name": "@ai-ecoverse/wasm-tls-engine",
  "version": "4.2.0-7",
  "description": "Secure (TLS) network connections for slicc.",
  "license": "Apache-2.0 AND MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
