+static bool zend_mm_wasi_extend(void *addr, size_t old_size, size_t new_size)
+{
+	zend_mm_wasi_run **pp;
+	size_t need;
+
+	old_size = ZEND_MM_WASI_ROUND(old_size);
+	new_size = ZEND_MM_WASI_ROUND(new_size);
+	if (new_size <= old_size) {
+		return true;
+	}
+	need = new_size - old_size;
+	for (pp = &zend_mm_wasi_runs; *pp && (char *) *pp <= (char *) addr + old_size; pp = &(*pp)->next) {
+		zend_mm_wasi_run *run = *pp;
+		if ((char *) run == (char *) addr + old_size && run->size >= need) {
+			if (run->size == need) {
