+#ifdef __wasi__
+/* WASIX: mmap is wasi-libc's emulation over malloc, and its munmap takes
+ * only a whole mapping, so the trim to alignment below can't work (the
+ * partial munmaps fail and the slack leaks), and a mapping can't grow in
+ * place. Chunks and huge blocks come instead from a pool of
+ * ZEND_MM_CHUNK_SIZE-aligned arenas taken from libc with posix_memalign.
+ * Free space is a list of runs of whole chunks, address-ordered and
+ * coalesced, so an alignment's slack is paid once per arena (not once per
+ * chunk, which doubled the memory a script used), a huge block can shrink,
+ * and it can grow in place when the run after it is free. Arenas are never
+ * given back: a wasm memory can't shrink. Single-threaded (NTS).
+ */
+typedef struct _zend_mm_wasi_run zend_mm_wasi_run;
+struct _zend_mm_wasi_run {
+	zend_mm_wasi_run *next;
+	size_t size;
+};
+
+static zend_mm_wasi_run *zend_mm_wasi_runs;
+static size_t zend_mm_wasi_arenas;
+
+#define ZEND_MM_WASI_ROUND(size) ZEND_MM_ALIGNED_SIZE_EX(size, ZEND_MM_CHUNK_SIZE)
+#define ZEND_MM_WASI_ARENA_MIN (4 * ZEND_MM_CHUNK_SIZE)
+#define ZEND_MM_WASI_ARENA_MAX (16 * ZEND_MM_CHUNK_SIZE)
+
+static void zend_mm_wasi_release(void *addr, size_t size)
+{
+	zend_mm_wasi_run **pp = &zend_mm_wasi_runs, *prev = NULL, *run = (zend_mm_wasi_run *) addr;
+
+	while (*pp && (char *) *pp < (char *) addr) {
+		prev = *pp;
+		pp = &(*pp)->next;
+	}
+	run->size = size;
+	run->next = *pp;
+	if (run->next && (char *) run + run->size == (char *) run->next) {
+		run->size += run->next->size;
+		run->next = run->next->next;
+	}
+	if (prev && (char *) prev + prev->size == (char *) run) {
+		prev->size += run->size;
+		prev->next = run->next;
+	} else {
+		*pp = run;
+	}
+}
+
+static void *zend_mm_wasi_take(size_t size)
+{
+	zend_mm_wasi_run **pp;
+	size_t arena;
+	void *ptr = NULL;
+
+	for (pp = &zend_mm_wasi_runs; *pp; pp = &(*pp)->next) {
+		zend_mm_wasi_run *run = *pp;
+		if (run->size >= size) {
+			if (run->size == size) {
+				*pp = run->next;
+			} else {
+				zend_mm_wasi_run *rest = (zend_mm_wasi_run *) ((char *) run + size);
+				rest->size = run->size - size;
+				rest->next = run->next;
+				*pp = rest;
+			}
+			return run;
+		}
+	}
+	/* A new arena: about the size of the ones before it, within bounds. */
+	arena = MAX(size, MIN(MAX(zend_mm_wasi_arenas, ZEND_MM_WASI_ARENA_MIN), ZEND_MM_WASI_ARENA_MAX));
+	if (posix_memalign(&ptr, ZEND_MM_CHUNK_SIZE, arena) != 0) {
+		arena = size;
+		if (posix_memalign(&ptr, ZEND_MM_CHUNK_SIZE, arena) != 0) {
+			return NULL;
+		}
+	}
+	zend_mm_wasi_arenas += arena;
+	if (arena > size) {
+		zend_mm_wasi_release((char *) ptr + size, arena - size);
+	}
+	return ptr;
+}
