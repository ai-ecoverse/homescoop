+			} else {
+				zend_mm_wasi_run *rest = (zend_mm_wasi_run *) ((char *) run + need);
+				rest->size = run->size - need;
+				rest->next = run->next;
+				*pp = rest;
+			}
+			return true;
+		}
+	}
+	return false;
+}
