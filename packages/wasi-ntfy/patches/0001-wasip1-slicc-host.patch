@@ -0,0 +1,20 @@
+package slicchost
+
+import (
+	"errors"
+	"fmt"
+)
+
+var ErrUnsupported = errors.New("this runtime cannot start commands or open network connections for ntfy (it needs slicc-kernel with @ai-ecoverse/wasi-ntfy's host module)")
+
+type ExitError struct {
+	Code int
+}
+
+func (e *ExitError) Error() string {
+	return fmt.Sprintf("exit status %d", e.Code)
+}
+
+func (e *ExitError) ExitCode() int {
+	return e.Code
+}
