+        .nothing => .{ .unknown = 0 },
+        .exit_normal => .{ .exited = @truncate(status.exit_code) },
+        .exit_signal => .{ .signal = @enumFromInt(status.signal) },
+        .stopped => .{ .stopped = @enumFromInt(status.signal) },
+    };
