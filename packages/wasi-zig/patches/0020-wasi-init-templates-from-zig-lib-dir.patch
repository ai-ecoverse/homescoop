+fn findTemplates(gpa: Allocator, arena: Allocator, io: Io, environ_map: *const process.Environ.Map) Templates {
+    // homescoop: WASI has no self exe path; the lib dir comes from ZIG_LIB_DIR,
+    // as for every other command there.
+    var zig_lib_directory = if (native_os == .wasi) wasi: {
+        const lib_path = EnvVar.ZIG_LIB_DIR.get(environ_map) orelse
+            fatal("unable to find zig installation directory on WASI (set ZIG_LIB_DIR)", .{});
+        const handle = Io.Dir.cwd().openDir(io, lib_path, .{}) catch |err|
+            fatal("unable to open zig installation directory '{s}': {t}", .{ lib_path, err });
+        break :wasi Cache.Directory{ .path = lib_path, .handle = handle };
+    } else self: {
+        const cwd_path = introspect.getResolvedCwd(io, arena) catch |err| {
+            fatal("unable to get cwd: {t}", .{err});
+        };
+        const self_exe_path = process.executablePathAlloc(io, arena) catch |err| {
+            fatal("unable to find self exe path: {t}", .{err});
+        };
+        break :self introspect.findZigLibDirFromSelfExe(arena, io, cwd_path, self_exe_path) catch |err| {
+            fatal("unable to find zig installation directory '{s}': {t}", .{ self_exe_path, err });
+        };
     };
 
