+/// Zig's own runtimes (compiler_rt, ubsan_rt, zigc) ship prebuilt beside wasi-libc
+/// for the same target, in the compiler-rt optimize mode Debug / ReleaseSafe /
+/// ReleaseSmall use; ReleaseFast builds them from source.
+fn homescoopUsePrebuiltRt(comp: *Compilation, gpa: Allocator, io: Io, comptime name: []const u8, out: *?CrtFile) Allocator.Error!bool {
+    if (!comp.homescoopPrebuiltTarget()) return false;
+    if (comp.compilerRtOptMode() != target_util.defaultCompilerRtOptimizeMode(&comp.root_mod.resolved_target.result))
+        return false;
+    const dir = "prebuilt" ++ fs.path.sep_str ++ "wasm32-wasi" ++ fs.path.sep_str;
+    out.* = try comp.homescoopPrebuiltCrtFile(gpa, io, dir ++ name) orelse return false;
+    return true;
+}
+
+/// wasi-libc's C sources (lib/libc/wasi, lib/libc/musl) are an optional
+/// package on the wasm32-wasi compiler: everything the baseline target links
+/// is prebuilt. They are used from lib/ when there, else from the
+/// `<package>-libc-src` package beside the compiler's package; when neither
+/// has them, building wasi-libc fails with how to install them.
+fn homescoopFindLibcSrc(comp: *Compilation, io: Io) Allocator.Error!void {
+    if (builtin.os.tag != .wasi) return;
+    const sub = "libc" ++ fs.path.sep_str ++ "wasi";
+    if (comp.dirs.zig_lib.handle.access(io, sub, .{})) |_| return else |_| {}
+    const lib = comp.dirs.zig_lib.path orelse {
+        comp.homescoop_libc_src_missing = true;
+        return;
+    };
+    const pkg = fs.path.dirname(lib) orelse lib;
+    const src = try std.fmt.allocPrint(comp.arena, "{s}-libc-src" ++ fs.path.sep_str ++ "lib", .{pkg});
+    const probe = try fs.path.join(comp.arena, &.{ src, sub });
+    if (Io.Dir.cwd().access(io, probe, .{})) |_| {
+        comp.homescoop_libc_src = src;
+    } else |_| {
+        comp.homescoop_libc_src_missing = true;
+    }
+}
