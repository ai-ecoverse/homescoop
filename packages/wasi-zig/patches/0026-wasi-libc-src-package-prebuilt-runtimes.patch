+
+/// homescoop: a path under lib/libc. The C sources (libc/wasi, libc/musl) may
+/// come from the optional `<package>-libc-src` package
+/// (`Compilation.homescoop_libc_src`); the headers in libc/include are always
+/// the compiler's.
+fn libcJoin(comp: *Compilation, arena: Allocator, paths: []const []const u8) ![]u8 {
+    const src = comp.homescoop_libc_src orelse return comp.dirs.zig_lib.join(arena, paths);
+    if (paths.len > 1 and mem.startsWith(u8, paths[1], "include")) return comp.dirs.zig_lib.join(arena, paths);
+    const parts = try arena.alloc([]const u8, paths.len + 1);
+    parts[0] = src;
+    @memcpy(parts[1..], paths);
+    return path.join(arena, parts);
+}
