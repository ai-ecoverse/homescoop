{
  "name": "@ai-ecoverse/wasi-zig",
  "version": "0.16.0-19",
  "description": "The Zig compiler with LLVM, to build Zig, C and C++ programs in SLICC.",
  "license": "MIT AND Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/homescoop.git",
    "directory": "packages/wasi-zig/package"
  },
  "homepage": "https://github.com/ai-ecoverse/homescoop/tree/main/packages/wasi-zig",
  "keywords": [
    "wasm",
    "wasi",
    "slicc",
    "homescoop",
    "zig",
    "llvm",
    "clang"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "LICENSE-LLVM.TXT",
    "THIRD-PARTY-NOTICES.md",
    "bin",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homescoop": {
    "recipe": "wasi-zig",
    "upstream": "0.16.0",
    "llvm": "21.1.8"
  },
  "slicc": {
    "abi": "wasi",
    "commands": {
      "zig": {
        "wasm": "bin/zig.wasm",
        "env": {
          "ZIG_LIB_DIR": "${package}/lib",
          "ZIG_GLOBAL_CACHE_DIR": "${HOME}/.cache/zig",
          "ZIG_EXE": "zig"
        }
      }
    },
    "env": {
      "ZIG_LIB_DIR": "${package}/lib",
      "ZIG_GLOBAL_CACHE_DIR": "${HOME}/.cache/zig",
      "ZIG_EXE": "zig"
    }
  }
}
