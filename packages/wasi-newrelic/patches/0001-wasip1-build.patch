@@ -0,0 +1,17 @@
+//go:build wasip1
+
+package interp
+
+import (
+	"fmt"
+	"os"
+)
+
+// wasip1 has no mkfifo, and slicc-kernel checks directory permissions itself.
+func mkfifo(path string, mode uint32) error {
+	return fmt.Errorf("mkfifo %s: not supported on wasip1", path)
+}
+
+func hasPermissionToDir(info os.FileInfo) bool {
+	return true
+}
