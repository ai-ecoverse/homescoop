diff --git a/vendor/github.com/AlecAivazis/survey/v2/terminal/runereader_wasip1.go b/vendor/github.com/AlecAivazis/survey/v2/terminal/runereader_wasip1.go
--- /dev/null
+++ b/vendor/github.com/AlecAivazis/survey/v2/terminal/runereader_wasip1.go
@@ -0,0 +1,46 @@
+//go:build wasip1
+
+package terminal
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+)
+
+// wasip1 has no terminal ioctls, so survey cannot switch the terminal to raw
+// mode. SetTermMode fails, as it does on a pipe elsewhere (survey.Ask
+// refuses on wasip1 before it gets here).
+var errNoTermios = errors.New("WASI preview1 has no terminal raw mode")
+
+type runeReaderState struct {
+	reader *bufio.Reader
+	buf    *bytes.Buffer
+}
+
+func newRuneReaderState(input FileReader) runeReaderState {
+	buf := new(bytes.Buffer)
+	return runeReaderState{
+		reader: bufio.NewReader(&BufferedReader{
+			In:     input,
+			Buffer: buf,
+		}),
+		buf: buf,
+	}
+}
+
+func (rr *RuneReader) Buffer() *bytes.Buffer {
+	return rr.state.buf
+}
+
+func (rr *RuneReader) SetTermMode() error {
+	return errNoTermios
+}
+
+func (rr *RuneReader) RestoreTermMode() error {
+	return nil
+}
+
+func (rr *RuneReader) ReadRune() (rune, int, error) {
+	return rr.state.reader.ReadRune()
+}
