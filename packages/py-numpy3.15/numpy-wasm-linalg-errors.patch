     """
 
 
+# homescoop (homescoop#1082): on wasm the FP status flags that errstate relies
+# on don't exist, so a failed LAPACK call didn't raise; _umath_linalg keeps
+# the failure in a flag that this wrapper turns into the same exception.
+if hasattr(_umath_linalg, '_wasm_take_invalid'):
+    import contextlib as _contextlib
+
+    @_contextlib.contextmanager
+    def _lapack_errstate(*, call, **kwargs):
+        _umath_linalg._wasm_take_invalid()
+        with errstate(call=call, **kwargs):
+            yield
+        if _umath_linalg._wasm_take_invalid():
+            call('invalid value', 0)
+else:
+    def _lapack_errstate(*, call, **kwargs):
+        return errstate(call=call, **kwargs)
+
+
 def _raise_linalgerror_singular(err, flag):
     raise LinAlgError("Singular matrix")
 
