homescoop (homescoop#1082, refs #1081): numpy.linalg raises LinAlgError for a
failed factorisation through errstate(call=..., invalid='call'), which needs
the FP invalid flag that umath_linalg sets with npy_set_floatstatus_invalid().
wasm has no FP status flags, so solve/inv/cholesky/qr/eig*/svd/lstsq returned
NaN for a singular or non-positive-definite matrix. umath_linalg now also
records LAPACK's verdict in a thread-local flag (wasm only) that
_umath_linalg._wasm_take_invalid() reads and clears, and _linalg.py's
_lapack_errstate raises the same LinAlgError from it after each call.
--- a/numpy/linalg/umath_linalg.cpp
+++ b/numpy/linalg/umath_linalg.cpp
@@ -437,11 +437,25 @@
     return !!(status & NPY_FPE_INVALID);
 }
 
+#ifdef __wasm__
+/*
+ * homescoop (homescoop#1082, #1081): wasm has no floating-point status flags,
+ * so npy_set_floatstatus_invalid() is a no-op there, numpy's errstate never
+ * sees a failed factorisation, and solve/inv/cholesky/... returned NaN instead
+ * of raising LinAlgError. Keep LAPACK's verdict in this flag as well;
+ * numpy/linalg/_linalg.py reads and clears it after each call.
+ */
+static thread_local int wasm_linalg_invalid;
+#endif
+
 static inline void
 set_fp_invalid_or_clear(int error_occurred)
 {
     if (error_occurred) {
         npy_set_floatstatus_invalid();
+#ifdef __wasm__
+        wasm_linalg_invalid = 1;
+#endif
     }
     else {
         npy_clear_floatstatus_barrier((char*)&error_occurred);
@@ -4684,7 +4698,21 @@
 /* -------------------------------------------------------------------------- */
                   /* Module initialization and state  */
 
+#ifdef __wasm__
+static PyObject *
+wasm_take_invalid(PyObject *NPY_UNUSED(self), PyObject *NPY_UNUSED(args))
+{
+    int v = wasm_linalg_invalid;
+    wasm_linalg_invalid = 0;
+    return PyBool_FromLong(v);
+}
+#endif
+
 static PyMethodDef UMath_LinAlgMethods[] = {
+#ifdef __wasm__
+    {"_wasm_take_invalid", wasm_take_invalid, METH_NOARGS,
+     "homescoop: whether a LAPACK call failed since the last call (wasm has no FP flags)"},
+#endif
     {NULL, NULL, 0, NULL}        /* Sentinel */
 };
 
