{
  "name": "homescoop",
  "private": true,
  "description": "Homebrew-shaped recipes for @ai-ecoverse/wasm-* packages",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ladder-build.yml",
    "repo": "ai-ecoverse/homescoop",
    "publish": true
  },
  "scripts": {
    "reserve": "node scripts/reserve-names.mjs",
    "list-packages": "node scripts/list-packages.mjs",
    "list-semver-cleanup": "node scripts/list-semver-cleanup.mjs",
    "recipe": "node scripts/read-recipe.mjs",
    "refresh-sha": "node scripts/refresh-recipe-sha.mjs",
    "browser-cert": "node scripts/browser-cert/run.mjs",
    "check-meta": "node scripts/check-package-meta.mjs",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.124.0",
    "@ai-ecoverse/slicc-shared-web": "1.23.2",
    "playwright-core": "1.64.0",
    "slicc-kernel-negative": "npm:@ai-ecoverse/slicc-kernel@1.78.0"
  },
  "workspaces": [
    "packages/*/package"
  ],
  "license": "Apache-2.0"
}
