{
  "name": "homescoop",
  "private": true,
  "description": "Homebrew-shaped recipes for @ai-ecoverse/wasm-* packages",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ladder-build.yml",
    "repo": "ai-ecoverse/homescoop",
    "publish": true
  },
  "scripts": {
    "reserve": "node scripts/reserve-names.mjs",
    "list-packages": "node scripts/list-packages.mjs",
    "list-semver-cleanup": "node scripts/list-semver-cleanup.mjs",
    "recipe": "node scripts/read-recipe.mjs",
    "refresh-sha": "node scripts/refresh-recipe-sha.mjs",
    "browser-cert": "node scripts/browser-cert/run.mjs",
    "check-meta": "node scripts/check-package-meta.mjs",
    "trust": "node scripts/trust.mjs -y --skip-publish",
    "trust:dry": "node scripts/trust.mjs --dry-run -y --skip-publish",
    "lint": "node scripts/gate.mjs check-exact-pins -- node scripts/check-exact-pins.mjs",
    "test": "node --test 'scripts/test/*.test.mjs'"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.162.1",
    "@ai-ecoverse/slicc-shared-web": "2.12.1",
    "monocart-coverage-reports": "3.0.0",
    "playwright-core": "1.64.1",
    "slicc-kernel-negative": "npm:@ai-ecoverse/slicc-kernel@1.78.0",
    "slicc-shared-web-cert": "npm:@ai-ecoverse/slicc-shared-web@1.30.12"
  },
  "license": "Apache-2.0"
}
