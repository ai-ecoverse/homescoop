{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": [
    "Homescoope recipes pin upstream library versions in packages/*/recipe.yaml.",
    "A custom regex manager reads `# renovate: …` comments above `version:` and opens one PR per package when upstream cuts a release.",
    "Recipe automerge only for packages listed in scripts/ci-certified.json (full cert/*.mjs checklist + negative proof). Majors and new packages stay manual."
  ],
  "semanticCommits": "enabled",
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "prHourlyLimit": 4,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Homebrew-shaped recipe.yaml upstream pins (see # renovate comments).",
      "managerFilePatterns": [
        "/(^|/)packages/[^/]+/recipe\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?(?: registryUrl=(?<registryUrl>\\S+?))?\\s+version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Default: recipe bumps do not automerge until CI-certified.",
      "matchFileNames": [
        "packages/**/recipe.yaml"
      ],
      "automerge": false,
      "addLabels": [
        "homescoop-recipe"
      ]
    },
    {
      "description": "Semver majors on recipes: always human (Lars).",
      "matchFileNames": [
        "packages/**/recipe.yaml"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "homescoop-recipe",
        "homescoop-major"
      ]
    },
    {
      "description": "CI-certified packages (see scripts/ci-certified.json) — non-major only. Synced by scripts/sync-ci-certified-renovate.mjs.",
      "matchFileNames": [
        "packages/coreutils/recipe.yaml",
        "packages/gawk/recipe.yaml",
        "packages/git/recipe.yaml",
        "packages/grep/recipe.yaml",
        "packages/gzip/recipe.yaml",
        "packages/jq/recipe.yaml",
        "packages/pkgconf/recipe.yaml",
        "packages/procps/recipe.yaml",
        "packages/sed/recipe.yaml",
        "packages/which/recipe.yaml",
        "packages/xxd/recipe.yaml",
        "packages/xz/recipe.yaml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "bump"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "addLabels": [
        "homescoop-recipe",
        "homescoop-ci-certified"
      ]
    },
    {
      "description": "libpng 1.7 is a parallel beta line; stay on the 1.6.x stable series.",
      "matchDepNames": [
        "pnggroup/libpng"
      ],
      "allowedVersions": "/^1\\.6\\./"
    },
    {
      "description": "vim tags move fast; xxd tracks a pinned patch — ignore majors.",
      "matchDepNames": [
        "vim/vim"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Workflow action pins below a major.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "github-script major bumps can break ladder-merge; review by hand.",
      "matchPackageNames": [
        "actions/github-script"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
